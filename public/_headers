  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://analytics.ahrefs.com https://api.github.com https://img.shields.io https://hex.pm; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

/_astro/*
