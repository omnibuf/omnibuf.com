<!-- COMPACT BENCHMARK & FORMAT COMPARISON SUMMARY -->
<section
  id="benchmarks"
  class="py-10 sm:py-14 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
>
  <div class="flex flex-wrap items-end justify-between gap-3 mb-5">
    <div class="max-w-2xl">
      <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">Format comparison</h2>
      <p class="mt-1.5 text-sm sm:text-base text-ink/75">
        Measured with the 11-field <code>PeerUpdate</code> test struct.
      </p>
    </div>
    <div class="flex flex-wrap gap-2 text-sm">
      <a href="/how-it-works#comparisons" class="btn-primary px-3.5 py-1.5">
        Format Comparisons &rarr;
      </a>
      <a href="/benchmarks" class="btn-secondary px-3.5 py-1.5">
        All Benchmarks &rarr;
      </a>
    </div>
  </div>

  <!-- Feature Matrix Table -->
  <div class="overflow-x-auto border border-ink/15 rounded-lg bg-[#FAF8F2]">
    <table class="w-full text-left border-collapse font-mono text-xs sm:text-sm tabular-nums leading-snug">
      <thead>
        <tr class="border-b border-ink/15 bg-[#EDE8DC] text-ink/75 text-xs">
          <th class="px-3.5 py-2.5 font-semibold whitespace-nowrap">Format</th>
          <th class="px-3.5 py-2.5 font-semibold whitespace-nowrap">Schema</th>
          <th class="px-3.5 py-2.5 font-semibold whitespace-nowrap">Wire Size</th>
          <th class="px-3.5 py-2.5 font-semibold whitespace-nowrap">1-Pass Encode</th>
          <th class="px-3.5 py-2.5 font-semibold whitespace-nowrap">Decode Without Schema</th>
          <th class="px-3.5 py-2.5 font-semibold whitespace-nowrap">
            <code>append(a, b)</code> Merge
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink/10">
        <tr class="bg-[#FF4F18]/[0.07] font-semibold">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">OmniBuf</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink whitespace-nowrap">
            <code>.proto</code> or structs
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">366 B (1x)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes (Field #0)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes</td>
        </tr>
        <tr class="bg-white">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 font-bold whitespace-nowrap">Protobuf</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">
            <code>.proto</code>
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">341 B (-7%)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No (2-pass)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes</td>
        </tr>
        <tr class="bg-[#FAF8F2]">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 font-bold whitespace-nowrap">FlatBuffers</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">
            <code>.fbs</code>
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">600 B (+64%)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Builder API</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No</td>
        </tr>
        <tr class="bg-white">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 font-bold whitespace-nowrap">Cap'n Proto</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">
            <code>.capnp</code>
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">560 B (+53%)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Pointer API</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No</td>
        </tr>
        <tr class="bg-[#FAF8F2]">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 font-bold whitespace-nowrap">
            Avro (raw / OCF)
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">
            <code>.avsc</code> JSON
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">313 B / 1,359 B</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">
            OCF header only
          </td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/70 whitespace-nowrap">No</td>
        </tr>
        <tr class="bg-white">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 font-bold whitespace-nowrap">MessagePack</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Structs or maps</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">656 B (+79%)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes (repeats keys)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/75 whitespace-nowrap">No</td>
        </tr>
        <tr class="bg-[#FAF8F2]">
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 font-bold whitespace-nowrap">JSON</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Structs or maps</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">803 B (+119%)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 whitespace-nowrap">Yes (repeats keys)</td>
          <td class="px-3 py-1.5 sm:px-3.5 sm:py-2 text-ink/75 whitespace-nowrap">No</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>
