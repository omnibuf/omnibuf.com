---
export interface TypeMappingRow {
  nativeType: string;
  protoType: string;
}

interface Props {
  title: string;
  nativeLabel: string;
  rows: TypeMappingRow[];
  noteHtml: string;
}

const { title, nativeLabel, rows, noteHtml } = Astro.props;
---

<div class="lg:col-span-12 space-y-3">
  <div class="border border-ink/15 rounded-lg bg-[#FAF8F2] overflow-hidden">
    <div class="px-4 py-2.5 bg-[#EDE8DC] border-b border-ink/15 font-mono text-xs font-semibold text-ink/80">
      {title}
    </div>
    <dl class="divide-y divide-ink/10 font-mono text-xs sm:text-sm">
      <div class="grid grid-cols-12 gap-2 px-4 py-2 bg-[#EDE8DC]/40 text-xs font-semibold text-ink/65">
        <dt class="col-span-7 sm:col-span-6">{nativeLabel}</dt>
        <dd class="col-span-5 sm:col-span-6">Protobuf type</dd>
      </div>
      {rows.map((row) => (
        <div class="grid grid-cols-12 gap-2 px-4 py-2 items-baseline hover:bg-[#EDE8DC]/30 transition-colors">
          <dt class="col-span-7 sm:col-span-6 font-medium text-ink break-words">
            {row.nativeType}
          </dt>
          <dd class="col-span-5 sm:col-span-6 text-[#FF4F18] font-medium break-words">
            {row.protoType}
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <p class="text-sm sm:text-base text-ink/80 leading-relaxed max-w-[75ch]" set:html={noteHtml} />
</div>
