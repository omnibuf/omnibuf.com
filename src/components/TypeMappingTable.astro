---
export interface TypeMappingRow {
  nativeType: string;
  protoType: string;
}

interface Props {
  title: string;
  nativeLabel: string;
  rows: TypeMappingRow[];
  noteHtml: string;
}

const { title, nativeLabel, rows, noteHtml } = Astro.props;
---

<div class="lg:col-span-12 space-y-3">
  <div class="border-2 border-ink rounded-md bg-[#FAF8F2] overflow-hidden">
    <div class="px-3.5 sm:px-4 py-2 bg-[#E5E0D5] border-b-2 border-ink font-mono text-xs font-bold uppercase text-ink">
      {title}
    </div>
    <dl class="divide-y divide-ink/15 font-mono text-xs sm:text-sm">
      <div class="grid grid-cols-12 gap-2 px-3.5 sm:px-4 py-2 bg-[#E5E0D5]/40 text-[11px] sm:text-xs font-bold uppercase text-ink/75">
        <dt class="col-span-7 sm:col-span-6">{nativeLabel}</dt>
        <dd class="col-span-5 sm:col-span-6">Protobuf type</dd>
      </div>
      {rows.map((row) => (
        <div class="grid grid-cols-12 gap-2 px-3.5 sm:px-4 py-2 items-baseline hover:bg-[#E5E0D5]/25 transition-colors">
          <dt class="col-span-7 sm:col-span-6 font-bold text-ink break-words">{row.nativeType}</dt>
          <dd class="col-span-5 sm:col-span-6 text-[#FF4F18] font-semibold break-words">
            {row.protoType}
          </dd>
        </div>
      ))}
    </dl>
  </div>

  <p class="text-sm sm:text-base text-ink/85 leading-relaxed max-w-[75ch]" set:html={noteHtml} />
</div>
