---
import { languageBenchmarkList } from '../data/benchmarks';

const heroLanguageCharts = languageBenchmarkList.map((suite) => {
  const maxEnc = Math.max(...suite.butterflyEncodeRows.map((r) => r.val), 1);
  const maxDec = Math.max(...suite.butterflyDecodeRows.map((r) => r.val), 1);
  const decodeByName = new Map(suite.butterflyDecodeRows.map((r) => [r.name, r.val]));
  const bRows = suite.butterflyEncodeRows.map((r) => {
    const decVal = decodeByName.get(r.name) ?? r.val;
    return {
      name: r.name,
      baseline: Boolean(r.baseline),
      encVal: r.val,
      decVal,
      encPct: Math.max(4.5, Math.min(100, (r.val / maxEnc) * 100)).toFixed(1),
      decPct: Math.max(4.5, Math.min(100, (decVal / maxDec) * 100)).toFixed(1),
    };
  });
  const omniRow = bRows.find((r) => r.baseline) ?? bRows[0];
  const restRows = bRows.filter((r) => !r.baseline);
  return {
    ...suite,
    omniRow,
    restRows,
  };
});
