      <div
        aria-label="Benchmarks by language"
        class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-[var(--border-subtle)]"
      >
        {benchmarkPreviews.map((suite, idx) => (
          <a
            id={`home-bench-tab-${suite.key}`}
            href={suite.href}
            data-home-bench-tab={suite.key}
            data-active={idx === 0 ? 'true' : 'false'}
            aria-label={suite.ariaLabel}
            class="bench-matrix-cell group text-left px-3.5 py-3 flex flex-col justify-start gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--accent)] no-underline"
          >
            <div class="flex items-center justify-between gap-2">
              <span class="bench-matrix-lang font-mono text-xs font-semibold text-ink">
                {suite.shortLabel}
              </span>
              <span
                class="bench-matrix-dot w-1.5 h-1.5 rounded-full transition-opacity"
                aria-hidden="true"
              ></span>
            </div>

            <!-- Label-free mirrored micro-bars: Encode left | Decode right -->
            <div class="relative flex flex-col gap-[3px] min-h-[53px]" aria-hidden="true">
              <span class="pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-ink/15"></span>
              {suite.pairedRows.map((pair) => (
                <div class="grid grid-cols-2 items-center gap-[5px] h-[5px]">
                  <div class="flex justify-end items-center h-full">
                    {pair.encode && (
                      <span
                        class:list={[
                          'block h-full rounded-l-[1.5px] min-w-[4px]',
                          pair.encode.isOmni ? 'bench-bar-omni' : 'bench-bar-competitor opacity-65',
                        ]}
                        style={`width: ${pair.encode.pct}%;`}
                        title={`Encode: ${pair.encode.name}`}
                      />
                    )}
                  </div>
                  <div class="flex justify-start items-center h-full">
                    {pair.decode && (
                      <span
                        class:list={[
                          'block h-full rounded-r-[1.5px] min-w-[4px]',
                          pair.decode.isOmni ? 'bench-bar-omni' : 'bench-bar-competitor opacity-65',
                        ]}
                        style={`width: ${pair.decode.pct}%;`}
                        title={`Decode: ${pair.decode.name}`}
                      />
                    )}
                  </div>
                </div>
              ))}
            </div>
          </a>
        ))}
      </div>

      <!-- Fixed-Height Relative Readout for Selected / Hovered Language -->
      <div class="border-t border-ink/12 bg-[var(--bg-subtle)]/55 px-4 sm:px-5 py-3">
        {benchmarkPreviews.map((suite, idx) => (
          <div
            id={`home-bench-panel-${suite.key}`}
            data-home-bench-panel={suite.key}
            class:list={[
              'grid grid-cols-1 sm:grid-cols-[8.5rem_1fr_auto] sm:items-center gap-x-5 gap-y-2',
              idx === 0 ? '' : 'hidden',
            ]}
          >
            <div class="text-sm font-semibold text-ink leading-snug">{suite.label}</div>

            <dl class="grid grid-cols-[4.25rem_1fr] gap-x-3 gap-y-1 text-xs items-baseline min-w-0">
              <dt class="font-medium text-ink/65">Encode</dt>
              <dd class="font-mono tabular-nums text-ink/80 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                {suite.encodeStats.map((stat, statIdx) => (
                  <span class="whitespace-nowrap">
                    {statIdx > 0 && (
                      <span class="mr-2 text-ink/45" aria-hidden="true">
                        &middot;
                      </span>
                    )}
                    <span
                      class={statIdx === 0 ? 'font-semibold text-accent' : 'font-semibold text-ink'}
                    >
                      {stat.multiple} faster
                    </span>{' '}
                    <span class="text-ink/70">vs {stat.label}</span>
                  </span>
                ))}
              </dd>

              <dt class="font-medium text-ink/65">Decode</dt>
              <dd class="font-mono tabular-nums text-ink/80 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                {suite.decodeStats.map((stat, statIdx) => (
                  <span class="whitespace-nowrap">
                    {statIdx > 0 && (
                      <span class="mr-2 text-ink/45" aria-hidden="true">
                        &middot;
                      </span>
                    )}
                    <span
                      class={statIdx === 0 ? 'font-semibold text-accent' : 'font-semibold text-ink'}
                    >
                      {stat.multiple} faster
                    </span>{' '}
                    <span class="text-ink/70">vs {stat.label}</span>
                  </span>
                ))}
              </dd>
            </dl>

            <div class="flex sm:flex-col items-baseline sm:items-end justify-between sm:justify-center gap-x-4 gap-y-1 text-xs shrink-0 pt-1 sm:pt-0 border-t sm:border-t-0 border-ink/10">
              <a href={suite.langHref} class="doc-link">
                {suite.shortLabel} guide
              </a>
              <a href={suite.href} class="doc-link text-ink/75">
                Full benchmarks &rarr;
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Honest Tradeoffs -->
    <p class="mt-4 text-sm sm:text-base text-ink/80 leading-relaxed max-w-[65ch]">
      OmniBuf can replace a lot of Protobuf and JSON, though every wire format comes with tradeoffs.
      Protobuf ends up around 7% smaller on dense messages (341 B vs 366 B on{' '}
      <code>PeerUpdate</code>) and has twenty years of tooling behind it. FlatBuffers and Cap'n
      Proto stay quicker at grabbing a single field out of a huge buffer via offset tables, though
      their payloads run a good bit larger and you have to deal with builder APIs. And for public
      APIs where you just want to send someone a <code>curl</code> command, JSON still makes sense.
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-bench]').forEach((widget) => {
    const cells = Array.from(widget.querySelectorAll<HTMLElement>('[data-home-bench-tab]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-home-bench-panel]'));

    function activate(key: string) {
      cells.forEach((cell) => {
        const isActive = cell.getAttribute('data-home-bench-tab') === key;
        cell.setAttribute('data-active', isActive ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-home-bench-panel') !== key);
      });
    }

    cells.forEach((cell, idx) => {
      const key = cell.getAttribute('data-home-bench-tab');
      cell.addEventListener('pointerenter', () => {
        if (key) activate(key);
      });
      cell.addEventListener('focus', () => {
        if (key) activate(key);
      });
      cell.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = cells[(idx + dir + cells.length) % cells.length];
          if (next) {
            next.focus();
            const nextKey = next.getAttribute('data-home-bench-tab');
            if (nextKey) activate(nextKey);
          }
        }
      });
    });
  });
</script>
