---
import { languageBenchmarkList, type BenchmarkRow } from '../data/benchmarks';

function formatNs(val: number): string {
  if (val >= 1_000_000) {
    return `${(val / 1_000_000).toFixed(2)} ms`;
  }
  if (val >= 10_000) {
    return `${(val / 1_000).toFixed(1)} µs`;
  }
  return `${val.toLocaleString('en-US')} ns`;
}

function formatRatio(val: number, baselineVal: number): string {
  if (baselineVal <= 0 || val === baselineVal) return 'baseline';
  if (val > baselineVal) {
    const ratio = val / baselineVal;
    if (ratio < 1.15) {
      const pct = Math.round((ratio - 1) * 100);
      return pct === 0 ? '~same' : `${pct}% slower`;
    }
    return ratio >= 10 ? `${Math.round(ratio)}x slower` : `${ratio.toFixed(1)}x slower`;
  }
  const ratio = baselineVal / val;
  if (ratio < 1.15) {
    const pct = Math.round((ratio - 1) * 100);
    return pct === 0 ? '~same' : `${pct}% faster`;
  }
  return `${ratio.toFixed(1)}x faster`;
}

function prepareBarRows(rows: BenchmarkRow[]) {
  const maxVal = Math.max(...rows.map((r) => r.val), 1);
  const baselineVal =
    rows.find((r) => r.baseline)?.val ?? rows.find((r) => r.highlight)?.val ?? rows[0]?.val ?? 1;
  return rows.map((r) => ({
    name: r.name,
    val: r.val,
    formattedVal: formatNs(r.val),
    ratioLabel: formatRatio(r.val, baselineVal),
    isOmni: Boolean(r.baseline || r.highlight),
    pct: Math.max(1, Math.min(100, (r.val / maxVal) * 100)).toFixed(1),
  }));
}

const benchmarkPreviews = languageBenchmarkList.map((suite) => ({
  key: suite.key,
  label: suite.label,
  shortLabel: suite.shortLabel,
  href: suite.href,
  langHref: `/${suite.key}`,
  encodeRows: prepareBarRows(suite.butterflyEncodeRows),
  decodeRows: prepareBarRows(suite.butterflyDecodeRows),
}));
