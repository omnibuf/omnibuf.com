<script>
  const CYCLE_MS = 5000;
  const MANUAL_PAUSE_MS = 90_000;

  document.querySelectorAll<HTMLElement>('[data-butterfly-widget="hero"]').forEach((widget) => {
    const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-butterfly-tab]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-panel]'));
    const summaries = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-summary]'));
    const links = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-link]'));
    const badges = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-badge]'));
    const nextBtn = widget.querySelector<HTMLButtonElement>('[data-butterfly-next]');
    const panelProgressEl = widget.querySelector<HTMLElement>('.hero-panel-progress');

    if (tabs.length === 0) return;

    let currentIdx = Math.max(
      0,
      tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true'),
    );
    let cycleTimer: number | undefined;
    let resumeTimer: number | undefined;
    let isPausedManually = false;
    let isInViewport = true;
    const reducedMotionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function syncFocusableItems(items: HTMLElement[], attrName: string, activeKey: string) {
      items.forEach((item) => {
        const isActive = item.getAttribute(attrName) === activeKey;
        item.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          item.removeAttribute('aria-hidden');
          item.removeAttribute('tabindex');
        } else {
          item.setAttribute('aria-hidden', 'true');
          item.setAttribute('tabindex', '-1');
        }
        item.inert = !isActive;
      });
    }

    function syncInertState(activeKey: string) {
      panels.forEach((panel) => {
        const isActive = panel.getAttribute('data-butterfly-panel') === activeKey;
        panel.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          panel.removeAttribute('aria-hidden');
        } else {
          panel.setAttribute('aria-hidden', 'true');
        }
        panel.inert = !isActive;
      });
      summaries.forEach((summary) => {
        const isActive = summary.getAttribute('data-butterfly-summary') === activeKey;
        summary.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          summary.removeAttribute('aria-hidden');
        } else {
          summary.setAttribute('aria-hidden', 'true');
        }
        summary.inert = !isActive;
      });
      syncFocusableItems(links, 'data-butterfly-link', activeKey);
      badges.forEach((badge) => {
        const isActive = badge.getAttribute('data-butterfly-badge') === activeKey;
        badge.setAttribute('data-active', isActive ? 'true' : 'false');
        if (isActive) {
          badge.removeAttribute('aria-hidden');
        } else {
          badge.setAttribute('aria-hidden', 'true');
        }
      });
    }

    function activateIdx(nextIdx: number) {
      currentIdx = ((nextIdx % tabs.length) + tabs.length) % tabs.length;
      const targetTab = tabs[currentIdx];
      const key = targetTab?.getAttribute('data-butterfly-tab');
      if (!key) return;

      tabs.forEach((tab, idx) => {
        const isActive = idx === currentIdx;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
        tab.classList.toggle('bg-acid', isActive);
        tab.classList.toggle('text-ink', isActive);
        tab.classList.toggle('shadow-[2px_2px_0px_#111111]', isActive);
        tab.classList.toggle('bg-[#FAF8F2]', !isActive);
        tab.classList.toggle('text-ink/75', !isActive);
        tab.classList.toggle('hover:bg-[#E5E0D5]', !isActive);
        tab.classList.toggle('hover:text-ink', !isActive);
      });

      syncInertState(key);
    }

    function restartPanelProgress() {
      if (!panelProgressEl) return;
      panelProgressEl.style.animation = 'none';
      void panelProgressEl.offsetWidth;
      panelProgressEl.style.removeProperty('animation');
    }

    function canAutoRotate() {
      return (
        tabs.length > 1 &&
        !reducedMotionQuery.matches &&
        !isPausedManually &&
        isInViewport &&
        !document.hidden
      );
    }

    function scheduleNextCycle() {
      window.clearTimeout(cycleTimer);
      cycleTimer = undefined;

      if (!canAutoRotate()) {
        widget.setAttribute('data-autorotate', isPausedManually ? 'paused' : 'idle');
        return;
      }

      widget.setAttribute('data-autorotate', 'running');
      restartPanelProgress();
      cycleTimer = window.setTimeout(() => {
        activateIdx(currentIdx + 1);
        scheduleNextCycle();
      }, CYCLE_MS);
    }

    function pauseForUserInteraction() {
      window.clearTimeout(cycleTimer);
      cycleTimer = undefined;
      isPausedManually = true;
      widget.setAttribute('data-autorotate', 'paused');

      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        resumeTimer = undefined;
        isPausedManually = false;
        if (canAutoRotate()) {
          activateIdx(currentIdx + 1);
        }
        scheduleNextCycle();
      }, MANUAL_PAUSE_MS);
    }

    const initialKey = tabs[currentIdx]?.getAttribute('data-butterfly-tab');
    if (initialKey) {
      syncInertState(initialKey);
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        activateIdx(idx);
        pauseForUserInteraction();
      });
      tab.addEventListener('keydown', (e) => {
        let nextIdx: number | undefined;
        if (e.key === 'ArrowRight') nextIdx = idx + 1;
        else if (e.key === 'ArrowLeft') nextIdx = idx - 1;
        else if (e.key === 'Home') nextIdx = 0;
        else if (e.key === 'End') nextIdx = tabs.length - 1;

        if (nextIdx !== undefined) {
          e.preventDefault();
          activateIdx(nextIdx);
          tabs[currentIdx]?.focus();
          pauseForUserInteraction();
        }
      });
    });

    nextBtn?.addEventListener('click', () => {
      activateIdx(currentIdx + 1);
      pauseForUserInteraction();
    });

    // Any new pointer, keyboard, or focus interaction inside the hero widget resets the 90s pause.
    widget.addEventListener('pointerdown', pauseForUserInteraction);
    widget.addEventListener('keydown', pauseForUserInteraction);
    widget.addEventListener('focusin', pauseForUserInteraction);

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.target === widget) {
              isInViewport = entry.isIntersecting;
              scheduleNextCycle();
            }
          }
        },
        { threshold: 0.15 },
      );
      observer.observe(widget);
    }

    document.addEventListener('visibilitychange', () => {
      scheduleNextCycle();
    });

    reducedMotionQuery.addEventListener('change', () => {
      scheduleNextCycle();
    });

    scheduleNextCycle();
  });
</script>
