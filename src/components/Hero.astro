              </div>
            </div>

            <!-- Full Decode Column -->
            <div class="min-w-0">
              <div class="flex items-baseline justify-between pb-2 mb-3 border-b border-ink/12">
                <span class="text-sm font-semibold text-ink">Full message decode</span>
                <span class="font-mono text-xs text-ink/65">time / op</span>
              </div>
              <div class="space-y-3">
                {suite.decodeRows.map((row) => (
                  <div class="space-y-1">
                    <div class="flex items-baseline justify-between gap-2 text-xs sm:text-sm">
                      <span
                        class:list={[
                          'truncate',
                          row.isOmni ? 'font-semibold text-ink' : 'text-ink/80',
                        ]}
                        title={row.name}
                      >
                        {row.name}
                      </span>
                      <span class="font-mono text-xs tabular-nums shrink-0">
                        <span class={row.isOmni ? 'font-semibold text-accent' : 'text-ink/85'}>
                          {row.formattedVal}
                        </span>
                        {!row.isOmni && <span class="text-ink/65 ml-1.5">{row.ratioLabel}</span>}
                      </span>
                    </div>
                    <div class="w-full h-2 rounded-full bench-track overflow-hidden">
                      <div
                        class:list={[
                          'h-full rounded-full min-w-[3px]',
                          row.isOmni ? 'bench-bar-omni' : 'bench-bar-competitor',
                        ]}
                        style={`width: ${row.pct}%;`}
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <div class="mt-5 pt-4 border-t border-ink/12 flex flex-wrap items-center justify-between gap-2 text-xs sm:text-sm">
            <a href={suite.langHref} class="doc-link">
              {suite.label} guide &rarr;
            </a>
            <a href={suite.href} class="doc-link text-ink/75">
              Full {suite.shortLabel} benchmark suite &rarr;
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Honest Tradeoffs -->
    <p class="mt-4 text-sm sm:text-base text-ink/80 leading-relaxed max-w-[65ch]">
      OmniBuf can replace a lot of Protobuf and JSON, though every wire format comes with tradeoffs.
      Protobuf ends up around 7% smaller on dense messages (341 B vs 366 B on{' '}
      <code>PeerUpdate</code>) and has twenty years of tooling behind it. FlatBuffers and Cap'n
      Proto stay quicker at grabbing a single field out of a huge buffer via offset tables, though
      their payloads run a good bit larger and you have to deal with builder APIs. And for public
      APIs where you just want to send someone a <code>curl</code> command, JSON still makes sense.
    </p>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-bench]').forEach((widget) => {
    const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-home-bench-tab]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-home-bench-panel]'));

    function activate(key: string) {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-home-bench-tab') === key;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.setAttribute('tabindex', isActive ? '0' : '-1');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-home-bench-panel') !== key);
      });
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-home-bench-tab');
        if (key) activate(key);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = tabs[(idx + dir + tabs.length) % tabs.length];
          if (next) {
            next.focus();
            const key = next.getAttribute('data-home-bench-tab');
            if (key) activate(key);
          }
        }
      });
    });
  });
</script>
