---
import { languageBenchmarkList, type BenchmarkRow } from '../data/benchmarks';

function formatMultiple(competitorVal: number, omniVal: number): string {
  if (omniVal <= 0 || competitorVal <= omniVal) return '1.0x';
  const ratio = competitorVal / omniVal;
  return ratio >= 10 ? `${Math.round(ratio)}x` : `${ratio.toFixed(1)}x`;
}

function findPrimaryProtobuf(rows: BenchmarkRow[]): BenchmarkRow | undefined {
  const candidates = rows.filter(
    (r) =>
      !(r.baseline || r.highlight) &&
      /protobuf|buffa|prost|nanopb|swiftprotobuf|elixir-protobuf|package:protobuf/i.test(r.name),
  );
  if (candidates.length === 0) return undefined;
  return (
    candidates.find((r) =>
      /^(Protobuf|@bufbuild\/protobuf|buffa|prost|google\.protobuf \(upb|libprotobuf|protobuf-java|Google\.Protobuf|SwiftProtobuf|package:protobuf|google\/protobuf|elixir-protobuf|nanopb)/i.test(
        r.name,
      ),
    ) ?? candidates[0]
  );
}

function findPrimaryJson(rows: BenchmarkRow[]): BenchmarkRow | undefined {
  return rows.find((r) => !(r.baseline || r.highlight) && /json|jason/i.test(r.name));
}

function protobufLabelFor(langKey: string): string {
  if (langKey === 'rs') return 'buffa';
  if (langKey === 'nano') return 'nanopb';
  if (langKey === 'es') return 'protobuf-es';
  return 'Protobuf';
}

function prepareAbbreviatedBars(rows: BenchmarkRow[]) {
  const maxVal = Math.max(...rows.map((r) => r.val), 1);
  return rows.map((r) => ({
    name: r.name,
    isOmni: Boolean(r.baseline || r.highlight),
    pct: Math.max(3, Math.min(100, (r.val / maxVal) * 100)).toFixed(1),
  }));
}

interface ComparisonStat {
  multiple: string;
  label: string;
}

function buildComparisonStats(langKey: string, rows: BenchmarkRow[]): ComparisonStat[] {
  const omni = rows.find((r) => r.baseline || r.highlight) ?? rows[0];
  if (!omni) return [];
  const stats: ComparisonStat[] = [];
  const proto = findPrimaryProtobuf(rows);
  if (proto) {
    stats.push({
      multiple: formatMultiple(proto.val, omni.val),
      label: protobufLabelFor(langKey),
    });
  }
  const json = findPrimaryJson(rows);
  if (json) {
    stats.push({
      multiple: formatMultiple(json.val, omni.val),
      label: 'JSON',
    });
  }
  return stats;
}

const benchmarkPreviews = languageBenchmarkList.map((suite) => {
  const encodeBars = prepareAbbreviatedBars(suite.butterflyEncodeRows);
  const decodeBars = prepareAbbreviatedBars(suite.butterflyDecodeRows);
  const rowCount = Math.max(encodeBars.length, decodeBars.length);
  const pairedRows = Array.from({ length: rowCount }, (_, i) => ({
    encode: encodeBars[i] ?? null,
    decode: decodeBars[i] ?? null,
  }));
  const encodeStats = buildComparisonStats(suite.key, suite.butterflyEncodeRows);
  const decodeStats = buildComparisonStats(suite.key, suite.butterflyDecodeRows);
  const encAria = encodeStats.map((s) => `${s.multiple} faster than ${s.label}`).join(', ');
  const decAria = decodeStats.map((s) => `${s.multiple} faster than ${s.label}`).join(', ');
  return {
    key: suite.key,
    label: suite.label,
    shortLabel: suite.shortLabel,
    href: suite.href,
    langHref: `/${suite.key}`,
    pairedRows,
    encodeStats,
    decodeStats,
    ariaLabel: `${suite.label}: OmniBuf fastest on encode (${encAria}) and decode (${decAria}).`,
  };
});
