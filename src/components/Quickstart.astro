---
import { Code } from 'astro:components';

const structTagSnippet = `type Peer struct {
	ID       uint64            \`omnibuf:"1,name=peer_id"\`
	Router   string            \`omnibuf:"2,name=router,omitempty"\`
	Active   bool              \`omnibuf:"3,name=active"\`
	Latency  uint32            \`omnibuf:"4,wire=fixed32"\`
	Prefixes []uint32          \`omnibuf:"5,name=prefixes"\`
	Labels   map[string]string \`omnibuf:"6,omitempty"\`
}

pkt, err := omnibuf.Marshal(&Peer{
	ID:     64512,
	Router: "rtr-01",
	Active: true,
})
var out Peer
err = omnibuf.Unmarshal(pkt, &out)`;

const pbGoSnippet = `pkt, err := omnibuf.Marshal(msg)

var out pb.Peer
err = omnibuf.Unmarshal(pkt, &out)`;

const bufGenYamlSnippet = `version: v2
plugins:
  - local: protoc-gen-go
    out: gen
    opt: paths=source_relative
  - local: protoc-gen-omnibuf
    out: gen
    opt: paths=source_relative`;

const generatedMethodsSnippet = `pkt := msg.MarshalOmniBufAppend(nil)

var out pb.PeerUpdate
err := out.UnmarshalOmniBuf(pkt, false)

var view pb.OpaquePeerUpdate
_ = view.Unmarshal(pkt)
if view.GetActive() && view.GetAsn() == 64512 {
	view.SetSequence(99)
	forwarded := view.MarshalAppend(nil)
}`;
---

<section
  id="quickstart"
  class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-8">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Three ways to use{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">OmniBuf in Go.</span>
    </h2>
    <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
      All three produce identical wire bytes.
    </p>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    <!-- 1. Plain Go Structs with omnibuf Tags -->
    <div
      id="struct-tags"
      class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3.5 min-w-0">
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Plain Go structs
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code> serialize plain Go structs
          using <code>omnibuf:"..."</code> field tags. On the first call for a struct type, the
          library builds and caches a dispatch table with the struct's memory offsets so later calls
          read and write fields directly with no per-call reflection allocations. The tag takes a
          field number (<code>1..65535</code>) plus optional flags: <code>name=...</code> overrides
          the Field #0 name, <code>wire=...</code> picks a wire encoding like <code>sint</code> or{' '}
          <code>fixed32</code>, and <code>omitempty</code> skips zero values.
        </p>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Plain Go Structs</div>
            <button
              type="button"
              data-copy={structTagSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={structTagSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>

    <!-- 2. Standard Protobuf Structs -->
    <div
      id="pb-go-structs"
      class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3.5 min-w-0">
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Standard Protobuf structs
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Pass any <code>.pb.go</code> struct from <code>protoc-gen-go</code> straight to{' '}
          <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code>. No extra compiler plugin
          required. On the first call for a message type, the runtime reads its protobuf descriptor
          and caches the struct field offsets. Full support for <code>oneof</code>, explicit{' '}
          <code>optional</code> presence, maps, and field numbers up to <code>536,870,911</code> (at
          roughly 2x the speed of <code>google.golang.org/protobuf</code>).
        </p>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Standard Protobuf Structs</div>
            <button
              type="button"
              data-copy={pbGoSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={pbGoSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>

    <!-- 3. Buf / protoc Code Generation -->
    <div
      id="plugin-tiers"
      class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3.5 min-w-0">
        <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
          Generated code with protoc-gen-omnibuf
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          For the lowest overhead, add <code>protoc-gen-omnibuf</code> to <code>buf.gen.yaml</code>.
          It generates <code>MarshalOmniBufAppend</code> and <code>UnmarshalOmniBuf</code> methods
          on your <code>.pb.go</code> structs, plus an <code>Opaque</code> wrapper type for reading
          or splicing raw packets.
        </p>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Reusing buffers and structs, generated code is <strong>6x faster on encode</strong> and{' '}
          <strong>7x faster on decode</strong> than standard Go Protobuf, or{' '}
          <strong>2x faster on decode</strong> when allocating a new struct and copying strings
          every time. The generator covers messages with field numbers <code>1..65535</code> and
          supports <code>map&lt;string, uint64&gt;</code> fields directly; generated{' '}
          <code>Opaque</code> views track dirty fields up to field number <code>63</code>. Messages
          with <code>oneof</code>, other map key/value combinations, or <code>optional</code>{' '}
          presence work through <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code>.
        </p>
      </div>

      <div class="lg:col-span-7 space-y-3.5 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
            <button
              type="button"
              data-copy={bufGenYamlSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={bufGenYamlSnippet} lang="yaml" theme="github-dark" />
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Install Plugin &amp; Generate</div>
            <button
              type="button"
              data-copy="go install github.com/omnibuf/omnibuf-go/cmd/protoc-gen-omnibuf@latest && buf generate"
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>go install github.com/omnibuf/omnibuf-go/cmd/protoc-gen-omnibuf@latest
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">
              Generated Single-Pass Methods &amp; Lazy Opaque View
            </div>
            <button
              type="button"
              data-copy={generatedMethodsSnippet}
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy
            </button>
          </div>
          <Code code={generatedMethodsSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>
  </div>
</section>
