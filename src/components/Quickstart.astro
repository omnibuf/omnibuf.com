---
import { Code } from 'astro:components';
import TypeMappingTable from './TypeMappingTable.astro';
import { defaultTypeMappings } from '../data/typeMappings';

const structTagSnippet = `type Peer struct {
	ID       uint64            \`omnibuf:"1,name=peer_id"\`
	Router   string            \`omnibuf:"2,name=router,omitempty"\`
	Active   bool              \`omnibuf:"3,name=active"\`
	Latency  uint32            \`omnibuf:"4,wire=fixed32"\`
	Prefixes []uint32          \`omnibuf:"5,name=prefixes"\`
	Labels   map[string]string \`omnibuf:"6,omitempty"\`
}

pkt, err := omnibuf.Marshal(&Peer{
	ID:     64512,
	Router: "rtr-01",
	Active: true,
})
var out Peer
err = omnibuf.Unmarshal(pkt, &out)`;

const pbGoSnippet = `import "github.com/omnibuf/omnibuf-go/omnibufproto"

pkt, err := omnibufproto.Marshal(msg)

var out pb.Peer
err = omnibufproto.Unmarshal(pkt, &out)`;

const bufGenYamlSnippet = `version: v2
plugins:
  - local: protoc-gen-go
    out: gen
    opt: paths=source_relative
  - local: protoc-gen-omnibuf-go
    out: gen
    opt: paths=source_relative`;

const generatedMethodsSnippet = `pkt := msg.MarshalOmniBufAppend(nil)

var out pb.PeerUpdate
err := out.UnmarshalOmniBuf(pkt, false)

var view pb.OpaquePeerUpdate
_ = view.Unmarshal(pkt)
if view.GetActive() && view.GetAsn() == 64512 {
	view.SetSequence(99)
	forwarded := view.MarshalAppend(nil)
}`;
---

<section
  id="quickstart"
  class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
>
  <div class="max-w-3xl mb-8">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
      Three ways to use OmniBuf in Go
    </h2>
    <p class="mt-2 text-base sm:text-lg text-ink/75">All three produce identical wire bytes.</p>
  </div>

  <div class="border-t border-ink/15 divide-y divide-ink/12">
    <!-- 1. Plain Go Structs with omnibuf Tags -->
    <div
      id="struct-tags"
      class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3 min-w-0">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
          Plain Go structs
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Core <code>github.com/omnibuf/omnibuf-go</code> has zero external dependencies.{' '}
          <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code> serialize plain Go structs
          using <code>omnibuf:"..."</code> field tags. On the first call for a struct type, the
          library builds and caches a dispatch table with the struct's memory offsets so later calls
          read and write fields directly with no per-call reflection allocations. The tag takes a
          field number (<code>1..65535</code>) plus optional flags: <code>name=...</code> overrides
          the Field #0 name, <code>wire=...</code> picks a wire encoding like <code>sint</code> or{' '}
          <code>fixed32</code>, and <code>omitempty</code> skips zero values.
        </p>
      </div>

      <div class="lg:col-span-7 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
            <div class="text-xs font-medium text-paper/70">Plain Go structs</div>
            <button
              type="button"
              data-copy={structTagSnippet}
              class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <Code code={structTagSnippet} lang="go" theme="github-dark" />
        </div>
      </div>

      <TypeMappingTable {...defaultTypeMappings.go} />
    </div>

    <!-- 2. Standard Protobuf Structs -->
    <div
      id="pb-go-structs"
      class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3 min-w-0">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
          Standard Protobuf structs
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Protobuf descriptor support lives in the separate <code>omnibufproto</code> submodule so
          native-struct services never pull in <code>google.golang.org/protobuf</code>. Pass any{' '}
          <code>.pb.go</code> struct from <code>protoc-gen-go</code> straight to{' '}
          <code>omnibufproto.Marshal</code> and <code>omnibufproto.Unmarshal</code>. No extra
          compiler plugin required. On the first call for a message type, the adapter reads its
          protobuf descriptor and caches the struct field offsets, covering <code>oneof</code>,
          explicit <code>optional</code> presence, maps, and field numbers up to{' '}
          <code>536,870,911</code> at roughly 2x the speed of{' '}
          <code>google.golang.org/protobuf</code>.
        </p>
      </div>

      <div class="lg:col-span-7 space-y-3.5 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
            <div class="text-xs font-medium text-paper/70">Install Protobuf bridge</div>
            <button
              type="button"
              data-copy="go get github.com/omnibuf/omnibuf-go/omnibufproto"
              class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/60 select-none">$ </span>go get github.com/omnibuf/omnibuf-go/omnibufproto</code></pre>
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
            <div class="text-xs font-medium text-paper/70">Standard Protobuf structs</div>
            <button
              type="button"
              data-copy={pbGoSnippet}
              class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <Code code={pbGoSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>

    <!-- 3. Buf / protoc Code Generation -->
    <div
      id="plugin-tiers"
      class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
    >
      <div class="lg:col-span-5 space-y-3 min-w-0">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
          Generated code with protoc-gen-omnibuf-go
        </h3>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          For the lowest overhead, add <code>protoc-gen-omnibuf-go</code> to{' '}
          <code>buf.gen.yaml</code>. It generates <code>MarshalOmniBufAppend</code> and{' '}
          <code>UnmarshalOmniBuf</code> methods on your <code>.pb.go</code> structs, plus an{' '}
          <code>Opaque</code> wrapper type for reading or splicing raw packets.
        </p>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Reusing buffers and structs across codecs, generated code runs{' '}
          <strong>6x faster on encode</strong> and <strong>5x faster on decode</strong> than
          standard Go Protobuf, and grows embedded sub-messages past 16 KiB{' '}
          <strong>nearly 8x faster</strong> via <code>Opaque</code> splicing. The generator covers
          field numbers <code>1..65535</code>, explicit <code>optional</code> presence,{' '}
          <code>oneof</code> unions, generalized typed maps, and arbitrary dirty-field counts on{' '}
          <code>Opaque</code> views.
        </p>
      </div>

      <div class="lg:col-span-7 space-y-3.5 min-w-0">
        <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
            <div class="text-xs font-medium text-paper/70">buf.gen.yaml</div>
            <button
              type="button"
              data-copy={bufGenYamlSnippet}
              class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <Code code={bufGenYamlSnippet} lang="yaml" theme="github-dark" />
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
            <div class="text-xs font-medium text-paper/70">Install plugin &amp; generate</div>
            <button
              type="button"
              data-copy="go install github.com/omnibuf/omnibuf-go/cmd/protoc-gen-omnibuf-go@latest && buf generate"
              class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/60 select-none">$ </span>go install github.com/omnibuf/omnibuf-go/cmd/protoc-gen-omnibuf-go@latest
<span class="text-paper/60 select-none">$ </span><span class="text-acid font-semibold">buf generate</span></code></pre>
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
            <div class="text-xs font-medium text-paper/70">
              Generated single-pass methods &amp; lazy Opaque view
            </div>
            <button
              type="button"
              data-copy={generatedMethodsSnippet}
              class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <Code code={generatedMethodsSnippet} lang="go" theme="github-dark" />
        </div>
      </div>
    </div>
  </div>
</section>
