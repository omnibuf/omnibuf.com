---
import { languages, type PageKey } from '../data/languages';
import LanguageIcon from './LanguageIcon.astro';

interface Props {
  currentPage?: PageKey;
  id?: string;
  narrow?: boolean;
}

const { currentPage = 'home', id, narrow = false } = Astro.props;
---

<section
  id={id}
  class:list={[
    'scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 mx-auto border-t border-ink/15 no-print',
    narrow ? 'max-w-4xl' : 'max-w-6xl',
  ]}
>
  <div class="flex flex-wrap items-baseline justify-between gap-3 mb-6">
    <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Language implementations</h2>
    <span class="font-mono text-xs text-ink/65">
      v1 DRAFT-1 &middot;{' '}
      <a
        href="https://github.com/orgs/omnibuf/discussions"
        target="_blank"
        rel="noopener noreferrer"
        class="doc-link"
      >
        GitHub Discussions &rarr;
      </a>
    </span>
  </div>

  <!-- Clean Language Index -->
  <div
    class:list={[
      'grid gap-2.5 mb-8',
      narrow ? 'sm:grid-cols-2 md:grid-cols-3' : 'sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4',
    ]}
  >
    {languages.map((lang) => {
      const isCurrent = currentPage === lang.key;
      return (
        <a
          href={lang.href}
          aria-current={isCurrent ? 'page' : undefined}
          class:list={[
            'group px-3.5 py-2.5 rounded-lg border flex items-center justify-between gap-3 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]',
            isCurrent
              ? 'bench-row-omni text-ink'
              : 'bg-[#FAF8F2] border-ink/15 text-ink hover:bg-[#EDE8DC] hover:border-ink/30',
          ]}
        >
          <div class="flex items-center gap-3 min-w-0">
            <LanguageIcon lang={lang.key} class="w-7 h-7 shrink-0" />
            <div class="text-sm font-semibold truncate flex items-center gap-2 min-w-0">
              {isCurrent && (
                <span class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0" aria-hidden="true" />
              )}
              <span class="truncate group-hover:text-accent transition-colors">{lang.label}</span>
            </div>
          </div>
          <span
            class="text-sm text-ink/60 group-hover:text-accent transition-colors shrink-0"
            aria-hidden="true"
          >
            &rarr;
          </span>
        </a>
      );
    })}
  </div>

  <!-- Core Documentation Links -->
  <div class="pt-6 border-t border-ink/12 flex flex-wrap items-center justify-between gap-4">
    <div class="text-sm font-medium text-ink/70">Architecture, benchmarks, and specification</div>
    <div class="flex flex-wrap gap-2.5 text-sm">
      {currentPage !== 'how-it-works' && (
        <a href="/how-it-works" class="btn-secondary px-3.5 py-2">
          How It Works &rarr;
        </a>
      )}
      {currentPage !== 'benchmarks' && (
        <a href="/benchmarks" class="btn-secondary px-3.5 py-2">
          Benchmarks &rarr;
        </a>
      )}
      {currentPage !== 'spec' && (
        <a href="/spec" class="btn-secondary px-3.5 py-2">
          Wire Specification &rarr;
        </a>
      )}
      {currentPage !== 'tooling' && (
        <a href="/tooling" class="btn-secondary px-3.5 py-2">
          Tooling &rarr;
        </a>
      )}
    </div>
  </div>
</section>
