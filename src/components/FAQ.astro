---
interface FAQItem {
  id?: string;
  question: string;
  paragraphs: string[];
}

const faqItems: FAQItem[] = [
  {
    id: 'status',
    question: 'Is the wire format stable?',
    paragraphs: [
      'OmniBuf is currently on <strong>v0.1</strong>, and the byte layout may still change before 1.0 if bugs turn up. Please open an issue on <a href="https://github.com/omnibuf/omnibuf-go" target="_blank" rel="noopener noreferrer" class="doc-link">GitHub</a> if anything in the spec looks broken.',
    ],
  },
  {
    id: 'faq-proto',
    question: 'Do I have to use .proto files?',
    paragraphs: [
      'No. Go structs can use <code>omnibuf:"1"</code> tags much like standard <code>json</code> tags, and TypeScript has a <code>defineMessage()</code> helper. <code>DecodeBlind</code> can also dump raw packets with no schema at all.',
    ],
  },
  {
    id: 'faq-grpc',
    question: 'Does it work with gRPC and Connect?',
    paragraphs: [
      'Yes. <a href="https://grpc.io/" target="_blank" rel="noopener noreferrer" class="doc-link">gRPC</a> and <a href="https://connectrpc.com/" target="_blank" rel="noopener noreferrer" class="doc-link">Connect</a> keep wire encoding separate from transport, so registering OmniBuf as a codec works with standard generated service stubs.',
    ],
  },
  {
    id: 'faq-presence',
    question: 'How does field presence work?',
    paragraphs: [
      'Generated <code>.proto</code> structs follow standard <code>proto3</code> <code>optional</code> and Editions rules. On plain Go structs, pointer fields track explicit presence and <code>omitempty</code> skips zero values.',
    ],
  },
  {
    id: 'faq-unknown',
    question: 'What happens to unknown fields?',
    paragraphs: [
      "Go's <code>Unmarshal</code> skips unknown tags and does not allocate memory for them, while TypeScript stores them in <code>$unknown</code>. Proxies written in Go can use the <code>Opaque</code> wrapper or <code>SpliceFields</code> to edit packets in place and keep unknown fields intact.",
    ],
  },
  {
    id: 'faq-deterministic',
    question: 'Is encoding deterministic?',
    paragraphs: [
      'Go randomizes map iteration order on every run. Standard <code>Marshal</code> follows map iteration directly, while <code>omnibuf.MarshalDeterministic</code> sorts map keys in ascending order so tests and content hashes see identical bytes.',
    ],
  },
  {
    id: 'faq-languages',
    question: 'Which languages are supported?',
    paragraphs: [
      'Go and TypeScript are supported today. The repo includes the <a href="/spec" class="doc-link">wire spec</a> and a conformance test runner for anyone building a port in another language.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<section
  id="faq"
  class="py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-10">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      Frequently asked{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
    </h2>
  </div>

  <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
    {faqItems.map((item) => (
      <div
        id={item.id}
        class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
      >
        <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
          {item.question}
        </h3>
        <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
          {item.paragraphs.map((paragraph) => (
            <p set:html={paragraph} />
          ))}
        </div>
      </div>
    ))}
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</section>
