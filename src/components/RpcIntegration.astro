---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';

interface Props {
  heading: string;
  accent: string;
  summary: string;
  code: string;
  lang: ComponentProps<typeof Code>['lang'];
  codeLabel?: string;
}

const { heading, accent, summary, code, lang, codeLabel = 'gRPC & Connect Codec' } = Astro.props;
---

<section
  id="grpc-connect"
  class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="border-t-2 border-ink pt-8 sm:pt-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
    <div class="lg:col-span-5 space-y-3.5 min-w-0">
      <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug text-ink">
        {heading} <span class="text-[#FF4F18]">{accent}</span>
      </h2>
      <p class="text-base sm:text-lg text-ink/85 leading-relaxed" set:html={summary} />
      <p class="text-sm font-mono text-ink/70">
        Codec names: <code>"omnibuf"</code> (compact) &middot; <code>"x-omnibuf"</code> (with Field
        #0)
      </p>
    </div>

    <div class="lg:col-span-7 min-w-0">
      <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
        <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
          <div class="text-xs font-bold uppercase text-acid">{codeLabel}</div>
          <button
            type="button"
            data-copy={code}
            class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
          >
            Copy
          </button>
        </div>
        <Code code={code} lang={lang} theme="github-dark" />
      </div>
    </div>
  </div>
</section>
