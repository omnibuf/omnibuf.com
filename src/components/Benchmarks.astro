---
import { languageBenchmarks } from '../data/benchmarks';
import type { LanguageKey } from '../data/languages';

interface Props {
  lang?: LanguageKey;
}

const { lang = 'go' } = Astro.props;
const suite = languageBenchmarks[lang];
---

<section
  id="benchmarks"
  class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-6">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      {suite.headingPrefix}{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">benchmarks.</span>
    </h2>
    <p class="mt-2.5 text-base sm:text-lg text-ink/80 font-medium" set:html={suite.subtitleHtml} />
  </div>

  <div class="grid lg:grid-cols-2 gap-5 items-start select-none">
    {suite.categories.map((cat) => (
      <div class="os-window overflow-hidden">
        <div class="os-titlebar bg-[#E5E0D5]">
          <span class="font-mono text-xs sm:text-sm font-bold uppercase">{cat.title}</span>
          <div class="os-stripes" />
        </div>

        <div class="p-3.5 sm:p-4 bg-[#FAF8F2] space-y-1">
          <p class="text-xs sm:text-sm text-ink/85 leading-snug pb-1.5 max-w-[70ch]">
            {cat.methodology}
          </p>
          {(() => {
            const omniVal =
              cat.rows.find((row) => row.baseline)?.val ??
              cat.rows.find((row) => row.highlight)?.val ??
              cat.rows[0].val;
            return cat.rows.map((r) => {
              const numPct = Math.max(2, Math.min(100, (r.val / cat.maxVal) * 100));
              const pct = numPct.toFixed(1);
              let ratioStr = r.ratio ?? '1.0x (base)';
              if (!r.ratio && r.val !== omniVal) {
                ratioStr =
                  r.val < omniVal
                    ? `${(omniVal / r.val).toFixed(1)}x faster`
                    : `${(r.val / omniVal).toFixed(1)}x slower`;
              }
              const rowTitle = r.ops
                ? `${r.name}: ${r.val.toLocaleString('en-US')} ${cat.unit} (${r.ops})`
                : r.name;
              return (
                <div
                  class:list={[
                    'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1 rounded min-w-0',
                    r.baseline
                      ? 'bg-acid/45 border-2 border-ink shadow-[2px_2px_0px_#111111] font-bold'
                      : r.highlight
                        ? 'bg-acid/25 border-2 border-dashed border-ink font-bold'
                        : 'border border-ink/15 bg-white',
                  ]}
                  title={rowTitle}
                >
                  <div class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate">
                    {r.name}
                  </div>
                  <div class="col-span-6 sm:col-span-3 flex items-center min-w-0">
                    <div class="w-full bg-[#E5E0D5] h-3.5 border border-ink rounded-sm overflow-hidden">
                      <div
                        class:list={[
                          'h-full',
                          numPct < 99.5 && 'border-r border-ink',
                          r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                        ]}
                        style={`width: ${pct}%;`}
                      />
                    </div>
                  </div>
                  <div class="col-span-6 sm:col-span-4 text-right font-mono text-xs tabular-nums whitespace-nowrap leading-none">
                    <span class="font-bold text-ink">{ratioStr}</span>{' '}
                    <span class="text-ink/70 font-normal">
                      ({r.val.toLocaleString('en-US')} {cat.unit})
                    </span>
                  </div>
                </div>
              );
            });
          })()}
        </div>
      </div>
    ))}
  </div>

  <!-- Benchmark Environment & Reproducibility -->
  <div class="mt-8 pt-8 border-t-2 border-ink/15 grid md:grid-cols-12 gap-6 lg:gap-8 items-start">
    <div class="md:col-span-4 space-y-2 select-none">
      <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight leading-snug">
        Benchmark Environment
      </h3>
      <div class="p-4 bg-ink text-paper rounded-md border-2 border-ink space-y-1.5 font-mono text-sm mt-3">
        <div class="text-acid font-bold uppercase">Hardware &amp; Runtime</div>
        {suite.hardwareLines.map((line) => (
          <div>{line}</div>
        ))}
      </div>
    </div>
    <div class="md:col-span-8 md:pt-1 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
      {suite.environmentParagraphs.map((para, idx) => (
        <p
          class={
            idx === suite.environmentParagraphs.length - 1
              ? 'text-sm sm:text-base text-ink/80'
              : undefined
          }
          set:html={para}
        />
      ))}
    </div>
  </div>
</section>
