---
import {
  benchmarksNavPage,
  languages,
  languagesNavPage,
  primaryNavPages,
  specNavPage,
  toolingPages,
} from '../data/languages';

const linkClass =
  'text-sm text-ink/75 hover:text-[#FF4F18] hover:underline underline-offset-4 decoration-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18] rounded-sm transition-colors';
---

<footer class="border-t border-ink/15 bg-[#FAF8F2] pt-12 pb-8 px-4 sm:px-6 no-print">
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-8 items-start">
      <!-- Brand Lockup -->
      <div class="md:col-span-5 space-y-3">
        <a
          href="/"
          class="inline-flex items-center gap-2 font-bold text-base tracking-tight text-ink rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]"
        >
          <img
            src="/favicon.svg"
            alt=""
            width="24"
            height="24"
            class="w-6 h-6 shrink-0"
            aria-hidden="true"
          />
          <span>OmniBuf</span>
        </a>
        <p class="text-sm text-ink/75 leading-relaxed max-w-[38ch]">
          Fast, self-describing binary wire format for <code>.proto</code> schemas and native
          structs.
        </p>
        <div class="font-mono text-xs text-ink/60">Apache-2.0 &middot; v1 DRAFT-1</div>
      </div>

      <!-- Navigation Columns -->
      <div class="md:col-span-7 grid grid-cols-2 sm:grid-cols-3 gap-8">
        <div>
          <div class="text-xs font-semibold text-ink/65 mb-3">Documentation</div>
          <ul class="space-y-2">
            {primaryNavPages.map((p) => (
              <li>
                <a href={p.href} class={linkClass}>
                  {p.label}
                </a>
              </li>
            ))}
            <li>
              <a href={benchmarksNavPage.href} class={linkClass}>
                {benchmarksNavPage.label}
              </a>
            </li>
            <li>
              <a href={specNavPage.href} class={linkClass}>
                {specNavPage.label}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <div class="text-xs font-semibold text-ink/65 mb-3">
            <a
              href={languagesNavPage.href}
              class="hover:text-[#FF4F18] hover:underline underline-offset-4 transition-colors"
            >
              Languages
            </a>
          </div>
          <ul class="grid grid-cols-2 gap-x-4 gap-y-2">
            {languages.map((lang) => (
              <li>
                <a href={lang.href} class={linkClass}>
                  {lang.shortLabel}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="col-span-2 sm:col-span-1">
          <div class="text-xs font-semibold text-ink/65 mb-3">Tooling &amp; Community</div>
          <ul class="space-y-2">
            {toolingPages.map((tool) => (
              <li>
                <a href={tool.href} class={linkClass}>
                  {tool.label}
                </a>
              </li>
            ))}
            <li>
              <a
                href="https://github.com/omnibuf"
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                GitHub
              </a>
            </li>
            <li>
              <a
                href="https://github.com/orgs/omnibuf/discussions"
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                Discussions
              </a>
            </li>
            <li>
              <a
                href="https://github.com/omnibuf/omnibuf-demo"
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                Live Demo
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div class="mt-10 pt-5 border-t border-ink/12 flex flex-wrap items-center justify-between gap-2 text-xs text-ink/65">
      <span>&copy; {new Date().getFullYear()} OmniBuf</span>
      <span>Open wire specification &middot; Cross-language conformance suite</span>
    </div>
  </div>
</footer>
