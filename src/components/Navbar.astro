---
import {
  benchmarksNavPage,
  cliNavPage,
  getGitHubUrlForPage,
  languages,
  languagesNavPage,
  primaryNavPages,
  specNavPage,
  toolingPages,
  totalSitePages,
  type PageKey,
} from '../data/languages';
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  currentPage?: PageKey;
}

const { currentPage = 'home' } = Astro.props;

const activeLang = languages.find((l) => l.key === currentPage);
const isLanguagesActive = currentPage === languagesNavPage.key || Boolean(activeLang);
const activeTool = toolingPages.find((t) => t.key === currentPage);
const isToolingActive = currentPage === cliNavPage.key || Boolean(activeTool);
const docsNavItems = [
  {
    href: '/',
    key: 'home' as PageKey,
    label: 'Overview',
    desc: 'Wire format overview and examples',
  },
  {
    href: '/how-it-works',
    key: 'how-it-works' as PageKey,
    label: 'How It Works',
    desc: 'Prefix-Varints, 16 wire types, and comparisons',
  },
  {
    href: specNavPage.href,
    key: specNavPage.key as PageKey,
    label: specNavPage.label,
    desc: 'Wire Specification v1 DRAFT-1',
  },
];
const activeDoc = docsNavItems.find((d) => d.key === currentPage);
const activePageLabel =
  activeDoc?.label ??
  (currentPage === benchmarksNavPage.key ? benchmarksNavPage.label : undefined) ??
  (currentPage === languagesNavPage.key ? languagesNavPage.label : undefined) ??
  (activeTool ? `Tooling: ${activeTool.label}` : undefined) ??
  (currentPage === cliNavPage.key ? cliNavPage.label : undefined) ??
  (activeLang ? `Languages: ${activeLang.shortLabel}` : 'Menu');

const githubUrl = getGitHubUrlForPage(currentPage);
const isMultiColDropdown = languages.length >= 5;
---

<header class="sticky top-0 z-50 bg-[#FAF8F2] border-b border-ink/15 no-print select-none">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-3 text-sm">
    <div class="flex items-center gap-3 sm:gap-6 min-w-0">
      <a
        href="/"
        class="font-bold text-base tracking-tight text-ink flex items-center gap-2 shrink-0 rounded focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]"
      >
        <img
          src="/favicon.svg"
          alt=""
          width="24"
          height="24"
          class="w-6 h-6 shrink-0"
          aria-hidden="true"
        />
        <span>OmniBuf</span>
      </a>

      <!-- Desktop Navigation -->
      <nav
        aria-label="Page navigation"
        class="hidden lg:flex items-center gap-1 font-medium min-w-0"
      >
        <!-- Docs Dropdown (clicking label navigates to /; hover or toggle opens menu) -->
        <div id="docs-nav-menu" data-open="false" class="relative group flex items-stretch">
          <a
            href="/"
            data-active={activeDoc ? 'true' : 'false'}
            aria-current={currentPage === 'home' ? 'page' : undefined}
            class="nav-link rounded-r-none! pr-1! flex items-center select-none"
          >
            Docs
          </a>
          <button
            type="button"
            data-dropdown-toggle
            data-active={activeDoc ? 'true' : 'false'}
            aria-label="Toggle Docs menu"
            aria-haspopup="true"
            aria-expanded="false"
            class="nav-link rounded-l-none! pl-1! pr-2! cursor-pointer flex items-center select-none"
          >
            <span
              class="link-dropdown-caret text-[10px] opacity-65 transition-transform"
              aria-hidden="true"
            >
              &#9662;
            </span>
          </button>

          <div class="lang-dropdown-panel link-dropdown-panel absolute left-0 top-full pt-2 z-50">
            <div class="w-72 bg-[#FAF8F2] border border-ink/15 rounded-lg shadow-sm overflow-hidden divide-y divide-ink/10">
              {docsNavItems.map((item) => {
                const isActive = currentPage === item.key;
                return (
                  <a
                    href={item.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`flex items-center justify-between gap-3 px-3.5 py-2.5 text-sm transition-colors focus-visible:outline-none ${
                      isActive
                        ? 'bg-[#EDE8DC] text-ink font-semibold'
                        : 'bg-[#FAF8F2] text-ink hover:bg-[#EDE8DC] focus-visible:bg-[#EDE8DC]'
                    }`}
                  >
                    <div class="min-w-0">
                      <div class="truncate font-semibold">{item.label}</div>
                      <div class="text-xs font-normal truncate text-ink/65">{item.desc}</div>
                    </div>
                    {isActive && (
                      <span
                        class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        </div>

        <!-- Languages Dropdown (clicking label navigates to /languages; hover or toggle opens menu) -->
        <div id="lang-nav-menu" data-open="false" class="relative group flex items-stretch">
          <a
            href={languagesNavPage.href}
            data-active={isLanguagesActive ? 'true' : 'false'}
            aria-current={currentPage === languagesNavPage.key ? 'page' : undefined}
            class="nav-link rounded-r-none! pr-1! flex items-center select-none"
          >
            {activeLang ? `Languages: ${activeLang.shortLabel}` : 'Languages'}
          </a>
          <button
            type="button"
            data-dropdown-toggle
            data-active={isLanguagesActive ? 'true' : 'false'}
            aria-label="Toggle Languages menu"
            aria-haspopup="true"
            aria-expanded="false"
            class="nav-link rounded-l-none! pl-1! pr-2! cursor-pointer flex items-center select-none"
          >
            <span
              class="link-dropdown-caret text-[10px] opacity-65 transition-transform"
              aria-hidden="true"
            >
              &#9662;
            </span>
          </button>

          <div class="lang-dropdown-panel link-dropdown-panel absolute left-0 top-full pt-2 z-50">
            <div
              class:list={[
                'bg-[#FAF8F2] border border-ink/15 rounded-lg shadow-sm overflow-hidden',
                isMultiColDropdown
                  ? 'w-[26rem] grid grid-cols-2'
                  : 'w-64 divide-y divide-ink/10 py-1',
              ]}
            >
              {languages.map((lang, idx) => {
                const isActive = currentPage === lang.key;
                const totalRows = Math.ceil(languages.length / 2);
                const rowIdx = Math.floor(idx / 2);
                const cellBorders = isMultiColDropdown
                  ? [
                      idx % 2 === 0 ? 'border-r border-ink/10' : '',
                      rowIdx < totalRows - 1 ? 'border-b border-ink/10' : '',
                    ]
                      .filter(Boolean)
                      .join(' ')
                  : '';
                return (
                  <a
                    href={lang.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`flex items-center justify-between gap-3 px-3.5 py-2.5 text-sm transition-colors focus-visible:outline-none ${cellBorders} ${
                      isActive
                        ? 'bg-[#EDE8DC] text-ink font-semibold'
                        : 'bg-[#FAF8F2] text-ink hover:bg-[#EDE8DC] focus-visible:bg-[#EDE8DC]'
                    }`}
                  >
                    <div class="min-w-0">
                      <div class="truncate font-semibold">{lang.label}</div>
                      <div class="font-mono text-xs font-normal truncate text-ink/65">
                        {lang.shortPackage}
                      </div>
                    </div>
                    {isActive && (
                      <span
                        class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                );
              })}
              {isMultiColDropdown && languages.length % 2 === 1 && (
                <div class="bg-[#FAF8F2]" aria-hidden="true" />
              )}
            </div>
          </div>
        </div>

        <a
          href={benchmarksNavPage.href}
          class="nav-link"
          data-active={currentPage === benchmarksNavPage.key ? 'true' : 'false'}
          aria-current={currentPage === benchmarksNavPage.key ? 'page' : undefined}
        >
          {benchmarksNavPage.label}
        </a>

        <!-- Tooling Dropdown (clicking label navigates to /tooling; hover or toggle opens menu) -->
        <div id="tooling-nav-menu" data-open="false" class="relative group flex items-stretch">
          <a
            href={cliNavPage.href}
            data-active={isToolingActive ? 'true' : 'false'}
            aria-current={currentPage === cliNavPage.key ? 'page' : undefined}
            class="nav-link rounded-r-none! pr-1! flex items-center select-none"
          >
            {activeTool ? `Tooling: ${activeTool.label}` : cliNavPage.label}
          </a>
          <button
            type="button"
            data-dropdown-toggle
            data-active={isToolingActive ? 'true' : 'false'}
            aria-label="Toggle Tooling menu"
            aria-haspopup="true"
            aria-expanded="false"
            class="nav-link rounded-l-none! pl-1! pr-2! cursor-pointer flex items-center select-none"
          >
            <span
              class="link-dropdown-caret text-[10px] opacity-65 transition-transform"
              aria-hidden="true"
            >
              &#9662;
            </span>
          </button>

          <div class="lang-dropdown-panel link-dropdown-panel absolute left-0 top-full pt-2 z-50">
            <div class="w-72 bg-[#FAF8F2] border border-ink/15 rounded-lg shadow-sm overflow-hidden divide-y divide-ink/10">
              {toolingPages.map((tool) => {
                const isActive = currentPage === tool.key;
                return (
                  <a
                    href={tool.href}
                    aria-current={isActive ? 'page' : undefined}
                    class={`flex items-center justify-between gap-3 px-3.5 py-2.5 text-sm transition-colors focus-visible:outline-none ${
                      isActive
                        ? 'bg-[#EDE8DC] text-ink font-semibold'
                        : 'bg-[#FAF8F2] text-ink hover:bg-[#EDE8DC] focus-visible:bg-[#EDE8DC]'
                    }`}
                  >
                    <div class="min-w-0">
                      <div class="truncate font-semibold">{tool.label}</div>
                      <div class="text-xs font-normal truncate text-ink/65">{tool.desc}</div>
                    </div>
                    {isActive && (
                      <span
                        class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0"
                        aria-hidden="true"
                      />
                    )}
                  </a>
                );
              })}
            </div>
          </div>
        </div>
      </nav>

      <!-- Mobile Dropdown Selector -->
      <details id="mobile-nav-menu" class="relative lg:hidden group">
        <summary
          aria-label="Toggle navigation menu"
          class="list-none cursor-pointer min-h-10 sm:min-h-0 px-2.5 py-1.5 bg-[#EDE8DC] text-ink border border-ink/15 rounded-md text-xs sm:text-sm font-medium flex items-center gap-1.5 max-w-[11.5rem] whitespace-nowrap select-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]"
        >
          <svg
            class="w-4 h-4 stroke-current shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <span class="truncate">{activePageLabel}</span>
          <span
            class="text-[10px] opacity-65 transition-transform group-open:rotate-180 shrink-0"
            aria-hidden="true"
          >
            &#9662;
          </span>
        </summary>

        <nav
          aria-label="Mobile page navigation"
          class="absolute left-0 mt-2 w-64 max-w-[calc(100vw-2rem)] max-h-[calc(100dvh-4.5rem)] overflow-y-auto bg-[#FAF8F2] border border-ink/15 rounded-lg shadow-sm py-1 z-50 divide-y divide-ink/10"
        >
          {primaryNavPages.map((p) => {
            const isActive = currentPage === p.key;
            return (
              <a
                href={p.href}
                aria-current={isActive ? 'page' : undefined}
                class={`flex items-center justify-between px-3.5 py-2.5 text-sm font-medium transition-colors ${
                  isActive ? 'bg-[#EDE8DC] text-ink font-semibold' : 'text-ink hover:bg-[#EDE8DC]'
                }`}
              >
                <span>{p.label}</span>
                {isActive && (
                  <span class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0" aria-hidden="true" />
                )}
              </a>
            );
          })}
          <a
            href={languagesNavPage.href}
            aria-current={currentPage === languagesNavPage.key ? 'page' : undefined}
            class={`flex items-center justify-between px-3.5 pt-2 pb-1 text-xs font-semibold transition-colors ${
              currentPage === languagesNavPage.key
                ? 'bg-[#EDE8DC] text-ink'
                : 'text-ink/70 bg-[#EDE8DC]/50 hover:bg-[#EDE8DC] hover:text-ink'
            }`}
          >
            <span>Languages</span>
            {currentPage === languagesNavPage.key && (
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0" aria-hidden="true" />
            )}
          </a>
          <div class="grid grid-cols-2 divide-x divide-ink/10">
            {languages.map((lang) => {
              const isActive = currentPage === lang.key;
              return (
                <a
                  href={lang.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`flex items-center justify-between px-3 py-2 text-xs font-medium transition-colors ${
                    isActive ? 'bg-[#EDE8DC] text-ink font-semibold' : 'text-ink hover:bg-[#EDE8DC]'
                  }`}
                >
                  <span class="truncate">{lang.shortLabel}</span>
                  {isActive && (
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0"
                      aria-hidden="true"
                    />
                  )}
                </a>
              );
            })}
          </div>
          <a
            href={benchmarksNavPage.href}
            aria-current={currentPage === benchmarksNavPage.key ? 'page' : undefined}
            class={`flex items-center justify-between px-3.5 py-2.5 text-sm font-medium transition-colors ${
              currentPage === benchmarksNavPage.key
                ? 'bg-[#EDE8DC] text-ink font-semibold'
                : 'text-ink hover:bg-[#EDE8DC]'
            }`}
          >
            <span>{benchmarksNavPage.label}</span>
            {currentPage === benchmarksNavPage.key && (
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0" aria-hidden="true" />
            )}
          </a>
          <a
            href={cliNavPage.href}
            aria-current={currentPage === cliNavPage.key ? 'page' : undefined}
            class={`flex items-center justify-between px-3.5 pt-2 pb-1 text-xs font-semibold transition-colors ${
              currentPage === cliNavPage.key
                ? 'bg-[#EDE8DC] text-ink'
                : 'text-ink/70 bg-[#EDE8DC]/50 hover:bg-[#EDE8DC] hover:text-ink'
            }`}
          >
            <span>Tooling</span>
            {currentPage === cliNavPage.key && (
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0" aria-hidden="true" />
            )}
          </a>
          <div class="grid grid-cols-2 divide-x divide-ink/10">
            {toolingPages.map((tool) => {
              const isActive = currentPage === tool.key;
              return (
                <a
                  href={tool.href}
                  aria-current={isActive ? 'page' : undefined}
                  class={`flex items-center justify-between px-3 py-2 text-xs font-medium transition-colors ${
                    isActive ? 'bg-[#EDE8DC] text-ink font-semibold' : 'text-ink hover:bg-[#EDE8DC]'
                  }`}
                >
                  <span class="truncate">{tool.label}</span>
                  {isActive && (
                    <span
                      class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0"
                      aria-hidden="true"
                    />
                  )}
                </a>
              );
            })}
          </div>
          <a
            href={specNavPage.href}
            aria-current={currentPage === specNavPage.key ? 'page' : undefined}
            class={`flex items-center justify-between px-3.5 py-2.5 text-sm font-medium transition-colors ${
              currentPage === specNavPage.key
                ? 'bg-[#EDE8DC] text-ink font-semibold'
                : 'text-ink hover:bg-[#EDE8DC]'
            }`}
          >
            <span>{specNavPage.label}</span>
            {currentPage === specNavPage.key && (
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF4F18] shrink-0" aria-hidden="true" />
            )}
          </a>
        </nav>
      </details>
    </div>

    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <button
        type="button"
        id="search-trigger"
        aria-label="Search documentation (Command+K or /)"
        aria-haspopup="dialog"
        aria-controls="search-dialog"
        title="Search documentation (⌘K or /)"
        class="min-w-10 min-h-10 sm:min-w-0 sm:min-h-0 p-2 sm:px-2.5 sm:py-1.5 bg-[#FAF8F2] text-ink/80 hover:text-ink hover:bg-[#EDE8DC] border border-ink/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18] transition text-xs sm:text-sm font-medium rounded-md flex items-center justify-center gap-1.5 cursor-pointer"
      >
        <svg
          class="w-4 h-4 stroke-current shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
        </svg>
        <span class="hidden sm:inline">Search</span>
        <kbd class="hidden md:inline-block px-1.5 py-0.5 font-mono text-xs font-medium bg-[#EDE8DC] text-ink/70 border border-ink/15 rounded leading-none">
          /
        </kbd>
      </button>

      <a
        href={githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="OmniBuf on GitHub"
        class="min-w-10 min-h-10 sm:min-w-0 sm:min-h-0 p-2 sm:px-3 sm:py-1.5 bg-[#FAF8F2] text-ink/85 hover:text-ink hover:bg-[#EDE8DC] border border-ink/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18] transition text-xs sm:text-sm font-medium rounded-md flex items-center justify-center gap-1.5"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>

      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        title="Toggle dark mode"
        class="min-w-10 min-h-10 sm:min-w-0 sm:min-h-0 p-2 sm:px-2 sm:py-1.5 bg-[#FAF8F2] text-ink/75 hover:text-ink hover:bg-[#EDE8DC] border border-ink/15 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18] transition rounded-md flex items-center justify-center cursor-pointer"
      >
        <!-- Sun icon (shown in dark mode) -->
        <svg
          data-theme-icon="sun"
          class="hidden w-4 h-4 stroke-current"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <!-- Moon icon (shown in light mode) -->
        <svg
          data-theme-icon="moon"
          class="w-4 h-4 stroke-current"
          viewBox="0 0 24 24"
          fill="none"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<Breadcrumbs currentPage={currentPage} />

<dialog
  id="search-dialog"
  aria-label="Search documentation and wire specification"
  class="fixed inset-0 z-[70] m-auto mt-10 sm:mt-16 w-[calc(100%-1.5rem)] max-w-2xl max-h-[82vh] p-0 bg-[#FAF8F2] text-ink border border-ink/20 rounded-lg shadow-xl overflow-hidden open:flex open:flex-col no-print select-none"
>
  <div class="p-3.5 sm:px-4 border-b border-ink/15 bg-white flex items-center gap-2.5 shrink-0">
    <svg
      class="w-4 h-4 stroke-current text-ink/60 shrink-0"
      viewBox="0 0 24 24"
      fill="none"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="20" y1="20" x2="16.2" y2="16.2"></line>
    </svg>
    <input
      id="search-input"
      type="search"
      role="combobox"
      aria-expanded="true"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search wire types, Prefix-Varint, Opaque, Go, Rust, Python, C++..."
      aria-label="Search documentation"
      aria-controls="search-results"
      aria-activedescendant="search-opt-0"
      class="w-full bg-transparent text-ink placeholder:text-ink/50 text-sm sm:text-base focus:outline-none"
    />
    <button
      type="button"
      id="search-clear"
      class="hidden px-2 py-0.5 text-xs font-medium bg-[#EDE8DC] text-ink border border-ink/15 rounded hover:border-ink/30 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF4F18] cursor-pointer shrink-0"
    >
      Clear
    </button>
    <button
      type="button"
      id="search-close"
      aria-label="Close search"
      class="px-2 py-0.5 font-mono text-xs text-ink/65 bg-[#EDE8DC] border border-ink/15 rounded hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF4F18] transition cursor-pointer shrink-0"
    >
      ESC
    </button>
  </div>

  <div
    id="search-results"
    role="listbox"
    aria-label="Search results"
    class="flex-1 overflow-y-auto p-3.5 sm:p-4 space-y-1.5"
  >
    <div id="search-default-links" class="space-y-3">
      <div class="grid sm:grid-cols-3 gap-2">
        <a
          id="search-opt-0"
          href="/how-it-works#wire-types"
          role="option"
          aria-selected="true"
          data-search-item
          data-active="true"
          class="block p-2.5 rounded-md border border-ink/15 hover:border-ink/35 transition"
        >
          <div class="text-xs font-medium text-ink/65">How It Works</div>
          <div class="text-xs sm:text-sm font-semibold text-ink mt-0.5">The 16 Wire Types</div>
        </a>
        <a
          id="search-opt-1"
          href="/spec"
          role="option"
          aria-selected="false"
          data-search-item
          class="block p-2.5 rounded-md border border-ink/15 hover:border-ink/35 transition"
        >
          <div class="text-xs font-medium text-ink/65">Specification</div>
          <div class="text-xs sm:text-sm font-semibold text-ink mt-0.5">
            Wire Specification v1 DRAFT-1
          </div>
        </a>
        <a
          id="search-opt-2"
          href="/tooling"
          role="option"
          aria-selected="false"
          data-search-item
          class="block p-2.5 rounded-md border border-ink/15 hover:border-ink/35 transition"
        >
          <div class="text-xs font-medium text-ink/65">Tooling</div>
          <div class="text-xs sm:text-sm font-semibold text-ink mt-0.5">
            CLI &amp; Editor Extensions
          </div>
        </a>
      </div>
      <div>
        <div class="text-xs font-medium text-ink/65 px-0.5 mb-1.5">Language Implementations</div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
          {languages.map((lang, idx) => (
            <a
              id={`search-opt-${idx + 3}`}
              href={lang.href}
              role="option"
              aria-selected="false"
              data-search-item
              class="block p-2 rounded-md border border-ink/15 hover:border-ink/35 transition"
            >
              <div class="text-xs font-semibold text-ink">{lang.label}</div>
              <div class="font-mono text-xs text-ink/65 truncate">{lang.shortPackage}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
    <div id="search-dynamic-results" class="hidden space-y-1.5"></div>
  </div>

  <div class="px-3.5 sm:px-4 py-2 bg-[#EDE8DC] border-t border-ink/12 flex items-center justify-between gap-2 font-mono text-xs text-ink/70 shrink-0">
    <span
      id="search-status"
      aria-live="polite"
      data-default-status={`Type to search all ${totalSitePages} pages`}
    >
      Type to search all {totalSitePages} pages
    </span>
    <div class="hidden sm:flex items-center gap-3">
      <span>
        <kbd class="px-1 py-0.5 bg-[#FAF8F2] border border-ink/20 rounded text-xs">
          &uarr;&darr;
        </kbd>{' '}
        Navigate
      </span>
      <span>
        <kbd class="px-1 py-0.5 bg-[#FAF8F2] border border-ink/20 rounded text-xs">&crarr;</kbd>{' '}
        Open
      </span>
      <span>
        <kbd class="px-1 py-0.5 bg-[#FAF8F2] border border-ink/20 rounded text-xs">ESC</kbd> Close
      </span>
    </div>
  </div>
</dialog>

<script>
  const mobileNavMenu = document.getElementById('mobile-nav-menu') as HTMLDetailsElement | null;
  const docsNavMenu = document.getElementById('docs-nav-menu') as HTMLDivElement | null;
  const langNavMenu = document.getElementById('lang-nav-menu') as HTMLDivElement | null;
  const toolingNavMenu = document.getElementById('tooling-nav-menu') as HTMLDivElement | null;
  const linkDropdowns = [docsNavMenu, langNavMenu, toolingNavMenu].filter(
    (el): el is HTMLDivElement => el !== null,
  );
  const navMenus = [mobileNavMenu].filter((el): el is HTMLDetailsElement => el !== null);

  const closeLinkMenu = (menu: HTMLDivElement) => {
    menu.dataset.open = 'false';
    delete menu.dataset.closing;
    const toggleBtn = menu.querySelector<HTMLButtonElement>(
      ':scope > button[data-dropdown-toggle]',
    );
    toggleBtn?.setAttribute('aria-expanded', 'false');
  };

  for (const menu of linkDropdowns) {
    const HOVER_CLOSE_DELAY_MS = 260;
    const FADE_OUT_MS = 140;
    let hoverCloseTimer: number | null = null;
    let fadeCloseTimer: number | null = null;
    const rootLink = menu.querySelector<HTMLAnchorElement>(':scope > a');
    const toggleBtn = menu.querySelector<HTMLButtonElement>(
      ':scope > button[data-dropdown-toggle]',
    );

    const cancelLinkClose = () => {
      if (hoverCloseTimer !== null) {
        window.clearTimeout(hoverCloseTimer);
        hoverCloseTimer = null;
      }
      if (fadeCloseTimer !== null) {
        window.clearTimeout(fadeCloseTimer);
        fadeCloseTimer = null;
      }
      delete menu.dataset.closing;
    };

    const openLinkMenu = () => {
      for (const other of linkDropdowns) {
        if (other !== menu && other.dataset.open === 'true') closeLinkMenu(other);
      }
      cancelLinkClose();
      menu.dataset.open = 'true';
      toggleBtn?.setAttribute('aria-expanded', 'true');
    };

    menu.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      openLinkMenu();
    });
    menu.addEventListener('pointerleave', (e) => {
      if (e.pointerType !== 'mouse' || menu.dataset.open !== 'true') return;
      cancelLinkClose();
      hoverCloseTimer = window.setTimeout(() => {
        hoverCloseTimer = null;
        menu.dataset.closing = 'true';
        fadeCloseTimer = window.setTimeout(() => {
          fadeCloseTimer = null;
          closeLinkMenu(menu);
        }, FADE_OUT_MS);
      }, HOVER_CLOSE_DELAY_MS);
    });
    toggleBtn?.addEventListener('click', () => {
      if (menu.dataset.open === 'true') {
        cancelLinkClose();
        closeLinkMenu(menu);
      } else {
        openLinkMenu();
      }
    });
    const handleArrowOpen = (e: KeyboardEvent) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        openLinkMenu();
        menu.querySelector<HTMLAnchorElement>('.link-dropdown-panel a')?.focus();
      }
    };
    rootLink?.addEventListener('keydown', handleArrowOpen);
    toggleBtn?.addEventListener('keydown', handleArrowOpen);
    menu.addEventListener('focusout', (e) => {
      const next = e.relatedTarget as Node | null;
      if (!next || !menu.contains(next)) {
        cancelLinkClose();
        closeLinkMenu(menu);
      }
    });
  }

  if (navMenus.length > 0 || linkDropdowns.length > 0) {
    document.addEventListener('click', (e) => {
      for (const menu of navMenus) {
        if (menu.open && !menu.contains(e.target as Node)) {
          menu.open = false;
        }
      }
      for (const menu of linkDropdowns) {
        if (menu.dataset.open === 'true' && !menu.contains(e.target as Node)) {
          closeLinkMenu(menu);
        }
      }
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        for (const menu of navMenus) {
          if (menu.open) {
            const wasInside = menu.contains(document.activeElement);
            menu.open = false;
            if (wasInside) {
              menu.querySelector<HTMLElement>(':scope > summary')?.focus();
            }
          }
        }
        for (const menu of linkDropdowns) {
          if (menu.dataset.open === 'true') {
            const wasInside = menu.contains(document.activeElement);
            closeLinkMenu(menu);
            if (wasInside) {
              (
                menu.querySelector<HTMLButtonElement>(':scope > button[data-dropdown-toggle]') ??
                menu.querySelector<HTMLAnchorElement>(':scope > a')
              )?.focus();
            }
          }
        }
      }
    });
    for (const menu of navMenus) {
      menu.addEventListener('focusout', (e) => {
        const next = e.relatedTarget as Node | null;
        if (menu.open && next && !menu.contains(next)) {
          menu.open = false;
        }
      });
    }
  }

  const themeToggle = document.getElementById('theme-toggle');
  const sunIcon = document.querySelector<SVGElement>('[data-theme-icon="sun"]');
  const moonIcon = document.querySelector<SVGElement>('[data-theme-icon="moon"]');

  function syncThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    if (sunIcon && moonIcon) {
      sunIcon.classList.toggle('hidden', !isDark);
      moonIcon.classList.toggle('hidden', isDark);
    }
    if (themeToggle) {
      themeToggle.setAttribute('aria-pressed', isDark ? 'true' : 'false');
    }
  }

  syncThemeIcons();

  if (themeToggle) {
    themeToggle.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('omnibuf-theme', isDark ? 'dark' : 'light');
      } catch {
        // Ignore storage errors
      }
      syncThemeIcons();
    });
  }

  interface SearchEntry {
    page: string;
    section: string;
    title: string;
    url: string;
    text: string;
  }

  const searchDialog = document.getElementById('search-dialog') as HTMLDialogElement | null;
  const searchTrigger = document.getElementById('search-trigger') as HTMLButtonElement | null;
  const searchClose = document.getElementById('search-close') as HTMLButtonElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const searchClear = document.getElementById('search-clear') as HTMLButtonElement | null;
  const searchDefaultLinks = document.getElementById('search-default-links');
  const searchDynamicResults = document.getElementById('search-dynamic-results');
  const searchStatus = document.getElementById('search-status');

  let searchIndexPromise: Promise<SearchEntry[] | null> | null = null;
  let searchEntries: SearchEntry[] | null = null;
  let searchLoadFailed = false;
  let activeIndex = 0;

  function loadSearchIndex(): Promise<SearchEntry[] | null> {
    if (searchEntries) return Promise.resolve(searchEntries);
    if (!searchIndexPromise) {
      searchLoadFailed = false;
      searchIndexPromise = fetch('/search-index.json')
        .then((res) => {
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          return res.json() as Promise<SearchEntry[]>;
        })
        .then((data) => {
          searchEntries = data;
          searchLoadFailed = false;
          return data;
        })
        .catch(() => {
          searchLoadFailed = true;
          searchIndexPromise = null;
          return null;
        });
    }
    return searchIndexPromise;
  }

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function escapeRegExp(str: string): string {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function highlightMatches(text: string, tokens: string[]): string {
    if (tokens.length === 0) return escapeHtml(text);
    const pattern = tokens
      .slice()
      .sort((a, b) => b.length - a.length)
      .map(escapeRegExp)
      .join('|');
    if (!pattern) return escapeHtml(text);
    const regex = new RegExp(`(${pattern})`, 'gi');
    const parts = text.split(regex);
    return parts
      .map((part, i) =>
        i % 2 === 1
          ? `<mark class="underline decoration-[#FF4F18] decoration-2 underline-offset-2 font-semibold bg-transparent text-inherit">${escapeHtml(part)}</mark>`
          : escapeHtml(part),
      )
      .join('');
  }

  function buildSnippet(text: string, tokens: string[]): string {
    if (!text) return '';
    const lower = text.toLowerCase();
    let firstPos = -1;
    for (const token of tokens) {
      const idx = lower.indexOf(token);
      if (idx !== -1 && (firstPos === -1 || idx < firstPos)) {
        firstPos = idx;
      }
    }
    const maxLen = 145;
    if (firstPos === -1 || text.length <= maxLen) {
      const slice = text.slice(0, maxLen);
      return highlightMatches(slice + (text.length > maxLen ? '…' : ''), tokens);
    }
    const start = Math.max(0, firstPos - 42);
    const end = Math.min(text.length, start + maxLen);
    const prefix = start > 0 ? '…' : '';
    const suffix = end < text.length ? '…' : '';
    return highlightMatches(prefix + text.slice(start, end) + suffix, tokens);
  }

  function getVisibleItems(): HTMLAnchorElement[] {
    if (!searchDialog) return [];
    const container =
      searchDynamicResults && !searchDynamicResults.classList.contains('hidden')
        ? searchDynamicResults
        : searchDefaultLinks;
    if (!container) return [];
    return Array.from(container.querySelectorAll<HTMLAnchorElement>('a[data-search-item]'));
  }

  function updateActiveItem(nextIndex: number) {
    const items = getVisibleItems();
    if (items.length === 0) {
      activeIndex = 0;
      searchInput?.removeAttribute('aria-activedescendant');
      return;
    }
    activeIndex = ((nextIndex % items.length) + items.length) % items.length;
    items.forEach((el, idx) => {
      const isSelected = idx === activeIndex;
      el.setAttribute('data-active', isSelected ? 'true' : 'false');
      el.setAttribute('aria-selected', isSelected ? 'true' : 'false');
      if (isSelected) {
        if (el.id) {
          searchInput?.setAttribute('aria-activedescendant', el.id);
        }
        el.scrollIntoView({ block: 'nearest' });
      }
    });
  }

  async function runSearch(rawQuery: string) {
    const query = rawQuery.trim();
    if (searchClear) {
      searchClear.classList.toggle('hidden', query.length === 0);
    }

    if (!query) {
      searchDefaultLinks?.classList.remove('hidden');
      searchDynamicResults?.classList.add('hidden');
      if (searchStatus) {
        searchStatus.textContent =
          searchStatus.getAttribute('data-default-status') || 'Type to search documentation';
      }
      updateActiveItem(0);
      return;
    }

    const entries = await loadSearchIndex();
    if (!entries || searchLoadFailed) {
      searchDefaultLinks?.classList.add('hidden');
      if (searchDynamicResults) {
        searchDynamicResults.classList.remove('hidden');
        searchDynamicResults.innerHTML = `
          <div class="p-4 text-center space-y-2">
            <div class="text-sm font-semibold text-ink">Could not load the search index</div>
            <div class="text-xs text-ink/70">Check your network connection and retry, or use the top navigation links.</div>
          </div>
        `;
      }
      if (searchStatus) {
        searchStatus.textContent = 'Search index unavailable';
      }
      updateActiveItem(0);
      return;
    }
    const lowerQuery = query.toLowerCase();
    const tokens = lowerQuery.split(/\s+/).filter(Boolean);

    const scored: { entry: SearchEntry; score: number }[] = [];
    for (const entry of entries) {
      const titleLower = entry.title.toLowerCase();
      const sectionLower = entry.section.toLowerCase();
      const pageLower = entry.page.toLowerCase();
      const textLower = entry.text.toLowerCase();
      const combined = `${titleLower} ${sectionLower} ${pageLower} ${textLower}`;

      let matchedTokens = 0;
      let score = 0;

      if (titleLower === lowerQuery) score += 150;
      else if (titleLower.startsWith(lowerQuery)) score += 90;
      else if (titleLower.includes(lowerQuery)) score += 60;

      if (textLower.includes(lowerQuery)) score += 35;

      for (const token of tokens) {
        if (!combined.includes(token)) continue;
        matchedTokens++;
        if (titleLower.includes(token)) score += 45;
        if (sectionLower.includes(token) || pageLower.includes(token)) score += 18;
        if (textLower.includes(token)) score += 12;
      }

      if (matchedTokens === tokens.length) {
        scored.push({ entry, score: score + 50 });
      } else if (matchedTokens > 0 && tokens.length > 1) {
        scored.push({ entry, score: score - 20 });
      }
    }

    scored.sort((a, b) => b.score - a.score);
    const topResults = scored.slice(0, 15);

    searchDefaultLinks?.classList.add('hidden');
    if (searchDynamicResults) {
      searchDynamicResults.classList.remove('hidden');
      if (topResults.length === 0) {
        const suggestions = [
          'Prefix-Varint',
          'WireArray',
          'Opaque',
          'Field #0',
          'Avro',
          'FlatBuffers',
        ];
        searchDynamicResults.innerHTML = `
          <div class="p-4 text-center space-y-3">
            <div class="text-sm font-semibold text-ink">No sections matched &ldquo;${escapeHtml(query)}&rdquo;</div>
            <div class="text-xs text-ink/65">Try one of these topics:</div>
            <div class="flex flex-wrap justify-center gap-1.5 pt-1">
              ${suggestions
                .map(
                  (s) =>
                    `<button type="button" data-search-suggest="${escapeHtml(s)}" class="px-2.5 py-1 font-mono text-xs font-medium bg-[#EDE8DC] text-ink border border-ink/15 rounded hover:border-ink/35 cursor-pointer">${escapeHtml(s)}</button>`,
                )
                .join('')}
            </div>
          </div>
        `;
        searchDynamicResults
          .querySelectorAll<HTMLButtonElement>('button[data-search-suggest]')
          .forEach((btn) => {
            btn.addEventListener('click', () => {
              const val = btn.getAttribute('data-search-suggest') || '';
              if (searchInput) {
                searchInput.value = val;
                searchInput.focus();
                void runSearch(val);
              }
            });
          });
      } else {
        searchDynamicResults.innerHTML = topResults
          .map(({ entry }, idx) => {
            const breadcrumb = entry.section
              ? `${escapeHtml(entry.page)} &rsaquo; ${escapeHtml(entry.section)}`
              : escapeHtml(entry.page);
            return `
              <a
                id="search-dyn-${idx}"
                href="${escapeHtml(entry.url)}"
                role="option"
                aria-selected="${idx === 0 ? 'true' : 'false'}"
                data-search-item
                data-active="${idx === 0 ? 'true' : 'false'}"
                class="block p-2.5 sm:p-3 rounded-md border border-transparent hover:border-ink/25 transition"
              >
                <div class="text-xs font-medium text-ink/65 truncate">${breadcrumb}</div>
                <div class="text-xs sm:text-sm font-semibold text-ink mt-0.5">${highlightMatches(entry.title, tokens)}</div>
                ${
                  entry.text
                    ? `<div class="text-xs text-ink/75 mt-1 line-clamp-2 leading-relaxed">${buildSnippet(entry.text, tokens)}</div>`
                    : ''
                }
              </a>
            `;
          })
          .join('');
      }
    }

    if (searchStatus) {
      searchStatus.textContent =
        topResults.length === 1 ? '1 match' : `${topResults.length} matches`;
    }
    updateActiveItem(0);
  }

  function openSearch() {
    if (!searchDialog) return;
    if (!searchDialog.open) {
      searchDialog.showModal();
    }
    void loadSearchIndex();
    if (searchInput) {
      searchInput.focus();
      searchInput.select();
      void runSearch(searchInput.value);
    }
  }

  function closeSearch() {
    if (searchDialog && searchDialog.open) {
      searchDialog.close();
    }
  }

  searchTrigger?.addEventListener('mouseenter', () => {
    void loadSearchIndex();
  });
  searchTrigger?.addEventListener('click', openSearch);
  searchClose?.addEventListener('click', closeSearch);

  searchClear?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      void runSearch('');
    }
  });

  searchInput?.addEventListener('input', () => {
    void runSearch(searchInput.value);
  });

  searchDialog?.addEventListener('click', (e) => {
    if (e.target === searchDialog) {
      closeSearch();
      return;
    }
    const link = (e.target as HTMLElement | null)?.closest('a[data-search-item]');
    if (link) {
      closeSearch();
    }
  });

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (searchDialog?.open) {
        closeSearch();
      } else {
        openSearch();
      }
      return;
    }

    const target = e.target as HTMLElement | null;
    const isEditable =
      target &&
      (target.tagName === 'INPUT' ||
        target.tagName === 'TEXTAREA' ||
        target.tagName === 'SELECT' ||
        target.isContentEditable);

    if (e.key === '/' && !isEditable && !e.metaKey && !e.ctrlKey && !e.altKey) {
      e.preventDefault();
      openSearch();
      return;
    }

    if (!searchDialog?.open) return;

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      updateActiveItem(activeIndex + 1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      updateActiveItem(activeIndex - 1);
    } else if (e.key === 'Enter') {
      const items = getVisibleItems();
      const current = items[activeIndex];
      if (current) {
        e.preventDefault();
        closeSearch();
        window.location.href = current.href;
      }
    }
  });
</script>

<style>
  #lang-nav-menu .lang-dropdown-panel,
  #docs-nav-menu .lang-dropdown-panel,
  #tooling-nav-menu .lang-dropdown-panel {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 140ms ease-out,
      transform 140ms ease-out;
  }

  #docs-nav-menu[data-open='false'] .link-dropdown-panel,
  #lang-nav-menu[data-open='false'] .link-dropdown-panel,
  #tooling-nav-menu[data-open='false'] .link-dropdown-panel {
    display: none;
  }

  #docs-nav-menu[data-open='true'] .link-dropdown-caret,
  #lang-nav-menu[data-open='true'] .link-dropdown-caret,
  #tooling-nav-menu[data-open='true'] .link-dropdown-caret {
    transform: rotate(180deg);
  }

  #lang-nav-menu[data-closing='true'] .lang-dropdown-panel,
  #docs-nav-menu[data-closing='true'] .lang-dropdown-panel,
  #tooling-nav-menu[data-closing='true'] .lang-dropdown-panel {
    opacity: 0;
    transform: translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    #lang-nav-menu .lang-dropdown-panel,
    #docs-nav-menu .lang-dropdown-panel,
    #tooling-nav-menu .lang-dropdown-panel {
      transition: none;
    }
  }
</style>
