---
import { Code } from 'astro:components';
import { languageBenchmarkList, type BenchmarkRow } from '../data/benchmarks';

function formatMultiple(competitorVal: number, omniVal: number): string {
  if (omniVal <= 0 || competitorVal <= omniVal) return '1.0x';
  const ratio = competitorVal / omniVal;
  return ratio >= 10 ? `${Math.round(ratio)}x` : `${ratio.toFixed(1)}x`;
}

function findPrimaryProtobuf(rows: BenchmarkRow[]): BenchmarkRow | undefined {
  const candidates = rows.filter(
    (r) =>
      !(r.baseline || r.highlight) &&
      /protobuf|buffa|prost|nanopb|swiftprotobuf|elixir-protobuf|package:protobuf/i.test(r.name),
  );
  if (candidates.length === 0) return undefined;
  return (
    candidates.find((r) =>
      /^(Protobuf|@bufbuild\/protobuf|buffa|prost|google\.protobuf \(upb|libprotobuf|protobuf-java|Google\.Protobuf|SwiftProtobuf|package:protobuf|google\/protobuf|elixir-protobuf|nanopb)/i.test(
        r.name,
      ),
    ) ?? candidates[0]
  );
}

function findPrimaryJson(rows: BenchmarkRow[]): BenchmarkRow | undefined {
  return rows.find((r) => !(r.baseline || r.highlight) && /json|jason/i.test(r.name));
}

function protobufLabelFor(langKey: string): string {
  if (langKey === 'rs') return 'buffa';
  if (langKey === 'nano') return 'nanopb';
  if (langKey === 'es') return 'protobuf-es';
  return 'Protobuf';
}

function prepareAbbreviatedBars(rows: BenchmarkRow[]) {
  const maxVal = Math.max(...rows.map((r) => r.val), 1);
  return rows.map((r) => ({
    name: r.name,
    isOmni: Boolean(r.baseline || r.highlight),
    pct: Math.max(3, Math.min(100, (r.val / maxVal) * 100)).toFixed(1),
  }));
}

interface ComparisonStat {
  multiple: string;
  label: string;
}

function buildComparisonStats(langKey: string, rows: BenchmarkRow[]): ComparisonStat[] {
  const omni = rows.find((r) => r.baseline || r.highlight) ?? rows[0];
  if (!omni) return [];
  const stats: ComparisonStat[] = [];
  const proto = findPrimaryProtobuf(rows);
  if (proto) {
    stats.push({
      multiple: formatMultiple(proto.val, omni.val),
      label: protobufLabelFor(langKey),
    });
  }
  const json = findPrimaryJson(rows);
  if (json) {
    stats.push({
      multiple: formatMultiple(json.val, omni.val),
      label: 'JSON',
    });
  }
  return stats;
}

const benchmarkPreviews = languageBenchmarkList.map((suite) => {
  const encodeBars = prepareAbbreviatedBars(suite.butterflyEncodeRows);
  const decodeBars = prepareAbbreviatedBars(suite.butterflyDecodeRows);
  const rowCount = Math.max(encodeBars.length, decodeBars.length);
  const pairedRows = Array.from({ length: rowCount }, (_, i) => ({
    encode: encodeBars[i] ?? null,
    decode: decodeBars[i] ?? null,
  }));
  const encodeStats = buildComparisonStats(suite.key, suite.butterflyEncodeRows);
  const decodeStats = buildComparisonStats(suite.key, suite.butterflyDecodeRows);
  const encAria = encodeStats.map((s) => `${s.multiple} faster than ${s.label}`).join(', ');
  const decAria = decodeStats.map((s) => `${s.multiple} faster than ${s.label}`).join(', ');
  return {
    key: suite.key,
    label: suite.label,
    shortLabel: suite.shortLabel,
    href: suite.href,
    langHref: `/${suite.key}`,
    pairedRows,
    encodeStats,
    decodeStats,
    ariaLabel: `${suite.label}: OmniBuf fastest on encode (${encAria}) and decode (${decAria}).`,
  };
});

const spliceSnippet = `var view pb.OpaquePeerUpdate
_ = view.Unmarshal(pkt)
router := view.GetRouterId() // skips earlier fields by byte length
view.SetActive(false)        // marks field #3 dirty
pkt = view.MarshalAppend(nil)`;

const pbAndStructSnippet = `// From .proto
pkt, _ := omnibuf.Marshal(&pb.Node{Id: 1, City: "FRA"})

// From a plain Go struct
type Node struct {
    ID   uint32 \`omnibuf:"1"\`
    City string \`omnibuf:"2"\`
}
pkt, _ := omnibuf.Marshal(&Node{ID: 1, City: "FRA"})`;

const cliSnippet = `brew install omnibuf/tap/omnibuf

# Encode JSON to self-describing OmniBuf bytes
omnibuf < event.json > event.obuf

# Query binary packets with jq syntax
omnibuf -r '.neighbors[] | select(.established) | .router' event.obuf`;
---

<section id="motivation" class="pb-14 sm:pb-20 px-4 sm:px-6 max-w-4xl mx-auto">
  <div class="border-t border-ink/15 divide-y divide-ink/12">
    <!-- 1. DECODE RAW PACKETS WITH NO SCHEMA -->
    <article id="inspectable-without-schema" class="scroll-mt-16 py-10 sm:py-12 space-y-5">
      <div class="space-y-3 max-w-[65ch]">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          Decode raw packets with no schema
        </h2>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          One of the more annoying parts of binary formats is staring at a raw payload in a log line or a packet capture and having no idea what's inside until you track down the exact <code>.proto</code> file. Even <a href="https://github.com/protocolbuffers/protoscope" target="_blank" rel="noopener noreferrer" class="doc-link"><code>protoscope</code></a> ends up guessing on half the fields in a Protobuf message, because strings, raw bytes, arrays, and sub-messages all look the same on the wire.
        </p>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          OmniBuf puts a 4-bit type tag on every field (16 wire types total), so booleans, signed ints, strings, bytes, arrays, and maps stay distinct. Point the <a href="/tooling/cli" class="doc-link"><code>omnibuf</code> CLI</a> at a raw <code>.obuf</code> file and you get real typed JSON back immediately. Turn on <strong>Field #0</strong> for inline field names, and the encoder writes a small name table once at the top of the packet, shared across repeated items in an array.
        </p>
      </div>

      <div class="bg-ink text-paper rounded-lg border border-ink/15 p-4 sm:p-5 font-mono text-xs sm:text-sm space-y-4">
        <div>
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
            <span class="font-semibold text-paper/85">$ protoscope packet.pb</span>
            <span class="text-paper/65">Protobuf &middot; guesses types</span>
          </div>
          <pre class="leading-relaxed overflow-x-auto"><code><span class="text-paper/80">1:</span> 1          <span class="text-paper/65"># bool, uint, sint, or enum?</span>
<span class="text-paper/80">2:</span> 3          <span class="text-paper/65"># +3 uint or -2 sint?</span>
<span class="text-paper/80">3:</span> &#123;<span class="text-paper/90">"FRA"</span>&#125;    <span class="text-paper/65"># string, bytes, or sub-message?</span>
<span class="text-paper/80">4:</span> <span class="text-paper/90">"\x0a\x14"</span> <span class="text-paper/65"># bytes, string, or packed array?</span></code></pre>
        </div>

        <div class="pt-3.5 border-t border-paper/12">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
            <span class="font-semibold text-[#FF7A4D]">$ omnibuf -c packet.obuf</span>
            <span class="text-paper/65">OmniBuf &middot; exact values, no schema</span>
          </div>
          <pre class="leading-relaxed overflow-x-auto"><code>&#123;<span class="text-acid">"field_1"</span>: <span class="text-[#FF7A4D]">true</span>, <span class="text-acid">"field_2"</span>: -2, <span class="text-acid">"field_3"</span>: <span class="text-acid">"FRA"</span>, <span class="text-acid">"field_4"</span>: [10, 20]&#125;</code></pre>
        </div>

        <div class="pt-3.5 border-t border-paper/12">
          <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
            <span class="font-semibold text-[#FF7A4D]">$ omnibuf -c packet-field0.obuf</span>
            <span class="text-paper/65">OmniBuf + Field #0 &middot; values and names</span>
          </div>
          <pre class="leading-relaxed overflow-x-auto"><code>&#123;<span class="text-acid">"active"</span>: <span class="text-[#FF7A4D]">true</span>, <span class="text-acid">"delta"</span>: -2, <span class="text-acid">"city"</span>: <span class="text-acid">"FRA"</span>, <span class="text-acid">"peers"</span>: [10, 20]&#125;</code></pre>
        </div>
      </div>
    </article>

    <!-- 2. FASTER TO ENCODE AND DECODE -->
    <article id="faster-encoding" class="scroll-mt-16 py-10 sm:py-12 space-y-5">
      <div class="space-y-3 max-w-[65ch]">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          Faster to encode and decode
        </h2>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Most of OmniBuf's speed comes from skipping work older wire formats have to do. Protobuf walks nested messages twice just to figure out byte lengths ahead of time. OmniBuf writes them in one pass: the encoder leaves a 2-byte slot for the length, writes the fields right after it, and patches the length at the end. Variable-width integers stay cheap too. Trailing zeros on the first byte tell the CPU the exact width (1, 2, 4, or 9 bytes), so the decoder reads the whole integer in one load with no byte-by-byte loop.
        </p>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Arrays and maps put their element types in one container header up front, so the encoder never repeats a field tag per item and a reader can skip any container in a single addition. In Go and Rust, reusing a destination buffer brings encoding down to zero heap allocations. The bit-level details live over in <a href="/how-it-works" class="doc-link">How It Works</a>.
        </p>
      </div>

      <!-- 12-Language Benchmark Proof Matrix -->
      <div id="speed" class="scroll-mt-16 pt-2 space-y-3" data-home-bench>
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <p class="text-sm text-ink/75 max-w-[62ch]">
            Full 11-field <code>PeerUpdate</code> encode and decode across all{' '}
            {benchmarkPreviews.length} languages (Apple M1 Pro). Each cell stacks every tested
            format, fastest at top; shorter bars are faster.
          </p>
          <a href="/benchmarks" class="doc-link text-sm shrink-0">
            All {benchmarkPreviews.length} benchmarks &rarr;
          </a>
        </div>

        <div class="os-window overflow-hidden">
          <!-- Compact Key Bar -->
          <div class="px-4 sm:px-5 py-2.5 border-b border-ink/12 flex flex-wrap items-center justify-between gap-x-4 gap-y-1.5 text-xs">
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
              <span class="inline-flex items-center gap-1.5 font-semibold text-ink">
                <span
                  class="inline-block w-3 h-1.5 rounded-[1.5px] bench-bar-omni"
                  aria-hidden="true"
                ></span>
                OmniBuf
              </span>
              <span class="inline-flex items-center gap-1.5 text-ink/65">
                <span
                  class="inline-block w-3 h-1.5 rounded-[1.5px] bench-bar-competitor opacity-70"
                  aria-hidden="true"
                ></span>
                Other formats
              </span>
            </div>
            <span class="font-mono text-xs text-ink/65">
              &larr; encode <span class="mx-1 text-ink/40">|</span> decode &rarr;
            </span>
          </div>

          <!-- 12-Language Small-Multiples Butterfly Grid (no bar labels) -->
          <div
            aria-label="Benchmarks by language"
            class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-px bg-[var(--border-subtle)]"
          >
            {benchmarkPreviews.map((suite, idx) => (
              <a
                id={`home-bench-tab-${suite.key}`}
                href={suite.href}
                data-home-bench-tab={suite.key}
                data-active={idx === 0 ? 'true' : 'false'}
                aria-label={suite.ariaLabel}
                class="bench-matrix-cell group text-left px-3.5 py-3 flex flex-col justify-start gap-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-[var(--accent)] no-underline"
              >
                <div class="flex items-center justify-between gap-2">
                  <span class="bench-matrix-lang font-mono text-xs font-semibold text-ink">
                    {suite.shortLabel}
                  </span>
                  <span
                    class="bench-matrix-dot w-1.5 h-1.5 rounded-full transition-opacity"
                    aria-hidden="true"
                  ></span>
                </div>

                <!-- Label-free mirrored micro-bars: Encode left | Decode right -->
                <div class="relative flex flex-col gap-[3px] min-h-[53px]" aria-hidden="true">
                  <span class="pointer-events-none absolute inset-y-0 left-1/2 -translate-x-1/2 w-px bg-ink/15"></span>
                  {suite.pairedRows.map((pair) => (
                    <div class="grid grid-cols-2 items-center gap-[5px] h-[5px]">
                      <div class="flex justify-end items-center h-full">
                        {pair.encode && (
                          <span
                            class:list={[
                              'block h-full rounded-l-[1.5px] min-w-[4px]',
                              pair.encode.isOmni
                                ? 'bench-bar-omni'
                                : 'bench-bar-competitor opacity-65',
                            ]}
                            style={`width: ${pair.encode.pct}%;`}
                            title={`Encode: ${pair.encode.name}`}
                          />
                        )}
                      </div>
                      <div class="flex justify-start items-center h-full">
                        {pair.decode && (
                          <span
                            class:list={[
                              'block h-full rounded-r-[1.5px] min-w-[4px]',
                              pair.decode.isOmni
                                ? 'bench-bar-omni'
                                : 'bench-bar-competitor opacity-65',
                            ]}
                            style={`width: ${pair.decode.pct}%;`}
                            title={`Decode: ${pair.decode.name}`}
                          />
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </a>
            ))}
          </div>

          <!-- Fixed-Height Relative Readout for Selected / Hovered Language -->
          <div class="border-t border-ink/12 bg-[var(--bg-subtle)]/55 px-4 sm:px-5 py-3">
            {benchmarkPreviews.map((suite, idx) => (
              <div
                id={`home-bench-panel-${suite.key}`}
                data-home-bench-panel={suite.key}
                class:list={[
                  'grid grid-cols-1 sm:grid-cols-[8.5rem_1fr_auto] sm:items-center gap-x-5 gap-y-2',
                  idx === 0 ? '' : 'hidden',
                ]}
              >
                <div class="text-sm font-semibold text-ink leading-snug">{suite.label}</div>

                <dl class="grid grid-cols-[4.25rem_1fr] gap-x-3 gap-y-1 text-xs items-baseline min-w-0">
                  <dt class="font-medium text-ink/65">Encode</dt>
                  <dd class="font-mono tabular-nums text-ink/80 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                    {suite.encodeStats.map((stat, statIdx) => (
                      <span class="whitespace-nowrap">
                        {statIdx > 0 && (
                          <span class="mr-2 text-ink/45" aria-hidden="true">
                            &middot;
                          </span>
                        )}
                        <span
                          class={
                            statIdx === 0 ? 'font-semibold text-accent' : 'font-semibold text-ink'
                          }
                        >
                          {stat.multiple} faster
                        </span>{' '}
                        <span class="text-ink/70">vs {stat.label}</span>
                      </span>
                    ))}
                  </dd>

                  <dt class="font-medium text-ink/65">Decode</dt>
                  <dd class="font-mono tabular-nums text-ink/80 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                    {suite.decodeStats.map((stat, statIdx) => (
                      <span class="whitespace-nowrap">
                        {statIdx > 0 && (
                          <span class="mr-2 text-ink/45" aria-hidden="true">
                            &middot;
                          </span>
                        )}
                        <span
                          class={
                            statIdx === 0 ? 'font-semibold text-accent' : 'font-semibold text-ink'
                          }
                        >
                          {stat.multiple} faster
                        </span>{' '}
                        <span class="text-ink/70">vs {stat.label}</span>
                      </span>
                    ))}
                  </dd>
                </dl>

                <div class="flex sm:flex-col items-baseline sm:items-end justify-between sm:justify-center gap-x-4 gap-y-1 text-xs shrink-0 pt-1 sm:pt-0 border-t sm:border-t-0 border-ink/10">
                  <a href={suite.langHref} class="doc-link">
                    {suite.shortLabel} guide
                  </a>
                  <a href={suite.href} class="doc-link text-ink/75">
                    Full benchmarks &rarr;
                  </a>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Honest Tradeoffs -->
        <p class="pt-1 text-sm sm:text-base text-ink/80 leading-relaxed max-w-[65ch]">
          OmniBuf can replace a lot of Protobuf and JSON, though every wire format comes with
          tradeoffs. Protobuf ends up around 7% smaller on dense messages (341 B vs 366 B on{' '}
          <code>PeerUpdate</code>) and has twenty years of tooling behind it. FlatBuffers and Cap'n
          Proto stay quicker at grabbing a single field out of a huge buffer via offset tables,
          though their payloads run a good bit larger and you have to deal with builder APIs. And
          for public APIs where you just want to send someone a <code>curl</code> command, JSON
          still makes sense.
        </p>
      </div>
    </article>

    <!-- 3. READ OR EDIT ONE FIELD IN PLACE -->
    <article id="read-or-splice" class="scroll-mt-16 py-10 sm:py-12 space-y-5">
      <div class="space-y-3 max-w-[65ch]">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          Read or edit one field in place
        </h2>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          A lot of services sitting in the middle of a request only care about one field... maybe a
          router ID, a tenant check, or flipping an active flag. Normally you end up decoding and
          allocating the whole message just to touch that one value and re-encode everything.
        </p>
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Every field in OmniBuf carries its byte length right in the header, so a reader can jump
          past fields it doesn't care about. Generated <code>Opaque</code> views let you pull out a
          single field or splice a new value straight back into the raw byte slice, and any unknown
          fields from newer writers get copied through as-is.
        </p>
      </div>

      <div class="bg-ink text-paper rounded-lg border border-ink/15 p-4 sm:p-5 font-mono text-xs sm:text-sm overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed">
        <div class="flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-paper/12 text-xs text-paper/60">
          <span>splice.go</span>
          <button
            type="button"
            data-copy={spliceSnippet}
            class="copy-snippet-btn px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 text-paper border border-paper/20 rounded transition cursor-pointer"
          >
            Copy
          </button>
        </div>
        <Code code={spliceSnippet} lang="go" theme="github-dark" />
      </div>
    </article>

    <!-- 4. PROTOBUF + GRPC OR PLAIN STRUCTS -->
    <article id="proto-or-plain-structs" class="scroll-mt-16 py-10 sm:py-12 space-y-5">
      <div class="space-y-3 max-w-[65ch]">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          Use .proto files or plain structs
        </h2>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          You can drop OmniBuf into <a href="https://grpc.io/" target="_blank" rel="noopener noreferrer" class="doc-link">gRPC</a> or <a href="https://connectrpc.com/" target="_blank" rel="noopener noreferrer" class="doc-link">Connect</a> as a custom codec in a few lines of code and keep the <code>.proto</code> files and service stubs you already have.
        </p>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          Or skip <code>.proto</code> completely. <a href="/go#struct-tags" class="doc-link">Go struct tags</a> (<code>omnibuf:"1"</code>), <a href="/rs" class="doc-link">Rust derive macros</a>, and <a href="/es#define-message" class="doc-link">TypeScript <code>defineMessage</code></a> schemas all write out the exact same bytes as <code>buf generate</code>. Both Go snippets below produce the exact same 7 bytes.
        </p>
      </div>

      <div class="bg-ink text-paper rounded-lg border border-ink/15 p-4 sm:p-5 font-mono text-xs sm:text-sm space-y-3.5 overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed">
        <div class="flex items-center justify-between gap-2 pb-2.5 border-b border-paper/12 text-xs text-paper/60">
          <span>marshal.go</span>
          <button
            type="button"
            data-copy={pbAndStructSnippet}
            class="copy-snippet-btn px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 text-paper border border-paper/20 rounded transition cursor-pointer"
          >
            Copy
          </button>
        </div>
        <Code code={pbAndStructSnippet} lang="go" theme="github-dark" />
        <div class="pt-3 border-t border-paper/12 flex flex-wrap items-center justify-between gap-2 text-xs">
          <span class="text-paper/60">Identical wire output (7 bytes)</span>
          <span class="text-acid font-semibold">21 03 55 07 46 52 41</span>
        </div>
      </div>
    </article>

    <!-- 5. CLI, TOOLING & CONFORMANCE -->
    <article id="tooling-overview" class="scroll-mt-16 py-10 sm:py-12 space-y-5">
      <div class="space-y-3 max-w-[65ch]">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          CLI, editors, and conformance
        </h2>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          All 12 runtimes run against the same 1109-case conformance suite, so a packet written in Go decodes the same way in Rust, TypeScript, Python, or C99 (Editions 2023/2024/2026, malformed inputs, and decode memory limits are tested there too).
        </p>
        <!-- prettier-ignore -->
        <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
          The <a href="/tooling/cli" class="doc-link"><code>omnibuf</code> CLI</a> handles JSON conversion and <code>jq</code> filters straight on binary files, which covers most terminal debugging. For editors and live traffic, check <a href="/tooling/editors" class="doc-link">Editor Plugins</a>, <a href="/tooling/devtools" class="doc-link">DevTools</a>, and <a href="/tooling/traffic" class="doc-link">Traffic Inspection</a>.
        </p>
      </div>

      <div class="bg-ink text-paper rounded-lg border border-ink/15 p-4 sm:p-5 font-mono text-xs sm:text-sm overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed">
        <div class="flex items-center justify-between gap-2 pb-2.5 mb-3 border-b border-paper/12 text-xs text-paper/60">
          <span>terminal</span>
          <button
            type="button"
            data-copy={cliSnippet}
            class="copy-snippet-btn px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 text-paper border border-paper/20 rounded transition cursor-pointer"
          >
            Copy
          </button>
        </div>
        <Code code={cliSnippet} lang="sh" theme="github-dark" />
      </div>
    </article>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-home-bench]').forEach((widget) => {
    const cells = Array.from(widget.querySelectorAll<HTMLElement>('[data-home-bench-tab]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-home-bench-panel]'));

    function activate(key: string) {
      cells.forEach((cell) => {
        const isActive = cell.getAttribute('data-home-bench-tab') === key;
        cell.setAttribute('data-active', isActive ? 'true' : 'false');
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-home-bench-panel') !== key);
      });
    }

    cells.forEach((cell, idx) => {
      const key = cell.getAttribute('data-home-bench-tab');
      cell.addEventListener('pointerenter', () => {
        if (key) activate(key);
      });
      cell.addEventListener('focus', () => {
        if (key) activate(key);
      });
      cell.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = cells[(idx + dir + cells.length) % cells.length];
          if (next) {
            next.focus();
            const nextKey = next.getAttribute('data-home-bench-tab');
            if (nextKey) activate(nextKey);
          }
        }
      });
    });
  });
</script>
