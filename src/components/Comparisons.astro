---
import {
  benchmarkCategories,
  formatProfiles,
  languageBenchmarkList,
  opponentKeys,
} from '../data/benchmarks';
import RadarChart from './RadarChart.astro';

const packetSizeCat = benchmarkCategories.find((cat) => cat.unit === 'B');

const comparisonLanguageCharts = languageBenchmarkList.map((suite) => {
  const maxEnc = Math.max(...suite.butterflyEncodeRows.map((r) => r.val), 1);
  const maxDec = Math.max(...suite.butterflyDecodeRows.map((r) => r.val), 1);
  const decByName = new Map(suite.butterflyDecodeRows.map((r) => [r.name, r.val]));
  const bRows = suite.butterflyEncodeRows.map((r) => {
    const decVal = decByName.get(r.name) ?? r.val;
    return {
      name: r.name,
      baseline: Boolean(r.baseline),
      encVal: r.val,
      decVal,
      encPct: Math.max(4.5, Math.min(100, (r.val / maxEnc) * 100)).toFixed(1),
      decPct: Math.max(4.5, Math.min(100, (decVal / maxDec) * 100)).toFixed(1),
    };
  });
  const omni = bRows.find((r) => r.baseline) ?? bRows[0];
  const rest = bRows.filter((r) => !r.baseline);
  return {
    ...suite,
    omni,
    rest,
  };
});
---

<section
  id="comparisons"
  class="py-16 sm:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
>
  <div class="max-w-3xl mb-10">
    <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
      How OmniBuf compares to{' '}
      <span class="font-serif italic font-normal normal-case text-[#FF4F18]">other formats.</span>
    </h2>
    <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium leading-relaxed">
      Wire size is the same across languages, and encode/decode speed depends on the runtime. Full
      numbers and test setup are on the{' '}
      <a href="/go#benchmarks" class="doc-link">
        Go benchmarks
      </a>{' '}
      and{' '}
      <a href="/es#benchmarks" class="doc-link">
        TypeScript &amp; JS benchmarks
      </a>{' '}
      pages.
    </p>
  </div>

  <!-- Tabbed Language Butterfly Preview + Packet Size on the Wire -->
  <div
    class="grid lg:grid-cols-12 gap-8 mb-10 items-start select-none"
    data-butterfly-widget="comparisons"
  >
    <!-- Left: Interactive Tabbed Butterfly Chart -->
    <div class="lg:col-span-5 flex flex-col justify-between p-4 sm:p-5 bg-[#FAF8F2] border-2 border-ink rounded-md shadow-[6px_6px_0px_#111111]">
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight leading-none text-ink">
            Runtime{' '}
            <span class="font-serif italic font-normal normal-case text-[#FF4F18]">speed.</span>
          </h3>
          <div
            role="tablist"
            aria-label="Select runtime speed comparison language"
            class="inline-flex items-center gap-1.5 font-mono text-xs font-bold uppercase"
          >
            {comparisonLanguageCharts.map((preview, idx) => (
              <button
                type="button"
                role="tab"
                data-butterfly-tab={preview.key}
                aria-selected={idx === 0 ? 'true' : 'false'}
                class:list={[
                  'px-2.5 py-1 rounded border-2 border-ink transition cursor-pointer',
                  idx === 0
                    ? 'bg-acid text-ink shadow-[2px_2px_0px_#111111]'
                    : 'bg-white text-ink/75 hover:bg-[#E5E0D5] hover:text-ink',
                ]}
              >
                {preview.shortLabel}
              </button>
            ))}
          </div>
        </div>

        <div class="grid grid-cols-2 items-baseline border-b-2 border-ink pb-1 mb-2 font-mono text-xs font-bold uppercase text-ink">
          <div class="text-right pr-3">&larr; Encode</div>
          <div class="text-left pl-3 border-l-2 border-ink">Decode &rarr;</div>
        </div>

        {comparisonLanguageCharts.map((preview, idx) => (
          <div role="tabpanel" data-butterfly-panel={preview.key} class={idx === 0 ? '' : 'hidden'}>
            <!-- OmniBuf Row -->
            <div
              class="grid grid-cols-2 items-center py-1"
              title={`${preview.omni.name} - Encode: ${preview.omni.encVal} ns, Decode: ${preview.omni.decVal} ns`}
            >
              <div class="flex items-center justify-end pr-0.5 min-w-0">
                <svg
                  class="w-5 h-3.5 text-[#FF4F18] shrink-0 mr-1"
                  viewBox="0 0 22 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M1 7H19M19 7L14 2M19 7L14 12"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <div
                  class="h-4 bench-bar-omni border-2 border-ink rounded-l-sm shadow-[1px_1px_0px_#111111] shrink-0"
                  style={`width: ${preview.omni.encPct}%;`}
                />
              </div>
              <div class="flex items-center justify-start pl-0.5 border-l-2 border-ink min-w-0">
                <div
                  class="h-4 bench-bar-omni border-2 border-ink rounded-r-sm shadow-[1px_1px_0px_#111111] shrink-0"
                  style={`width: ${preview.omni.decPct}%;`}
                />
                <svg
                  class="w-5 h-3.5 text-[#FF4F18] shrink-0 mx-1"
                  viewBox="0 0 22 14"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M21 7H3M3 7L8 2M3 7L8 12"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span class="font-mono text-xs font-bold uppercase px-2 py-0.5 bg-acid border-2 border-ink text-ink shadow-[2px_2px_0px_#111111] leading-none rounded-sm shrink-0">
                  OmniBuf
                </span>
              </div>
            </div>

            <!-- Competitor Rows -->
            <div class="mt-0.5 space-y-1">
              {preview.rest.map((r) => (
                <div
                  class="grid grid-cols-2 items-center"
                  title={`${r.name} - Encode: ${r.encVal} ns, Decode: ${r.decVal} ns`}
                >
                  <div class="flex items-center justify-end pr-0.5 min-w-0">
                    <div
                      class="h-2.5 bench-bar-competitor border border-ink/65 rounded-l-sm opacity-80"
                      style={`width: ${r.encPct}%;`}
                    />
                  </div>
                  <div class="flex items-center justify-start pl-0.5 border-l-2 border-ink min-w-0">
                    <div
                      class="h-2.5 bench-bar-competitor border border-ink/65 rounded-r-sm opacity-80"
                      style={`width: ${r.decPct}%;`}
                    />
                  </div>
                </div>
              ))}
            </div>

            <div class="mt-2.5 flex items-center justify-center gap-2">
              <svg
                class="w-7 h-4 text-ink/75 shrink-0"
                viewBox="0 0 28 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M26 13C16 13 11 9 6 2M6 2L5 8.5M6 2L12.5 4"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
              <span class="font-mono text-[11px] font-bold uppercase px-2 py-1 bg-[#E5E0D5] border border-ink text-ink text-center leading-tight rounded-sm">
                {preview.competitorsLabel}
              </span>
              <svg
                class="w-7 h-4 text-ink/75 shrink-0"
                viewBox="0 0 28 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M2 13C12 13 17 9 22 2M22 2L23 8.5M22 2L15.5 4"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </div>
          </div>
        ))}
      </div>

      <div class="pt-2.5 mt-3 border-t border-ink/20 flex items-center justify-between font-mono text-xs font-bold uppercase">
        <span class="text-ink/65">Shorter = Faster</span>
        {comparisonLanguageCharts.map((preview, idx) => (
          <a
            href={preview.href}
            data-butterfly-link={preview.key}
            class:list={[
              'text-ink underline decoration-ink/50 underline-offset-2 hover:text-[#FF4F18]',
              idx === 0 ? '' : 'hidden',
            ]}
          >
            {preview.ctaLabel} &rarr;
          </a>
        ))}
      </div>
    </div>

    <!-- Right: Packet Size on the Wire -->
    {packetSizeCat && (
      <div
        id="packet-size"
        class="lg:col-span-7 os-window overflow-hidden scroll-mt-20 select-none"
      >
        <div class="os-titlebar bg-[#E5E0D5]">
          <span class="font-mono text-xs sm:text-sm font-bold uppercase">
            {packetSizeCat.title}
          </span>
          <div class="os-stripes" />
        </div>

        <div class="p-3.5 sm:p-4 bg-[#FAF8F2] space-y-1">
          <p class="text-xs sm:text-sm text-ink/85 leading-snug pb-1.5 max-w-[70ch]">
            {packetSizeCat.methodology}
          </p>
          {(() => {
            const omniVal =
              packetSizeCat.rows.find((row) => row.baseline)?.val ??
              packetSizeCat.rows.find((row) => row.highlight)?.val ??
              packetSizeCat.rows[0].val;
            return packetSizeCat.rows.map((r) => {
              const numPct = Math.max(2, Math.min(100, (r.val / packetSizeCat.maxVal) * 100));
              const pct = numPct.toFixed(1);
              let ratioStr = 'Baseline (1x)';
              if (r.val !== omniVal) {
                const pctDiff = Math.round((Math.abs(r.val - omniVal) / omniVal) * 100);
                ratioStr = r.val < omniVal ? `${pctDiff}% smaller` : `+${pctDiff}% larger`;
              }
              return (
                <div
                  class:list={[
                    'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1 rounded min-w-0',
                    r.baseline
                      ? 'bg-acid/45 border-2 border-ink shadow-[2px_2px_0px_#111111] font-bold'
                      : r.highlight
                        ? 'bg-acid/25 border-2 border-dashed border-ink font-bold'
                        : 'border border-ink/15 bg-white',
                  ]}
                >
                  <div
                    class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate"
                    title={r.name}
                  >
                    {r.name}
                  </div>
                  <div class="col-span-6 sm:col-span-4 flex items-center min-w-0">
                    <div class="w-full bg-[#E5E0D5] h-3.5 border border-ink rounded-sm overflow-hidden">
                      <div
                        class:list={[
                          'h-full',
                          numPct < 99.5 && 'border-r border-ink',
                          r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                        ]}
                        style={`width: ${pct}%;`}
                      />
                    </div>
                  </div>
                  <div class="col-span-6 sm:col-span-3 text-right font-mono text-xs tabular-nums whitespace-nowrap leading-none">
                    <span class="font-bold text-ink">{ratioStr}</span>{' '}
                    <span class="text-ink/70 font-normal">
                      ({r.val.toLocaleString('en-US')} {packetSizeCat.unit})
                    </span>
                  </div>
                </div>
              );
            });
          })()}
        </div>
      </div>
    )}
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <!-- Standalone OmniBuf Panel Explaining the 5 Radar Scores -->
    <div id="compare-omnibuf" class="os-window overflow-hidden scroll-mt-20 flex flex-col">
      <div class="os-titlebar bg-[#E5E0D5]">
        <h3 class="font-mono text-sm sm:text-base font-bold uppercase">OmniBuf Baseline</h3>
        <div class="os-stripes"></div>
      </div>

      <div class="bg-ink text-paper p-6 sm:p-7 flex-1 flex flex-col justify-between min-w-0">
        <div>
          <div class="flex items-center justify-between border-b border-paper/15 pb-3 mb-4 font-mono text-sm">
            <span class="flex items-center gap-2 font-bold text-acid">
              <span class="w-3 h-3 bg-acid inline-block border border-ink"></span> OmniBuf
            </span>
          </div>
          <RadarChart oppKey="omnibuf" />
        </div>

        <div class="mt-4 pt-4 border-t border-paper/20">
          <p class="text-sm sm:text-base text-paper/95 leading-relaxed">
            {formatProfiles.omnibuf.verdict}
          </p>
        </div>
      </div>
    </div>

    {opponentKeys.map((oppKey) => {
      const opp = formatProfiles[oppKey];
      return (
        <div id={`compare-${oppKey}`} class="os-window overflow-hidden scroll-mt-20 flex flex-col">
          <div class="os-titlebar bg-[#E5E0D5]">
            {/* prettier-ignore */}
            <h3 class="font-mono text-sm sm:text-base font-bold uppercase">
              {opp.url ? <a href={opp.url} target="_blank" rel="noopener noreferrer" class="doc-link">{opp.name}</a> : opp.name} vs. OmniBuf
            </h3>
            <div class="os-stripes" />
          </div>

          <div class="bg-ink text-paper p-6 sm:p-7 flex-1 flex flex-col justify-between min-w-0">
            <div>
              <div class="flex items-center justify-between border-b border-paper/15 pb-3 mb-4 font-mono text-sm">
                <span class="flex items-center gap-2 font-bold text-[#FF4F18]">
                  <span class="w-3 h-3 bg-[#FF4F18] inline-block border border-ink" /> {opp.name}
                </span>
                <span class="flex items-center gap-2 font-bold text-acid">
                  <span class="w-3 h-3 bg-acid inline-block border border-ink" /> OmniBuf
                </span>
              </div>
              <RadarChart oppKey={oppKey} />
            </div>

            <div class="mt-4 pt-4 border-t border-paper/20">
              <p class="text-sm sm:text-base text-paper/95 leading-relaxed">{opp.verdict}</p>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-butterfly-widget]').forEach((widget) => {
    const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-butterfly-tab]'));
    const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-panel]'));
    const links = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-link]'));

    function activateLang(key: string) {
      tabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-butterfly-tab') === key;
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.classList.toggle('bg-acid', isActive);
        tab.classList.toggle('text-ink', isActive);
        tab.classList.toggle('shadow-[2px_2px_0px_#111111]', isActive);
        tab.classList.toggle('bg-white', !isActive);
        tab.classList.toggle('text-ink/75', !isActive);
      });
      panels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-butterfly-panel') !== key);
      });
      links.forEach((link) => {
        link.classList.toggle('hidden', link.getAttribute('data-butterfly-link') !== key);
      });
    }

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        const key = tab.getAttribute('data-butterfly-tab');
        if (key) activateLang(key);
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = tabs[(idx + dir + tabs.length) % tabs.length];
          if (next) {
            next.focus();
            const key = next.getAttribute('data-butterfly-tab');
            if (key) activateLang(key);
          }
        }
      });
    });
  });
</script>
