---
import {
  benchmarkCategories,
  formatProfiles,
  languageBenchmarkList,
  opponentKeys,
} from '../data/benchmarks';
import RadarChart from './RadarChart.astro';

const packetSizeCat = benchmarkCategories.find((cat) => cat.unit === 'B');

const comparisonLanguageCharts = languageBenchmarkList.map((suite) => {
  const maxEnc = Math.max(...suite.butterflyEncodeRows.map((r) => r.val), 1);
  const maxDec = Math.max(...suite.butterflyDecodeRows.map((r) => r.val), 1);
  const decByName = new Map(suite.butterflyDecodeRows.map((r) => [r.name, r.val]));
  const bRows = suite.butterflyEncodeRows.map((r) => {
    const decVal = decByName.get(r.name) ?? r.val;
    return {
      name: r.name,
      baseline: Boolean(r.baseline),
      encVal: r.val,
      decVal,
      encPct: Math.max(4.5, Math.min(100, (r.val / maxEnc) * 100)).toFixed(1),
      decPct: Math.max(4.5, Math.min(100, (decVal / maxDec) * 100)).toFixed(1),
    };
  });
  const omni = bRows.find((r) => r.baseline) ?? bRows[0];
  const rest = bRows.filter((r) => !r.baseline);
  return {
    ...suite,
    omni,
    rest,
  };
});
---

<section
  id="comparisons"
  class="py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
>
  <div class="max-w-3xl mb-8">
    <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
      How OmniBuf compares to other formats
    </h2>
    <p class="mt-2.5 text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
      Wire size is identical across languages, and encode/decode speed tracks each runtime. Full
      numbers, cross-language comparisons, and methodology live on the{' '}
      <a href="/benchmarks" class="doc-link">
        benchmarks page
      </a>
      .
    </p>
  </div>

  <!-- Tabbed Language Speed Preview + Packet Size on the Wire -->
  <div
    class="grid lg:grid-cols-12 gap-6 mb-10 items-start select-none"
    data-butterfly-widget="comparisons"
  >
    <!-- Left: Interactive Tabbed Speed Comparison -->
    <div class="lg:col-span-5 os-window p-4 sm:p-5 flex flex-col justify-between">
      <div>
        <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
          <h3 class="text-base sm:text-lg font-bold tracking-tight text-ink">Runtime speed</h3>
          <span class="font-mono text-xs text-ink/60">Shorter = faster</span>
        </div>

        <div
          role="tablist"
          aria-label="Select runtime speed comparison language"
          class="flex flex-wrap items-center gap-1.5 mb-4 font-mono text-xs"
        >
          {comparisonLanguageCharts.map((preview, idx) => (
            <button
              id={`comp-butterfly-tab-${preview.key}`}
              type="button"
              role="tab"
              data-butterfly-tab={preview.key}
              aria-selected={idx === 0 ? 'true' : 'false'}
              aria-controls={`comp-butterfly-panel-${preview.key}`}
              tabindex={idx === 0 ? 0 : -1}
              class="seg-tab px-2 py-1"
            >
              {preview.shortLabel}
            </button>
          ))}
        </div>

        <div class="grid grid-cols-[6.75rem_1fr_1fr] items-baseline border-b border-ink/15 pb-1.5 mb-2.5 font-mono text-xs font-medium text-ink/70">
          <div>Format</div>
          <div class="text-right pr-2">&larr; Encode</div>
          <div class="text-left pl-2 border-l border-ink/15">Decode &rarr;</div>
        </div>

        {comparisonLanguageCharts.map((preview, idx) => (
          <div
            id={`comp-butterfly-panel-${preview.key}`}
            role="tabpanel"
            aria-labelledby={`comp-butterfly-tab-${preview.key}`}
            data-butterfly-panel={preview.key}
            class={idx === 0 ? '' : 'hidden'}
          >
            <!-- OmniBuf Row -->
            <div
              class="grid grid-cols-[6.75rem_1fr_1fr] items-center py-1"
              title={`${preview.omni.name} - Encode: ${preview.omni.encVal} ns, Decode: ${preview.omni.decVal} ns`}
            >
              <span class="font-mono text-xs font-semibold text-accent truncate pr-2">OmniBuf</span>
              <div class="flex items-center justify-end pr-1 min-w-0">
                <div
                  class="h-3.5 bench-bar-omni rounded-l-sm shrink-0"
                  style={`width: ${preview.omni.encPct}%;`}
                />
              </div>
              <div class="flex items-center justify-start pl-1 border-l border-ink/15 min-w-0">
                <div
                  class="h-3.5 bench-bar-omni rounded-r-sm shrink-0"
                  style={`width: ${preview.omni.decPct}%;`}
                />
              </div>
            </div>

            <!-- Competitor Rows -->
            <div class="mt-1 space-y-1.5">
              {preview.rest.map((r) => (
                <div
                  class="grid grid-cols-[6.75rem_1fr_1fr] items-center"
                  title={`${r.name} - Encode: ${r.encVal} ns, Decode: ${r.decVal} ns`}
                >
                  <span class="font-mono text-xs text-ink/75 truncate pr-2">{r.name}</span>
                  <div class="flex items-center justify-end pr-1 min-w-0">
                    <div
                      class="h-2.5 bench-bar-competitor rounded-l-sm opacity-80"
                      style={`width: ${r.encPct}%;`}
                    />
                  </div>
                  <div class="flex items-center justify-start pl-1 border-l border-ink/15 min-w-0">
                    <div
                      class="h-2.5 bench-bar-competitor rounded-r-sm opacity-80"
                      style={`width: ${r.decPct}%;`}
                    />
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="pt-3 mt-4 border-t border-ink/12 flex items-center justify-between text-xs sm:text-sm">
        <span class="font-mono text-xs text-ink/60">PeerUpdate (11 fields)</span>
        {comparisonLanguageCharts.map((preview, idx) => (
          <a
            href={preview.href}
            data-butterfly-link={preview.key}
            class:list={['doc-link', idx === 0 ? '' : 'hidden']}
          >
            {preview.ctaLabel} &rarr;
          </a>
        ))}
      </div>
    </div>

    <!-- Right: Packet Size on the Wire -->
    {packetSizeCat && (
      <div
        id="packet-size"
        class="lg:col-span-7 os-window overflow-hidden scroll-mt-20 select-none"
      >
        <div class="os-titlebar">
          <span class="text-sm font-semibold text-ink">{packetSizeCat.title}</span>
        </div>

        <div class="p-4 sm:p-5 bg-[#FAF8F2] space-y-1.5">
          <p class="text-xs sm:text-sm text-ink/75 leading-relaxed pb-2 max-w-[70ch]">
            {packetSizeCat.methodology}
          </p>
          {(() => {
            const omniVal =
              packetSizeCat.rows.find((row) => row.baseline)?.val ??
              packetSizeCat.rows.find((row) => row.highlight)?.val ??
              packetSizeCat.rows[0].val;
            return packetSizeCat.rows.map((r) => {
              const numPct = Math.max(2, Math.min(100, (r.val / packetSizeCat.maxVal) * 100));
              const pct = numPct.toFixed(1);
              let ratioStr = 'Baseline (1x)';
              if (r.val !== omniVal) {
                const pctDiff = Math.round((Math.abs(r.val - omniVal) / omniVal) * 100);
                ratioStr = r.val < omniVal ? `${pctDiff}% smaller` : `+${pctDiff}% larger`;
              }
              return (
                <div
                  class:list={[
                    'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1.5 rounded-md min-w-0',
                    r.baseline
                      ? 'bench-row-omni font-semibold'
                      : r.highlight
                        ? 'bench-row-omni-secondary font-medium'
                        : 'border border-ink/10 bg-white',
                  ]}
                >
                  <div
                    class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate"
                    title={r.name}
                  >
                    {r.name}
                  </div>
                  <div class="col-span-6 sm:col-span-4 flex items-center min-w-0">
                    <div class="w-full bench-track h-2.5 rounded-full overflow-hidden">
                      <div
                        class:list={[
                          'h-full rounded-full',
                          r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                        ]}
                        style={`width: ${pct}%;`}
                      />
                    </div>
                  </div>
                  <div class="col-span-6 sm:col-span-3 text-right font-mono text-xs tabular-nums whitespace-nowrap leading-none">
                    <span class="font-semibold text-ink">{ratioStr}</span>{' '}
                    <span class="text-ink/65 font-normal">
                      ({r.val.toLocaleString('en-US')} {packetSizeCat.unit})
                    </span>
                  </div>
                </div>
              );
            });
          })()}
        </div>
      </div>
    )}
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    <!-- Standalone OmniBuf Panel Explaining the 5 Radar Scores -->
    <div id="compare-omnibuf" class="os-window overflow-hidden scroll-mt-20 flex flex-col">
      <div class="os-titlebar">
        <h3 class="text-sm font-semibold text-ink">OmniBuf baseline</h3>
      </div>

      <div class="bg-ink text-paper p-5 sm:p-6 flex-1 flex flex-col justify-between min-w-0">
        <div>
          <div class="flex items-center justify-between border-b border-paper/15 pb-3 mb-4 font-mono text-xs">
            <span class="flex items-center gap-2 font-semibold text-[#FF7A4D]">
              <span class="w-2.5 h-2.5 rounded-[2px] bg-[#FF4F18] inline-block"></span> OmniBuf
            </span>
          </div>
          <RadarChart oppKey="omnibuf" />
        </div>

        <div class="mt-4 pt-4 border-t border-paper/15">
          <p class="text-sm sm:text-base text-paper/90 leading-relaxed">
            {formatProfiles.omnibuf.verdict}
          </p>
        </div>
      </div>
    </div>

    {opponentKeys.map((oppKey) => {
      const opp = formatProfiles[oppKey];
      return (
        <div id={`compare-${oppKey}`} class="os-window overflow-hidden scroll-mt-20 flex flex-col">
          <div class="os-titlebar">
            {/* prettier-ignore */}
            <h3 class="text-sm font-semibold text-ink">
              {opp.url ? <a href={opp.url} target="_blank" rel="noopener noreferrer" class="doc-link">{opp.name}</a> : opp.name} vs. OmniBuf
            </h3>
          </div>

          <div class="bg-ink text-paper p-5 sm:p-6 flex-1 flex flex-col justify-between min-w-0">
            <div>
              <div class="flex items-center justify-between border-b border-paper/15 pb-3 mb-4 font-mono text-xs">
                <span class="flex items-center gap-2 font-semibold text-[#FF7A4D]">
                  <span class="w-2.5 h-2.5 rounded-[2px] bg-[#FF4F18] inline-block" /> OmniBuf
                </span>
                <span class="flex items-center gap-2 font-semibold text-[#7DD3FC]">
                  <span class="w-2.5 h-2.5 rounded-[2px] bg-[#38BDF8] inline-block" /> {opp.name}
                </span>
              </div>
              <RadarChart oppKey={oppKey} />
            </div>

            <div class="mt-4 pt-4 border-t border-paper/15">
              <p class="text-sm sm:text-base text-paper/90 leading-relaxed">{opp.verdict}</p>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-butterfly-widget="comparisons"]')
    .forEach((widget) => {
      const tabs = Array.from(widget.querySelectorAll<HTMLButtonElement>('[data-butterfly-tab]'));
      const panels = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-panel]'));
      const links = Array.from(widget.querySelectorAll<HTMLElement>('[data-butterfly-link]'));

      function activateLang(key: string) {
        tabs.forEach((tab) => {
          const isActive = tab.getAttribute('data-butterfly-tab') === key;
          tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
          tab.setAttribute('tabindex', isActive ? '0' : '-1');
        });
        panels.forEach((panel) => {
          panel.classList.toggle('hidden', panel.getAttribute('data-butterfly-panel') !== key);
        });
        links.forEach((link) => {
          link.classList.toggle('hidden', link.getAttribute('data-butterfly-link') !== key);
        });
      }

      tabs.forEach((tab, idx) => {
        tab.addEventListener('click', () => {
          const key = tab.getAttribute('data-butterfly-tab');
          if (key) activateLang(key);
        });
        tab.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const next = tabs[(idx + dir + tabs.length) % tabs.length];
            if (next) {
              next.focus();
              const key = next.getAttribute('data-butterfly-tab');
              if (key) activateLang(key);
            }
          }
        });
      });
    });
</script>
