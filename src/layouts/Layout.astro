---
import '../styles/global.css';
import { getRouteSeoData } from '../data/seo';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  noindex?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'OmniBuf: Fast, Self-Describing Binary Wire Format',
  description = 'Fast, self-describing binary wire format for Protocol Buffers and native structs. Single-pass encoding, schema-less inspection, and 12 language runtimes.',
  keywords,
  noindex = false,
  ogImage = '/og-image.jpg',
  ogImageAlt,
  ogType = 'website',
  jsonLd,
} = Astro.props;

const siteBase = Astro.site ?? 'https://omnibuf.com';
const normalizedPath = Astro.url.pathname === '/' ? '/' : Astro.url.pathname.replace(/\/+$/, '');
const canonicalURL = new URL(normalizedPath, siteBase);
const ogImageURL = new URL(ogImage, siteBase);
const resolvedOgImageAlt = ogImageAlt ?? title;
const ogImageType = ogImage.endsWith('.png')
  ? 'image/png'
  : ogImage.endsWith('.webp')
    ? 'image/webp'
    : 'image/jpeg';
const routeSeo = noindex
  ? { keywords: [], jsonLd: [] }
  : getRouteSeoData(normalizedPath, title, description);
const resolvedKeywords = keywords ?? routeSeo.keywords;
const jsonLdItems = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : routeSeo.jsonLd;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {resolvedKeywords.length > 0 && <meta name="keywords" content={resolvedKeywords.join(', ')} />}
    <meta name="author" content="OmniBuf" />
    <meta name="theme-color" content="#f4f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111111" media="(prefers-color-scheme: dark)" />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <>
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
        <link rel="canonical" href={canonicalURL} />
      </>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="OmniBuf" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content={ogImageType} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={resolvedOgImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={resolvedOgImageAlt} />
    {jsonLdItems.map((item) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('omnibuf-theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (saved === 'dark' || (!saved && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {
          // Ignore storage access errors
        }
      })();
    </script>
    <script
      is:inline
      src="https://analytics.ahrefs.com/analytics.js"
      data-key="qTEtyGiditf53EuAY+fOrA"
      async
    ></script>
  </head>
  <body class="font-display antialiased selection:bg-[#FF4F18] selection:text-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[60] btn-primary px-3 py-1.5 text-sm"
    >
      Skip to main content
    </a>
    <slot />
    <div id="copy-live-region" class="sr-only" aria-live="polite"></div>
    <script>
      const liveRegion = document.getElementById('copy-live-region');
      const copyTimers = new WeakMap<HTMLButtonElement, number>();
      document.querySelectorAll<HTMLButtonElement>('.copy-snippet-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const text = btn.getAttribute('data-copy') || '';
          if (!text) return;
          if (!btn.dataset.origText) {
            btn.dataset.origText = btn.textContent?.trim() || 'Copy';
          }
          const prevTimer = copyTimers.get(btn);
          if (prevTimer !== undefined) {
            window.clearTimeout(prevTimer);
          }
          let copied: boolean;
          try {
            if (!navigator.clipboard || !navigator.clipboard.writeText) {
              throw new Error('Clipboard API unavailable');
            }
            await navigator.clipboard.writeText(text);
            copied = true;
          } catch {
            copied = false;
          }
          btn.textContent = copied ? 'Copied!' : 'Copy failed';
          if (liveRegion) {
            liveRegion.textContent = copied
              ? 'Copied code snippet to clipboard.'
              : 'Could not copy snippet automatically. Select and copy manually.';
          }
          const timerId = window.setTimeout(() => {
            btn.textContent = btn.dataset.origText || 'Copy';
            copyTimers.delete(btn);
          }, 1500);
          copyTimers.set(btn, timerId);
        });
      });
    </script>
  </body>
</html>
