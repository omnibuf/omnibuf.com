---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const installCommands = `# Homebrew (macOS & Linux)
brew install omnibuf/tap/omnibuf

# mise
mise use -g github:omnibuf/omnibuf-cli

# Shell script
curl -fsSL https://omnibuf.com/install.sh | sh

# Go
go install github.com/omnibuf/omnibuf-cli/cmd/omnibuf@latest`;

const jqFilterSnippet = `# Pretty-print any OmniBuf packet as JSON
omnibuf packet.obuf

# Extract a nested field as a raw string (-r)
omnibuf -r '.location.city' packet.obuf

# Filter array elements and emit compact JSON (-c)
omnibuf -c '.neighbors[] | select(.established) | .router' packet.obuf`;

const encodeSnippet = `# Pipe JSON directly into omnibuf to produce self-describing wire bytes (Field #0)
echo '{"event": {"int": 10, "city": "FRA"}}' | omnibuf > event.obuf

# Round-trip back to JSON or query a field in one pipeline
echo '{"event": {"int": 10, "city": "FRA"}}' | omnibuf | omnibuf '.event.city'

# Encode or decode against a compiled Protobuf FileDescriptorSet (.pb, .pb.gz, .json)
omnibuf encode --schema descriptors.pb --type demo.v1.PeerUpdate input.json > packet.obuf
omnibuf decode --schema descriptors.pb --type demo.v1.PeerUpdate packet.obuf`;

const vscodeInstallSnippet = `code --install-extension omnibuf.omnibuf-vscode`;

const neovimInstallSnippet = `-- lazy.nvim
{ "omnibuf/omnibuf-vim" }

-- vim-plug
Plug 'omnibuf/omnibuf-vim'`;

const tryIn30SecondsSnippet = `curl -fsSLO https://omnibuf.com/sample.pcapng
curl -fsSLO https://raw.githubusercontent.com/omnibuf/omnibuf-wireshark/main/omnibuf.lua
curl -fsSLO https://raw.githubusercontent.com/omnibuf/omnibuf-wireshark/main/omnibuf_wire.lua
tshark -X lua_script:omnibuf.lua -r sample.pcapng -Y omnibuf -V`;

const mitmproxySnippet = `# Run directly as a single script
mitmproxy -s omnibuf_mitmproxy.py

# Or install the Python package
uv pip install mitmproxy-omnibuf

# Optional: generate a Protobuf FileDescriptorSet JSON and overlay field/enum names
buf build -o schema.json
mitmweb -s omnibuf_mitmproxy.py --set omnibuf_schema=schema.json`;

const wiresharkInstallSnippet = `# macOS & Linux (installs into ~/.local/lib/wireshark/plugins)
curl -fsSL https://raw.githubusercontent.com/omnibuf/omnibuf-wireshark/main/install.sh | sh

# Zero-install one-off run with tshark (optional schema overlay via buf build -o schema.json)
tshark -X lua_script:omnibuf.lua -o omnibuf.schema_path:schema.json -r sample.pcapng -Y omnibuf -V

# Pipe tshark JSON directly into jq
tshark -X lua_script:omnibuf.lua -r sample.pcapng -Y omnibuf -T json --no-duplicate-keys \\
  | jq '.[]._source.layers.omnibuf'`;
---

<Layout
  title="OmniBuf Tooling | CLI, Traffic Inspection & Editor Extensions"
  description="OmniBuf CLI, traffic inspection plugins for Wireshark, tshark, termshark, mitmproxy, and Browser DevTools, plus editor extensions for VS Code and Neovim."
>
  <Navbar currentPage="tooling" />

  <main id="main-content">
    <!-- Header -->
    <section class="pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-4">
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-none text-ink uppercase">
        Tooling
      </h1>
      <p class="text-base sm:text-xl text-ink/85 leading-relaxed max-w-[62ch]">
        Editor extensions, command-line utilities, and network dissectors for inspecting and editing
        OmniBuf traffic and <code>.obuf</code> files.
      </p>
      <div class="flex flex-wrap gap-3 font-mono text-xs sm:text-sm pt-1 no-print">
        <a href="#editor-extensions" class="os-btn px-4 py-2 bg-acid text-ink font-bold rounded-md">
          Editor extensions &darr;
        </a>
        <a href="#cli" class="os-btn px-4 py-2 bg-[#FAF8F2] text-ink font-bold rounded-md">
          CLI &darr;
        </a>
        <a
