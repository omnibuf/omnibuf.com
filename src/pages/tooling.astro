---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const installCommands = `# Homebrew (macOS & Linux)
brew install omnibuf/tap/omnibuf

# mise
mise use -g github:omnibuf/omnibuf-cli

# Shell script
curl -fsSL https://omnibuf.com/install.sh | sh

# Go
go install github.com/omnibuf/omnibuf-cli/cmd/omnibuf@latest`;

const jqFilterSnippet = `# Pretty-print any OmniBuf packet as JSON
omnibuf packet.obuf

# Extract a nested field as a raw string (-r)
omnibuf -r '.location.city' packet.obuf

# Filter array elements and emit compact JSON (-c)
omnibuf -c '.neighbors[] | select(.established) | .router' packet.obuf`;

const encodeSnippet = `# Pipe JSON directly into omnibuf to produce self-describing wire bytes (Field #0)
echo '{"event": {"int": 10, "city": "FRA"}}' | omnibuf > event.obuf

# Round-trip back to JSON or query a field in one pipeline
echo '{"event": {"int": 10, "city": "FRA"}}' | omnibuf | omnibuf '.event.city'

# Encode or decode against a compiled Protobuf FileDescriptorSet (.pb, .pb.gz, .json)
omnibuf encode --schema descriptors.pb --type demo.v1.PeerUpdate input.json > packet.obuf
omnibuf decode --schema descriptors.pb --type demo.v1.PeerUpdate packet.obuf`;

const vscodeInstallSnippet = `code --install-extension omnibuf.omnibuf-vscode`;

const neovimInstallSnippet = `-- lazy.nvim
{ "omnibuf/omnibuf-vim" }

-- vim-plug
Plug 'omnibuf/omnibuf-vim'`;
---

<Layout
  title="OmniBuf Tooling | CLI & Editor Extensions"
  description="OmniBuf CLI and editor extensions for Visual Studio Code and Neovim / Vim."
>
  <Navbar currentPage="tooling" />

  <main id="main-content">
    <!-- Header -->
    <section class="pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-4">
      <h1 class="text-4xl sm:text-6xl font-bold tracking-tight leading-none text-ink uppercase">
        Tooling
      </h1>
      <p class="text-base sm:text-xl text-ink/85 leading-relaxed max-w-[62ch]">
        Command-line tool and editor extensions for inspecting, querying, and editing{' '}
        <code>.obuf</code> files.
      </p>
      <div class="flex flex-wrap gap-3 font-mono text-xs sm:text-sm pt-1 no-print">
        <a href="#cli" class="os-btn px-4 py-2 bg-acid text-ink font-bold rounded-md">
          CLI &darr;
        </a>
        <a
          href="#editor-extensions"
          class="os-btn px-4 py-2 bg-[#FAF8F2] text-ink font-bold rounded-md"
        >
          Editor extensions &darr;
        </a>
      </div>
    </section>

    <!-- CLI -->
    <section
      id="cli"
      class="scroll-mt-16 py-10 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto border-t-2 border-ink space-y-10"
    >
      <div class="space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">CLI</h2>
          <div class="flex flex-wrap gap-2.5 font-mono text-xs sm:text-sm no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-cli"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-3.5 py-1.5 bg-acid text-ink font-bold rounded-md"
            >
              GitHub &rarr;
            </a>
            <a
              href="https://github.com/omnibuf/omnibuf-cli/releases"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-3.5 py-1.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              Releases &rarr;
            </a>
          </div>
        </div>

        <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111] [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
          <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
            <div class="text-xs font-bold uppercase text-acid">Install omnibuf</div>
            <button
              type="button"
              data-copy="brew install omnibuf/tap/omnibuf"
              class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
            >
              Copy brew
            </button>
          </div>
          <Code code={installCommands} lang="sh" theme="github-dark" />
        </div>
      </div>

      <!-- 1. Schema-less inspection -->
      <div id="inspect-without-schema" class="scroll-mt-16 pt-8 border-t border-ink/20 space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink">
          Schema-less inspection
        </h3>
        <!-- prettier-ignore -->
        <p class="text-base text-ink/90 leading-relaxed">
          Protobuf collapses strings, byte slices, sub-messages, maps, and packed arrays into one wire type, and shares a single varint wire type across booleans, signed integers, and unsigned integers. Inspecting a raw Protobuf packet with <a href="https://github.com/protocolbuffers/protoscope" target="_blank" rel="noopener noreferrer" class="doc-link"><code>protoscope</code></a> leaves you guessing what each field means. OmniBuf carries an explicit 4-bit wire type on every field, plus element types on arrays and maps. Running <code>omnibuf</code> prints the exact booleans, signed numbers, UTF-8 strings, arrays, and maps on the wire. Packets encoded with <strong>Field #0</strong> also decode with their original field names.
        </p>
        <div class="os-window overflow-hidden font-mono text-xs sm:text-sm">
          <div class="os-titlebar bg-[#E5E0D5]">
            <span class="font-bold uppercase text-ink text-xs">protoscope vs. omnibuf cli</span>
            <div class="os-stripes"></div>
          </div>
          <div class="bg-ink text-paper p-4 space-y-3">
            <div class="bg-[#1F1F1F] p-3 rounded border border-paper/15">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <span class="text-xs font-bold text-[#FF4F18]">$ protoscope packet.pb</span>
                <span class="text-[11px] text-paper/55">Protobuf &middot; guesses types</span>
              </div>
              <pre class="leading-relaxed overflow-x-auto"><code><span class="text-[#FF4F18] font-bold">1:</span> 1          <span class="text-paper/55"># bool / uint / sint / enum?</span>
<span class="text-[#FF4F18] font-bold">2:</span> 3          <span class="text-paper/55"># +3 uint or -2 sint?</span>
<span class="text-[#FF4F18] font-bold">3:</span> &#123;<span class="text-acid">"FRA"</span>&#125;    <span class="text-paper/55"># string / bytes / sub-msg?</span>
<span class="text-[#FF4F18] font-bold">4:</span> <span class="text-acid">"\x0a\x14"</span> <span class="text-paper/55"># bytes / string / packed array?</span></code></pre>
            </div>
            <div class="bg-[#1F1F1F] p-3 rounded border border-paper/25">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <span class="text-xs font-bold text-acid">$ omnibuf -c packet.obuf</span>
                <span class="text-[11px] text-paper/65">OmniBuf &middot; actual values</span>
              </div>
              <pre class="leading-relaxed overflow-x-auto"><code>&#123;<span class="text-acid font-bold">"field_1"</span>: <span class="text-[#FF4F18] font-bold">true</span>, <span class="text-acid font-bold">"field_2"</span>: -2, <span class="text-acid font-bold">"field_3"</span>: <span class="text-acid">"FRA"</span>, <span class="text-acid font-bold">"field_4"</span>: [10, 20]&#125;</code></pre>
            </div>
            <div class="bg-[#1F1F1F] p-3 rounded border border-acid/45">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5">
                <span class="text-xs font-bold text-acid">$ omnibuf -c packet-field0.obuf</span>
                <span class="text-[11px] text-acid/85">
                  OmniBuf + Field #0 &middot; actual values &amp; names
                </span>
              </div>
              <pre class="leading-relaxed overflow-x-auto"><code>&#123;<span class="text-acid font-bold">"active"</span>: <span class="text-[#FF4F18] font-bold">true</span>, <span class="text-acid font-bold">"delta"</span>: -2, <span class="text-acid font-bold">"city"</span>: <span class="text-acid">"FRA"</span>, <span class="text-acid font-bold">"peers"</span>: [10, 20]&#125;</code></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. jq queries -->
      <div id="jq-queries" class="scroll-mt-16 pt-8 border-t border-ink/20 space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink">jq queries</h3>
        <p class="text-base text-ink/90 leading-relaxed">
          Pass a <code>jq</code> filter expression as the first argument (or via <code>-q</code> /{' '}
          <code>--query</code> or <code>-f</code> / <code>--filter</code>) to slice, select, or
          reshape decoded fields in a single command. Flags such as <code>-r</code> (raw string
          output) and <code>-c</code> (compact single-line JSON) work the same way as{' '}
          <code>jq</code>. Hex (<code>-x</code>), base64 (<code>-b</code>), and explicit file paths
          (<code>-i</code> / <code>--input</code> and <code>-o</code> / <code>--output</code>) are
          supported directly.
        </p>
        <div class="os-window overflow-hidden font-mono text-xs sm:text-sm">
          <div class="os-titlebar bg-[#E5E0D5]">
            <span class="font-bold uppercase text-ink text-xs">jq filter expressions</span>
            <div class="os-stripes"></div>
          </div>
          <div class="bg-ink text-paper p-4 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed [&>pre]:overflow-x-auto">
            <Code code={jqFilterSnippet} lang="sh" theme="github-dark" />
          </div>
        </div>
      </div>

      <!-- 3. JSON conversion -->
      <div id="encode-json" class="scroll-mt-16 pt-8 border-t border-ink/20 space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink">
          JSON conversion
        </h3>
        <p class="text-base text-ink/90 leading-relaxed">
          <code>omnibuf</code> auto-detects whether its input is JSON or OmniBuf wire bytes (pass{' '}
          <code>-e</code> / <code>--encode</code> or <code>-d</code> / <code>--decode</code> to
          force a direction). Piping a JSON object into <code>omnibuf</code> encodes it into a
          self-describing OmniBuf packet with <code>Field #0</code> field names, preserving the JSON
          object's key order for sequential tags. Supplying <code>--schema</code> (<code>-s</code>)
          with a compiled <code>FileDescriptorSet</code> encodes or decodes against your{' '}
          <code>.proto</code> definitions, with <code>--field0</code> (alias{' '}
          <code>--self-describing</code>) to embed inline field names and{' '}
          <code>--max-schema-bytes</code> (default 64 MiB) to cap descriptor file and decompressed
          size.
        </p>
        <div class="os-window overflow-hidden font-mono text-xs sm:text-sm">
          <div class="os-titlebar bg-[#E5E0D5]">
            <span class="font-bold uppercase text-ink text-xs">json &harr; omnibuf</span>
            <div class="os-stripes"></div>
          </div>
          <div class="bg-ink text-paper p-4 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed [&>pre]:overflow-x-auto">
            <Code code={encodeSnippet} lang="sh" theme="github-dark" />
          </div>
        </div>
      </div>

      <!-- 4. Schemaless type mapping -->
      <div id="json-type-mapping" class="scroll-mt-16 pt-8 border-t border-ink/20 space-y-4">
        <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink">
          Schemaless type mapping
        </h3>
        <p class="text-base text-ink/90 leading-relaxed">
          Converting JSON without <code>--schema</code> requires a top-level JSON object.{' '}
          <code>omnibuf</code> infers each wire type from the JSON literal and assigns sequential
          field numbers starting at <code>1</code> (keys named <code>field_&lt;N&gt;</code> reserve
          field number <code>N</code> directly). Pass <code>--deterministic</code> to sort keys
          lexicographically before numbering, or <code>--no-field0</code> to omit inline field
          names. Pass <code>--schema descriptors.pb --type pkg.Msg</code> for exact{' '}
          <code>.proto</code> field numbers, 32-bit floats, fixed-width integers, enums, and maps.
        </p>
        <div class="os-window overflow-hidden">
          <div class="os-titlebar bg-[#E5E0D5]">
            <span class="font-bold uppercase text-ink text-xs font-mono">
              json literal &rarr; omnibuf wire type (no --schema)
            </span>
            <div class="os-stripes"></div>
          </div>
          <div class="overflow-x-auto bg-[#FAF8F2]">
            <table class="w-full text-left border-collapse font-mono text-xs sm:text-sm">
              <thead>
                <tr class="border-b-2 border-ink bg-[#E5E0D5]/70 text-ink uppercase text-[11px]">
                  <th class="py-2.5 px-3 font-bold">JSON Value</th>
                  <th class="py-2.5 px-3 font-bold">OmniBuf Wire Type</th>
                  <th class="py-2.5 px-3 font-bold">Protobuf Equiv.</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-ink/15 text-ink">
                <tr>
                  <td class="py-2.5 px-3">
                    <code>true</code> / <code>false</code>
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireBoolTrue</code> (3) / <code>WireBoolFalse</code> (2)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>bool</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    Non-negative integer (<code>0..2^64-1</code>)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireUint</code> (0)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>uint32</code> / <code>uint64</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    Negative integer (<code>-2^63..-1</code>)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireSint</code> (1, ZigZag)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>sint32</code> / <code>sint64</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    Decimal, exponent (<code>.</code>/<code>e</code>), or &gt;64-bit
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireFloat64</code> (9, 8B LE)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>double</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    String (<code>"FRA"</code>)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireString</code> (10, UTF-8)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>string</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    <code>"base64:..."</code> (valid std base64)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireBytes</code> (11, raw bytes)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>bytes</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    Nested object (<code>&#123;...&#125;</code>)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireSubMsg</code> (12)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>message</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    Homogeneous array (<code>[...]</code>)
                  </td>
                  <td class="py-2.5 px-3">
                    <code>WireArray</code> (13)
                    <div class="text-[11px] font-sans text-ink/70 mt-0.5">
                      Numbers widen across elements: <code>WireUint</code> &rarr;{' '}
                      <code>WireSint</code> &rarr; <code>WireFloat64</code>. All-base64 string
                      arrays encode as <code>WireBytes</code>. Objects share one field table. Nested
                      arrays and empty arrays are supported; mixed incompatible types fail and{' '}
                      <code>null</code> elements are omitted.
                    </div>
                  </td>
                  <td class="py-2.5 px-3">
                    <code>repeated T</code>
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3">
                    <code>null</code>
                  </td>
                  <td class="py-2.5 px-3">Omitted (absent field)</td>
                  <td class="py-2.5 px-3">unset field</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <!-- Editor extensions -->
    <section
      id="editor-extensions"
      class="scroll-mt-16 py-10 sm:py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto border-t-2 border-ink space-y-6"
    >
      <div class="space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight text-ink">
          Editor extensions
        </h2>
        <p class="text-base text-ink/85 leading-relaxed">
          Both extensions require the <code>omnibuf</code> CLI on your <code>PATH</code>. Opening a{' '}
          <code>.obuf</code> file decodes it to JSON and saving re-encodes valid JSON back to wire
          bytes.
        </p>
      </div>

      <!-- VS Code -->
      <div id="vscode" class="scroll-mt-16 os-window overflow-hidden">
        <div class="os-titlebar bg-[#E5E0D5]">
          <span class="font-bold uppercase text-ink text-xs font-mono">
            Visual Studio Code &middot; omnibuf.omnibuf-vscode
          </span>
          <div class="os-stripes"></div>
        </div>
        <div class="p-5 sm:p-6 bg-[#FAF8F2] space-y-4">
          <div class="flex items-center gap-3.5">
            <svg
              aria-hidden="true"
              viewBox="0 0 100 100"
              class="w-9 h-9 shrink-0"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M95.5 20.4L74.8 10.4C72.5 9.3 69.8 9.8 68 11.6L32.1 44.3L16.3 32.3C14.7 31.1 12.5 31.2 11 32.5L4.5 38.4C2.5 40.2 2.5 43.3 4.5 45.1L16.2 50L4.5 54.9C2.5 56.7 2.5 59.8 4.5 61.6L11 67.5C12.5 68.8 14.7 68.9 16.3 67.7L32.1 55.7L68 88.4C69.8 90.2 72.5 90.7 74.8 89.6L95.5 79.6C97.6 78.6 99 76.5 99 74.1V25.9C99 23.5 97.6 21.4 95.5 20.4Z"
                fill="#0065A9"
              />
              <path
                d="M95.5 20.4L74.8 10.4C72.5 9.3 69.8 9.8 68 11.6L11 67.5C12.5 68.8 14.7 68.9 16.3 67.7L95.5 20.4Z"
                fill="#007ACC"
              />
              <path
                d="M95.5 79.6L74.8 89.6C72.5 90.7 69.8 90.2 68 88.4L11 32.5C12.5 31.2 14.7 31.1 16.3 32.3L95.5 79.6Z"
                fill="#1F9CF0"
              />
              <path
                d="M74.8 89.6C72.5 90.7 69.8 90.2 68 88.4V11.6C69.8 9.8 72.5 9.3 74.8 10.4L95.5 20.4C97.6 21.4 99 23.5 99 25.9V74.1C99 76.5 97.6 78.6 95.5 79.6L74.8 89.6Z"
                fill="#1F9CF0"
              />
              <path d="M74 30.8L48.5 50L74 69.2V30.8Z" fill="#FAF8F2" />
            </svg>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
              Visual Studio Code
            </h3>
          </div>

          <p class="text-sm sm:text-base text-ink/85 leading-relaxed">
            Custom editor for <code>*.obuf</code> files with syntax-highlighted JSON editing, Split
            and 16-byte Hex views, live reload on disk changes, and optional{' '}
            <code>FileDescriptorSet</code> schema settings. Invalid JSON blocks save so the
            underlying binary file stays intact.
          </p>

          <div class="p-3.5 bg-ink text-paper rounded font-mono text-xs sm:text-sm overflow-x-auto border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
            <Code code={vscodeInstallSnippet} lang="sh" theme="github-dark" />
          </div>

          <div class="flex flex-wrap gap-3 font-mono text-xs sm:text-sm pt-1 no-print">
            <a
              href="https://marketplace.visualstudio.com/items?itemName=omnibuf.omnibuf-vscode"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2 bg-acid text-ink font-bold rounded-md"
            >
              VS Code Marketplace &rarr;
            </a>
            <a
              href="https://open-vsx.org/extension/omnibuf/omnibuf-vscode"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              Open VSX &rarr;
            </a>
            <a
              href="https://github.com/omnibuf/omnibuf-vscode"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              GitHub &rarr;
            </a>
          </div>
        </div>
      </div>

      <!-- Neovim / Vim -->
      <div id="neovim" class="scroll-mt-16 os-window overflow-hidden">
        <div class="os-titlebar bg-[#E5E0D5]">
          <span class="font-bold uppercase text-ink text-xs font-mono">
            Neovim &amp; Vim &middot; omnibuf/omnibuf-vim
          </span>
          <div class="os-stripes"></div>
        </div>
        <div class="p-5 sm:p-6 bg-[#FAF8F2] space-y-4">
          <div class="flex items-center gap-3.5">
            <svg
              aria-hidden="true"
              viewBox="0 0 100 100"
              class="w-9 h-9 shrink-0"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M16 20.5L34.5 4V96L16 77.5V20.5Z" fill="#54A2E0" />
              <path d="M84 22.5L65.5 4V96L84 79.5V22.5Z" fill="#57A143" />
              <path d="M34.5 4L84 79.5L65.5 96L16 20.5L34.5 4Z" fill="#46993A" />
              <path d="M34.5 42.5L16 20.5L34.5 4V42.5Z" fill="#2E7D32" fill-opacity="0.35" />
