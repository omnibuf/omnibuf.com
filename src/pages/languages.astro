---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import LanguageIcon from '../components/LanguageIcon.astro';
import { languages } from '../data/languages';
---

<Layout
  title="Languages | OmniBuf Runtimes & Code Generators"
  description="OmniBuf implementations across 12 languages: Go, TypeScript, Rust, Python, C++20, C99, Java, C#, Swift, Dart, PHP, and Elixir, verified against a shared 992-case conformance suite."
>
  <Navbar currentPage="languages" />

  <main id="main-content">
    <section class="pt-8 pb-8 sm:pt-10 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto space-y-3">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        Language implementations
      </h1>
      <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[64ch]">
        All {languages.length} runtimes implement the same{' '}
        <a href="/spec" class="doc-link">
          v1 DRAFT-1 wire format
        </a>{' '}
        and pass the same 992-case conformance suite. Packets encoded in one language decode
        identically in any other.
      </p>
    </section>

    <section class="pb-14 sm:pb-20 px-4 sm:px-6 max-w-6xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {languages.map((lang) => (
          <a
            href={lang.href}
            class="group bg-[#FAF8F2] border border-ink/15 hover:border-ink/40 rounded-lg p-5 flex flex-col justify-between gap-4 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-3">
                <div class="flex items-center gap-3.5 min-w-0">
                  <LanguageIcon lang={lang.key} class="w-10 h-10 shrink-0" />
                  <h2 class="text-base sm:text-lg font-bold tracking-tight text-ink group-hover:text-accent transition-colors truncate">
                    {lang.label}
                  </h2>
                </div>
                <span
                  class="text-sm text-ink/60 group-hover:text-accent transition-colors shrink-0"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </div>
              <p class="text-sm text-ink/80 leading-relaxed">{lang.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
