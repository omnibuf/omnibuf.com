---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import RpcIntegration from '../components/RpcIntegration.astro';

const pyRpcCode = `# grpcio (omnibuf.grpc)
import grpc
from omnibuf.grpc import grpc_deserializer, grpc_serializer

handler = grpc.unary_unary_rpc_method_handler(
    serve_ping,
    request_deserializer=grpc_deserializer(PingRequest),
    response_serializer=grpc_serializer(),
)

# connect-python (omnibuf.connect)
from omnibuf.connect import OmniBufConnectCodec
codec = OmniBufConnectCodec()`;
import { defaultTypeMappings } from '../data/typeMappings';

const protobufPySnippet = `import omnibuf
from app.gen import peer_pb

msg = peer_pb.PeerUpdate(
    asn=64512,
    router_id="edge-rtr-fra01",
    active=True,
    rssi_dbm=-62,
    location=peer_pb.Location(city="Frankfurt", rack=42),
)

pkt = omnibuf.marshal(msg)
out = omnibuf.unmarshal(pkt, peer_pb.PeerUpdate)`;

const dataclassPySnippet = `import omnibuf
from omnibuf import Float32, Sint32, Uint32, omnibuf_field, omnibuf_message

@omnibuf_message("PeerSummary")
class PeerSummary:
    asn: Uint32 = omnibuf_field(1, default=0)
    router_id: str = omnibuf_field(2, default="")
    rssi_dbm: Sint32 = omnibuf_field(5, default=0)
    load: Float32 = omnibuf_field(6, default=0.0)

pkt = omnibuf.marshal(PeerSummary(asn=64512, router_id="rtr-01", rssi_dbm=-62))
out = omnibuf.unmarshal(pkt, PeerSummary)`;

const bufGenPySnippet = `version: v2
plugins:
  - local: ["uv", "run", "--no-sync", "protoc-gen-py"]
    out: src/gen
  - local: ["uv", "run", "--no-sync", "protoc-gen-omnibuf-py"]
    out: src/gen`;

const generatedPySnippet = `from app.gen import peer_omnibuf_pb

view = peer_omnibuf_pb.OpaquePeerUpdate(pkt)
loc = view.opaque_location()
if loc is not None and loc.get_city() == "Frankfurt":
    view.set_sequence(9_876_543_211)
    forwarded = view.marshal()`;

const blindPyCode = `import omnibuf

pkt = omnibuf.marshal(msg, self_describing=True)
fields = omnibuf.decode_blind(pkt)`;

const pyFaqItems = [
  {
    id: 'py-faq-speed',
    question: 'How does omnibuf compare against upb, protobuf-py, and msgspec under the hood?',
    paragraphs: [
      '<code>omnibuf</code> ships a compiled Rust extension atop <code>omnibuf-rs</code>. It reads and populates Python object slots directly from native code, encoding ahead of Google&apos;s C <code>upb</code> backend, C <code>msgspec</code>, and <code>protobuf-py</code>, and decoding full messages over 2x faster than <code>upb</code>. Lazy <code>Opaque</code> views read nested fields and splice single-field mutations nearly 2x faster than <code>upb</code>.',
    ],
  },
  {
    id: 'py-faq-pb2',
    question: 'Does omnibuf support legacy google.protobuf _pb2 modules too?',
    paragraphs: [
      '<code>protobuf-py</code> (<code>_pb.py</code> classes generated by <code>protoc-gen-py</code>) is the primary Python Protobuf integration. Existing codebases that still import <code>google.protobuf</code> <code>_pb2.py</code> classes can pass those messages straight to <code>omnibuf.marshal</code> and <code>omnibuf.unmarshal</code> as well.',
    ],
  },
  {
    id: 'py-faq-blind',
    question: 'How does schema-less inspection handle Field #0?',
    paragraphs: [
      '<code>omnibuf.decode_blind(pkt)</code> returns a <code>dict</code> with synthetic <code>field_1</code>, <code>field_2</code>, ... keys on compact packets, or resolves nested field names automatically when <code>self_describing=True</code> embedded Field #0.',
    ],
    codeBlock: blindPyCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const pyFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pyFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Python: Rust Core, Dataclasses & Protobuf"
  description="Use OmniBuf in Python 3.11+ with a compiled Rust PyO3 core: serialize protobuf-py messages, annotate dataclasses, or generate slotted codecs."
>
  <Navbar currentPage="py" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        OmniBuf <span class="text-[#FF4F18]">for Python</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
            Ships prebuilt native wheels for Python 3.11+ with full static type annotations. Encode
            and decode{' '}
            <a href="#protobuf-py" class="doc-link">
              Protobuf messages
            </a>
            ,{' '}
            <a href="#dataclasses" class="doc-link">
              typed dataclasses
            </a>
            , or{' '}
            <a href="#plugin-codegen" class="doc-link">
              Buf-generated slotted classes
            </a>
            , complete with lazy views over raw byte buffers and schema-less dictionary decoding.
          </p>
          <div class="flex flex-wrap gap-2.5 text-sm pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-py"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-4 py-2"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://pypi.org/project/omnibuf/"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary px-4 py-2"
            >
              PyPI Package &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
              <div class="text-xs font-medium text-paper/70">Install with uv</div>
              <button
                type="button"
                data-copy="uv add omnibuf protobuf-py protobuf-py-ext"
                class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>uv add omnibuf protobuf-py protobuf-py-ext</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Three ways to use OmniBuf in Python.
        </h2>
        <p class="mt-2 text-base sm:text-lg text-ink/75">
          All three produce identical wire bytes and include full static type hints.
        </p>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        <div
          id="protobuf-py"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Native protobuf-py messages
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Buf&apos;s{' '}
              <a
                href="https://github.com/bufbuild/protobuf-py"
                target="_blank"
                rel="noopener noreferrer"
                class="doc-link"
              >
                <code>protobuf-py</code>
              </a>{' '}
              generates clean typed Python classes (<code>_pb.py</code>) via{' '}
              <code>protoc-gen-py</code>. <code>omnibuf.marshal</code> and{' '}
              <code>omnibuf.unmarshal</code> compile a cached field plan from each{' '}
              <code>DescMessage</code> descriptor on first use.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">protobuf-py Integration</div>
                <button
                  type="button"
                  data-copy={protobufPySnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufPySnippet} lang="python" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="dataclasses"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Annotated Python dataclasses
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>@omnibuf_message</code> and <code>omnibuf_field</code> map standard Python type
              hints directly onto OmniBuf wire tags. Explicit width aliases (<code>Uint32</code>,{' '}
              <code>Sint32</code>, <code>Fixed64</code>, <code>Float32</code>) keep mypy and Pyright
              happy while pinning exact wire semantics.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">@omnibuf_message Dataclass</div>
                <button
                  type="button"
                  data-copy={dataclassPySnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={dataclassPySnippet} lang="python" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.py} />
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Generated code with protoc-gen-omnibuf-py
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Pairing <code>protoc-gen-py</code> and <code>protoc-gen-omnibuf-py</code> inside{' '}
              <code>buf.gen.yaml</code> emits slotted dataclasses alongside{' '}
              <code>Opaque&lt;Message&gt;</code> wrappers. Routing services can check a nested
              header or patch a sequence counter straight inside a <code>bytes</code> or{' '}
              <code>memoryview</code> buffer.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenPySnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenPySnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Generate with Buf</div>
                <button
                  type="button"
                  data-copy="uv add --dev protoc-gen-py && buf generate"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>uv add --dev protoc-gen-py
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Lazy Opaque Lookup &amp; Splice</div>
                <button
                  type="button"
                  data-copy={generatedPySnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedPySnippet} lang="python" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <RpcIntegration
      heading="gRPC & Connect"
      accent="in Python."
      summary="Separate modules <code>omnibuf.grpc</code> and <code>omnibuf.connect</code> integrate with <code>grpcio</code> and <code>connect-python</code> without pulling either framework into core <code>omnibuf</code>."
      code={pyRpcCode}
      lang="python"
      codeLabel="omnibuf.grpc & omnibuf.connect"
    />

    <section
      id="py-faq"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">Python questions.</h2>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        {pyFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-lg sm:text-xl font-bold tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-lg border border-ink/15 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                    <div class="text-xs font-medium text-paper/70">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="python" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(pyFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="py" />
  </main>

  <Footer />
</Layout>
