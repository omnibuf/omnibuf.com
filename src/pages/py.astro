---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Benchmarks from '../components/Benchmarks.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import Footer from '../components/Footer.astro';

const protobufPySnippet = `import omnibuf
from app.gen import peer_pb

msg = peer_pb.PeerUpdate(
    asn=64512,
    router_id="edge-rtr-fra01",
    active=True,
    rssi_dbm=-62,
    location=peer_pb.Location(city="Frankfurt", rack=42),
)

pkt = omnibuf.marshal(msg)
out = omnibuf.unmarshal(pkt, peer_pb.PeerUpdate)`;

const dataclassPySnippet = `import omnibuf
from omnibuf import Float32, Sint32, Uint32, omnibuf_field, omnibuf_message

@omnibuf_message("PeerSummary")
class PeerSummary:
    asn: Uint32 = omnibuf_field(1, default=0)
    router_id: str = omnibuf_field(2, default="")
    rssi_dbm: Sint32 = omnibuf_field(5, default=0)
    load: Float32 = omnibuf_field(6, default=0.0)

pkt = omnibuf.marshal(PeerSummary(asn=64512, router_id="rtr-01", rssi_dbm=-62))
out = omnibuf.unmarshal(pkt, PeerSummary)`;

const bufGenPySnippet = `version: v2
plugins:
  - local: ["uv", "run", "--no-sync", "protoc-gen-py"]
    out: src/gen
  - local: ["uv", "run", "--no-sync", "protoc-gen-omnibuf-py"]
    out: src/gen`;

const generatedPySnippet = `from app.gen import peer_omnibuf_pb

view = peer_omnibuf_pb.OpaquePeerUpdate(pkt)
loc = view.opaque_location()
if loc is not None and loc.get_city() == "Frankfurt":
    view.set_sequence(9_876_543_211)
    forwarded = view.marshal()`;

const blindPyCode = `import omnibuf

pkt = omnibuf.marshal(msg, self_describing=True)
fields = omnibuf.decode_blind(pkt)`;

const pyFaqItems = [
  {
    id: 'py-faq-speed',
    question: 'Why are full encode and decode slower than protobuf-py and upb here?',
    paragraphs: [
      '<code>omnibuf</code> is currently 100% pure Python 3.11+ bytecode, whereas <code>protobuf-py</code> (<code>protobuf-py-ext</code> in Rust), <code>google.protobuf</code> (<code>upb</code> in C), <code>msgspec</code> (C), and stdlib <code>json</code> (<code>_json</code> in C) run compiled native extensions. Even in pure Python, <code>Opaque</code> single-field splicing avoids unpacking untouched fields and beats C <code>msgpack</code> and stdlib <code>json</code> on single-field updates.',
    ],
  },
  {
    id: 'py-faq-pb2',
    question: 'Does omnibuf support legacy google.protobuf _pb2 modules too?',
    paragraphs: [
      '<code>protobuf-py</code> (<code>_pb.py</code> classes generated by <code>protoc-gen-py</code>) is the primary Python Protobuf integration. Existing codebases that still import <code>google.protobuf</code> <code>_pb2.py</code> classes can pass those messages straight to <code>omnibuf.marshal</code> and <code>omnibuf.unmarshal</code> as well.',
    ],
  },
  {
    id: 'py-faq-blind',
    question: 'How does schema-less inspection handle Field #0?',
    paragraphs: [
      '<code>omnibuf.decode_blind(pkt)</code> returns a <code>dict</code> with synthetic <code>field_1</code>, <code>field_2</code>, ... keys on compact packets, or resolves nested field names automatically when <code>self_describing=True</code> embedded Field #0.',
    ],
    codeBlock: blindPyCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const pyFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: pyFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Python | protobuf-py, Dataclasses & protoc-gen-omnibuf-py"
  description="Use OmniBuf in Python 3.11+: serialize protobuf-py messages, annotate Python dataclasses, or generate slotted codecs and lazy Opaque views via buf."
>
  <Navbar currentPage="py" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for Python.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            Pass{' '}
            <a href="#protobuf-py" class="doc-link">
              <code>protobuf-py</code> messages
            </a>{' '}
            directly to <code>omnibuf.marshal</code>, decorate typed{' '}
            <a href="#dataclasses" class="doc-link">
              Python dataclasses
            </a>
            , or run{' '}
            <a href="#plugin-codegen" class="doc-link">
              <code>protoc-gen-omnibuf-py</code>
            </a>{' '}
            with <code>buf generate</code>. Pure-Python vs C/Rust extension numbers are{' '}
            <a href="#benchmarks" class="doc-link">
              below
            </a>
            .
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a href="#benchmarks" class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md">
              Python Benchmarks &rarr;
            </a>
            <a href="/spec" class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
              Wire Specification &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Install with uv</div>
              <button
                type="button"
                data-copy="uv add omnibuf protobuf-py protobuf-py-ext"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>uv add omnibuf protobuf-py protobuf-py-ext</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Three ways to use{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
            OmniBuf in Python.
          </span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          Strict <code>py.typed</code> annotations across Python 3.11+.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <div
          id="protobuf-py"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Native protobuf-py messages
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Buf&apos;s{' '}
              <a
                href="https://github.com/bufbuild/protobuf-py"
                target="_blank"
                rel="noopener noreferrer"
                class="doc-link"
              >
                <code>protobuf-py</code>
              </a>{' '}
              generates clean typed Python classes (<code>_pb.py</code>) via{' '}
              <code>protoc-gen-py</code>. <code>omnibuf.marshal</code> and{' '}
              <code>omnibuf.unmarshal</code> compile a cached field plan from each{' '}
              <code>DescMessage</code> descriptor on first use.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">protobuf-py Integration</div>
                <button
                  type="button"
                  data-copy={protobufPySnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufPySnippet} lang="python" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="dataclasses"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Annotated Python dataclasses
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>@omnibuf_message</code> and <code>omnibuf_field</code> map standard Python type
              hints directly onto OmniBuf wire tags. Explicit width aliases (<code>Uint32</code>,{' '}
              <code>Sint32</code>, <code>Fixed64</code>, <code>Float32</code>) keep mypy and Pyright
              happy while pinning exact wire semantics.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">@omnibuf_message Dataclass</div>
                <button
                  type="button"
                  data-copy={dataclassPySnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={dataclassPySnippet} lang="python" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated code with protoc-gen-omnibuf-py
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Pairing <code>protoc-gen-py</code> and <code>protoc-gen-omnibuf-py</code> inside{' '}
              <code>buf.gen.yaml</code> emits slotted dataclasses alongside{' '}
              <code>Opaque&lt;Message&gt;</code> wrappers. Routing services can check a nested
              header or patch a sequence counter straight inside a <code>bytes</code> or{' '}
              <code>memoryview</code> buffer.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenPySnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenPySnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">Generate with Buf</div>
                <button
                  type="button"
                  data-copy="uv add --dev protoc-gen-py && buf generate"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>uv add --dev protoc-gen-py
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Lazy Opaque Lookup &amp; Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedPySnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedPySnippet} lang="python" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <Benchmarks lang="py" />

    <section
      id="py-faq"
      class="scroll-mt-16 py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Python{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
        </h2>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        {pyFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-md border-2 border-ink font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                    <div class="text-xs font-bold uppercase text-acid">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="python" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(pyFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="py" />
  </main>

  <Footer />
</Layout>
