---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import RpcIntegration from '../components/RpcIntegration.astro';

const phpRpcCode = `use OmniBuf\\Grpc\\GrpcCodec;

// Inside a Grpc\\BaseStub subclass (zero runtime dependency on grpc/grpc)
$call = $this->_simpleRequest(
    '/acme.v1.Svc/Ping',
    $request,
    GrpcCodec::deserialize(PingResponse::class),
    GrpcCodec::callMetadata(),
    ['serializer' => static fn(object $m): string => GrpcCodec::serialize($m)],
);`;
import { defaultTypeMappings } from '../data/typeMappings';

const attributePhpSnippet = `<?php
use OmniBuf\\Attributes\\OmniBufField;
use OmniBuf\\Attributes\\OmniBufMessage;
use OmniBuf\\OmniBuf;

#[OmniBufMessage('Location')]
final class Location
{
    #[OmniBufField(3, 'string')]
    public string $city = '';

    #[OmniBufField(4, 'uint32')]
    public int $rack = 0;
}

$loc = new Location();
$loc->city = 'FRA';
$loc->rack = 42;

$bytes = OmniBuf::marshal($loc, deterministic: true);
$decoded = OmniBuf::unmarshal($bytes, Location::class);`;

const googleProtoPhpSnippet = `<?php
use OmniBuf\\OmniBuf;
use Omnibuf\\Bench\\PeerUpdate;

$bytes = OmniBuf::marshal($protoPeerUpdate, deterministic: true);
$decoded = OmniBuf::unmarshal($bytes, PeerUpdate::class);`;

const bufGenPhpSnippet = `version: v2
clean: true
plugins:
  - local: vendor/bin/protoc-gen-omnibuf-php
    out: gen`;

const generatedPhpSnippet = `<?php
use OmniBuf\\Generated\\Omnibuf\\Bench\\OpaquePeerUpdate;

$view = new OpaquePeerUpdate($packetBytes);
if ($view->opaqueLocation()?->getCity() === 'Frankfurt') {
    $view->setSequence($view->getSequence() + 1);
}
$updatedPacket = $view->marshal();`;

const blindPhpCode = `<?php
use OmniBuf\\OmniBuf;

$bytes = OmniBuf::marshal($loc, selfDescribing: true);
$json = OmniBuf::decodeBlindJson($bytes);`;

const phpFaqItems = [
  {
    id: 'php-faq-ext',
    question: 'Does omnibuf/omnibuf require a PECL or C extension?',
    paragraphs: [
      'No. Pure PHP 8.3+ (64-bit) works out of the box anywhere Composer runs, encoding around 19x faster than pure-PHP <code>google/protobuf</code>. An optional pure-Rust <code>ext-omnibuf</code> extension (<code>ext-php-rs</code>) is included in <code>ext/rust</code> and detected automatically when loaded, accelerating encode, decode, opaque views, splicing, and blind decode.',
    ],
  },
  {
    id: 'php-faq-plugin',
    question: 'How is protoc-gen-omnibuf-php installed?',
    paragraphs: [
      'Composer links <code>vendor/bin/protoc-gen-omnibuf-php</code> automatically on <code>composer require omnibuf/omnibuf</code>. Point <code>buf.gen.yaml</code> at that binary to generate typed classes and lazy <code>Opaque*</code> views.',
    ],
  },
  {
    id: 'php-faq-blind',
    question: 'How does OmniBuf::decodeBlind inspect schema-less packets?',
    paragraphs: [
      '<code>OmniBuf::decodeBlind($bytes)</code> and <code>OmniBuf::decodeBlindJson($bytes)</code> decode any OmniBuf packet straight from its wire types. Keys default to <code>field_1</code>, <code>field_2</code>, ... or resolve to Field #0 names when <code>selfDescribing: true</code> was passed on marshal.',
    ],
    codeBlock: blindPhpCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const phpFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: phpFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for PHP 8.3+ | #[OmniBufField] Attributes, google/protobuf & protoc-gen-omnibuf-php"
  description="Use OmniBuf in PHP 8.3+: annotate classes with PHP 8 attributes, encode google/protobuf messages, or generate typed classes and views."
>
  <Navbar currentPage="php" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        OmniBuf <span class="text-[#FF4F18]">for PHP</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
            Pure PHP 8.3+ library on Packagist with a bundled Composer plugin binary and an optional
            Rust-backed <code>ext-omnibuf</code> extension. Annotate{' '}
            <a href="#attributes" class="doc-link">
              plain PHP classes with attributes
            </a>
            , marshal existing{' '}
            <a href="#google-protobuf" class="doc-link">
              <code>google/protobuf</code> messages
            </a>
            , or{' '}
            <a href="#plugin-codegen" class="doc-link">
              generate typed classes and lazy Opaque views
            </a>
            .
          </p>
          <div class="flex flex-wrap gap-2.5 text-sm pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-php"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-4 py-2"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://packagist.org/packages/omnibuf/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary px-4 py-2"
            >
              Packagist Package &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0 space-y-3">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
              <div class="text-xs font-medium text-paper/70">Install via Composer</div>
              <button
                type="button"
                data-copy="composer require omnibuf/omnibuf"
                class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>composer require omnibuf/omnibuf</code></pre>
          </div>

          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
              <div class="text-xs font-medium text-paper/70">Optional: Prebuilt ext-omnibuf</div>
              <button
                type="button"
                data-copy="curl -fsSL https://raw.githubusercontent.com/omnibuf/omnibuf-php/main/scripts/install-ext.sh | sh"
                class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>curl -fsSL https://raw.githubusercontent.com/omnibuf/omnibuf-php/main/scripts/install-ext.sh | sh</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Three ways to use OmniBuf in PHP.
        </h2>
        <p class="mt-2 text-base sm:text-lg text-ink/75">
          All three emit identical v1 DRAFT-1 wire bytes on 64-bit PHP 8.3 and newer.
        </p>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        <div
          id="attributes"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              PHP 8 attribute-annotated classes
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Tag class properties with <code>#[OmniBufMessage]</code> and{' '}
              <code>#[OmniBufField]</code>. Metadata is cached per class on first use so repeated
              marshals skip reflection overhead.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">#[OmniBufField] Class</div>
                <button
                  type="button"
                  data-copy={attributePhpSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={attributePhpSnippet} lang="php" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.php} />
        </div>

        <div
          id="google-protobuf"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Existing google/protobuf messages
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>OmniBuf::marshal</code> and <code>OmniBuf::unmarshal</code> accept standard{' '}
              <code>Google\Protobuf\Internal\Message</code> objects directly via{' '}
              <code>DescriptorPool</code> with no extra code generator required.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">google/protobuf Bridge</div>
                <button
                  type="button"
                  data-copy={googleProtoPhpSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={googleProtoPhpSnippet} lang="php" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Generated classes with protoc-gen-omnibuf-php
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>vendor/bin/protoc-gen-omnibuf-php</code> emits typed PHP 8.3+ message classes
              and lazy <code>Opaque*</code> views that skip untouched fields in{' '}
              <code>O(fields)</code> time and splice modified bytes directly.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenPhpSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenPhpSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Lint &amp; Generate with Buf</div>
                <button
                  type="button"
                  data-copy="buf lint && buf generate"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>buf lint
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">
                  Lazy Opaque View &amp; Wire Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedPhpSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedPhpSnippet} lang="php" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <RpcIntegration
      heading="gRPC in PHP"
      accent="with Grpc\\BaseStub."
      summary="<code>OmniBuf\\Grpc\\GrpcCodec</code> provides serializer, deserializer, and <code>content-type</code> metadata helpers for <code>grpc/grpc</code> stubs with zero runtime dependency on <code>grpc/grpc</code>."
      code={phpRpcCode}
      lang="php"
      codeLabel="OmniBuf\\Grpc\\GrpcCodec"
    />

    <section
      id="php-faq"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">PHP questions.</h2>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        {phpFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-lg sm:text-xl font-bold tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-lg border border-ink/15 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                    <div class="text-xs font-medium text-paper/70">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="php" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(phpFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="php" />
  </main>

  <Footer />
</Layout>
