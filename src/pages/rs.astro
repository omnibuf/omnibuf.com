---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import { defaultTypeMappings } from '../data/typeMappings';

const cargoFeaturesSnippet = `# Default: derive + buffa + prost
omnibuf = "0.1"

# buffa + #[derive(OmniBuf)] only
omnibuf = { version = "0.1", default-features = false, features = ["derive", "buffa"] }

# Pure wire, opaque splicing & blind decode
omnibuf = { version = "0.1", default-features = false }`;

const deriveRustSnippet = `use omnibuf::{Message, OmniBuf};

#[derive(Debug, Default, PartialEq, OmniBuf)]
#[omnibuf(name = "PeerUpdate")]
pub struct PeerUpdate {
    #[omnibuf(id = 1, name = "asn")]
    pub asn: u32,
    #[omnibuf(id = 2, name = "router_id")]
    pub router_id: String,
    #[omnibuf(id = 3, name = "active")]
    pub active: bool,
    #[omnibuf(id = 5, name = "rssi_dbm", wire = "sint")]
    pub rssi_dbm: i32,
    #[omnibuf(id = 7, name = "tags")]
    pub tags: Vec<String>,
}

let pkt = peer.encode_omnibuf()?;
let out = PeerUpdate::from_omnibuf(&pkt)?;`;

const buffaBuildSnippet = `buffa_build::Config::new()
    .files(&["omnibuf/bench/peer.proto"])
    .includes(&["proto"])
    .generate_views(true)
    .generate_reflection(true)
    .message_attribute(".", "#[derive(::omnibuf::OmniBuf)]")
    .oneof_attribute(".", "#[derive(::omnibuf::OmniBuf)]")
    .compile()?;`;

const buffaUsageSnippet = `use omnibuf::{EncodeOptions, Message};
use omnibuf::buffa_codec::{decode_buffa, encode_buffa, encode_buffa_reflect};

// Co-derived #[derive(OmniBuf)] on buffa structs
let pkt = buffa_peer.encode_omnibuf()?;
let direct = buffa_pb::PeerUpdate::from_omnibuf(&pkt)?;

// Pre-compiled buffa crates via Reflectable vtables or DescriptorPool
let pkt = encode_buffa_reflect(&buffa_peer, EncodeOptions::default())?;
let pkt_pool = encode_buffa(&buffa_peer, &pool, EncodeOptions::default())?;
let reflected: buffa_pb::PeerUpdate = decode_buffa(&pkt, &pool)?;`;

const prostSnippet = `use omnibuf::{EncodeOptions, Message};
use omnibuf::prost_codec::{decode_prost, encode_prost};

// Co-derived #[derive(prost::Message, OmniBuf)] via prost_build::Config::type_attribute
let pkt = prost_peer.encode_omnibuf()?;
let direct = pb::PeerUpdate::from_omnibuf(&pkt)?;

// Pre-compiled prost + prost-reflect crates
let pkt = encode_prost(&prost_peer, EncodeOptions::default())?;
let mut reflected = pb::PeerUpdate::default();
decode_prost(&pkt, &mut reflected)?;`;

const bufGenRsSnippet = `version: v2
plugins:
  - local: protoc-gen-omnibuf-rs
    out: src/gen
    strategy: all`;

const generatedRsSnippet = `use crate::gen::omnibuf::bench::{OpaquePeerUpdate, PeerUpdate};
use omnibuf::Message;

let pkt = peer.encode_omnibuf()?;

let mut view = OpaquePeerUpdate::try_new(&pkt)?;
if view.get_active() {
    let city: &str = view.get_location().get_city();
    view.set_sequence(view.get_sequence() + 1);
    let updated: Vec<u8> = view.try_marshal()?;
}`;

const blindRsSnippet = `use std::collections::BTreeMap;
use omnibuf::{BlindValue, EncodeOptions, Message, decode_blind, decode_blind_json};

let pkt = peer.encode_omnibuf_with_options(EncodeOptions::self_describing())?;
let fields: BTreeMap<String, BlindValue> = decode_blind(&pkt)?;
let json: String = decode_blind_json(&pkt)?;`;

const rsFaqItems = [
  {
    id: 'rs-faq-buffa-views',
    question: "How do buffa *View<'a> types compare with OmniBuf Opaque<'a> views?",
    paragraphs: [
      "<code>buffa</code> generates <code>PeerUpdateView&lt;'a&gt;</code> structs that parse a Protobuf buffer in one upfront pass, populating borrowed <code>&amp;'a str</code> and <code>&amp;'a [u8]</code> slices across every field. <code>OpaquePeerUpdate&lt;'a&gt;</code> wraps the raw OmniBuf slice as a <code>Cow&lt;'a, [u8]&gt;</code> and defers decoding until individual getter calls, stepping over earlier length-prefixed containers in O(1) time per field.",
      "Pipelines that read most fields of an incoming Protobuf message benefit from <code>buffa</code>'s single-pass <code>*View&lt;'a&gt;</code> borrow. Routing planes and telemetry proxies that inspect one nested header or overwrite a single sequence counter skip full-struct materialization with <code>Opaque&lt;'a&gt;</code> and <code>splice_fields</code>.",
    ],
  },
  {
    id: 'rs-faq-buffa-vs-prost',
    question: 'What differs under the hood between buffa and prost integration?',
    paragraphs: [
      '<code>prost</code> encodes schema metadata inside <code>#[prost(...)]</code> field attributes, boxes recursive messages in <code>Option&lt;Box&lt;T&gt;&gt;</code>, and stores enums as bare <code>i32</code> values. <code>buffa</code> emits <code>/// Field N: `name`</code> doc attributes, wraps singular sub-messages in <code>buffa::MessageField&lt;T&gt;</code>, preserves unknown enum discriminants via <code>buffa::EnumValue&lt;E&gt;</code>, and exposes zero-allocation <code>Reflectable</code> vtables.',
      '<code>#[derive(OmniBuf)]</code> recognizes both field layouts natively at macro expansion time. At runtime, <code>buffa_codec::encode_buffa_reflect</code> reads <code>buffa</code> structs in place through their <code>Reflectable</code> vtable, whereas <code>prost_codec::encode_prost</code> converts through <code>prost_reflect::DynamicMessage</code>.',
    ],
  },
  {
    id: 'rs-faq-untrusted-limits',
    question: 'How are untrusted network payloads bounded before allocation?',
    paragraphs: [
      '<code>DecodeOptions</code> caps packet byte length (<code>max_message_bytes</code>), cumulative array and map element counts (<code>max_elements</code>), total heap reservation (<code>max_alloc_bytes</code>), and recursion depth (<code>max_depth</code>, capped at 32). All four checks run ahead of owned value allocation in <code>from_slice_with_options</code>, <code>decode_buffa_with_options</code>, <code>decode_prost_with_options</code>, and <code>decode_blind_with_options</code>, verified across <code>992/992</code> conformance cases.',
    ],
  },
  {
    id: 'rs-faq-no-protobuf-deps',
    question: 'Can crates depend on omnibuf with zero Protobuf dependencies?',
    paragraphs: [
      'Setting <code>default-features = false</code> disables <code>derive</code>, <code>buffa</code>, and <code>prost</code>. Only the core Prefix-Varint wire encoder, zero-copy decoder, <code>Field #0</code> schema reader, <code>opaque::splice_fields</code>, and <code>decode_blind</code> compile, leaving <code>itoa</code> and <code>ryu</code> as the sole dependencies. Adding <code>features = [&quot;derive&quot;]</code> re-enables <code>#[derive(OmniBuf)]</code> for standalone Rust structs.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const rsFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: rsFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Rust | #[derive(OmniBuf)], buffa, prost & protoc-gen-omnibuf-rs"
  description="Use OmniBuf in Rust: derive codecs on structs, serialize buffa and prost Protobuf messages, or generate zero-copy Opaque views with buf."
>
  <Navbar currentPage="rs" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for Rust.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            Supports plain Rust structs via{' '}
            <a href="#derive-macro" class="doc-link">
              derive macros
            </a>
            , existing{' '}
            <a href="#buffa-types" class="doc-link">
              buffa
            </a>{' '}
            and{' '}
            <a href="#prost-types" class="doc-link">
              prost
            </a>{' '}
            Protobuf messages, and{' '}
            <a href="#plugin-codegen" class="doc-link">
              Buf code generation
            </a>
            . Borrowed packet views read nested fields with zero heap allocation and splice updates
            in place. All Protobuf crate dependencies are optional.
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-rs"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://crates.io/crates/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              crates.io &rarr;
            </a>
            <a
              href="https://docs.rs/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              docs.rs &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-3 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Add Rust Crate</div>
              <button
                type="button"
                data-copy="cargo add omnibuf"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>cargo add omnibuf</code></pre>
          </div>

          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111] [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Cargo.toml Features</div>
              <button
                type="button"
                data-copy={cargoFeaturesSnippet}
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <Code code={cargoFeaturesSnippet} lang="toml" theme="github-dark" />
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Ways to use{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
            OmniBuf in Rust.
          </span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          Every integration path produces identical wire bytes.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <div
          id="derive-macro"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Procedural #[derive(OmniBuf)] structs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>#[derive(OmniBuf)]</code> expands straight into single-pass Prefix-Varint writes
              and unrolled tag-switch loops at compile time. Zero <code>.proto</code> build scripts
              are needed. Field attributes declare wire IDs, ZigZag or fixed-width overrides (
              <code>wire = &quot;sint&quot;</code>, <code>&quot;fixed64&quot;</code>),{' '}
              <code>oneof</code> variant tags, and <code>Field #0</code> names.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">#[derive(OmniBuf)]</div>
                <button
                  type="button"
                  data-copy={deriveRustSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={deriveRustSnippet} lang="rust" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.rs} />
        </div>

        <div
          id="buffa-types"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Protobuf messages with buffa
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              First-class support for <code>anthropics/buffa</code> (
              <code>features = [&quot;buffa&quot;]</code>, active by default) covers both static
              co-derivation and runtime reflection. Attaching{' '}
              <code>#[derive(::omnibuf::OmniBuf)]</code> via{' '}
              <code>buffa_build::Config::message_attribute</code> and <code>oneof_attribute</code>{' '}
              parses <code>/// Field N:</code> doc comments, unwraps{' '}
              <code>buffa::MessageField&lt;T&gt;</code>, <code>buffa::EnumValue&lt;E&gt;</code>, and{' '}
              <code>Option&lt;...&gt;</code> oneofs, and emits an unrolled zero-reflection codec.
            </p>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Pre-compiled <code>buffa</code> crates keep their <code>build.rs</code> untouched
              through <code>omnibuf::buffa_codec</code>. <code>encode_buffa_reflect</code> walks{' '}
              <code>Reflectable</code> vtables directly in memory with zero intermediate Protobuf
              buffers, while <code>encode_buffa</code> and <code>decode_buffa</code> transcode
              against any <code>Arc&lt;buffa_descriptor::DescriptorPool&gt;</code>.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  build.rs &middot; Co-Derive with buffa-build
                </div>
                <button
                  type="button"
                  data-copy={buffaBuildSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={buffaBuildSnippet} lang="rust" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  buffa Co-Derive &amp; buffa_codec
                </div>
                <button
                  type="button"
                  data-copy={buffaUsageSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={buffaUsageSnippet} lang="rust" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="prost-types"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Protobuf messages with prost
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Workspaces built around <code>prost</code> and <code>tonic</code> pair static
              co-derivation with runtime descriptors (<code>features = [&quot;prost&quot;]</code>,
              active by default). Passing <code>#[derive(::omnibuf::OmniBuf)]</code> to{' '}
              <code>prost_build::Config::type_attribute</code> compiles <code>#[prost(...)]</code>{' '}
              field tags into monomorphized <code>Message</code> and <code>Oneof</code> impls.
              Upstream crates implementing <code>prost_reflect::ReflectMessage</code> or{' '}
              <code>DynamicMessage</code> pass directly into <code>encode_prost</code> and{' '}
              <code>decode_prost</code>.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  prost Co-Derive &amp; prost_codec
                </div>
                <button
                  type="button"
                  data-copy={prostSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={prostSnippet} lang="rust" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated views with protoc-gen-omnibuf-rs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Pointing <code>buf.gen.yaml</code> at <code>protoc-gen-omnibuf-rs</code> generates
              owned Rust structs paired with lifetime-bound <code>Opaque&lt;&apos;a&gt;</code>{' '}
              views. Getters hop across preceding field headers by byte length and borrow{' '}
              <code>&amp;str</code> and <code>&amp;[u8]</code> straight from the packet slice.{' '}
              <code>try_new</code> and <code>try_marshal</code> validate untrusted buffers up front,
              while <code>splice_fields</code> rewrites dirty fields in place and copies clean spans
              verbatim.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenRsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenRsSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">Generate with Buf</div>
                <button
                  type="button"
                  data-copy="cargo install protoc-gen-omnibuf-rs && buf generate"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>cargo install protoc-gen-omnibuf-rs
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Zero-Copy Opaque&lt;&apos;a&gt; Lookup &amp; Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedRsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedRsSnippet} lang="rust" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="blind-decode"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Schema-less inspection with decode_blind
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Every OmniBuf tag carries an explicit 4-bit wire type. <code>decode_blind</code> and{' '}
              <code>decode_blind_json</code> inspect arbitrary wire slices with zero compile-time
              schemas, emitting synthetic <code>field_1</code>, <code>field_2</code>, ... keys with
              exact integer signs, booleans, IEEE-754 <code>-0.0</code>, UTF-8 strings, and Base64
              byte slices. Passing <code>EncodeOptions::self_describing()</code> prepends{' '}
              <code>Field #0</code> (<code>SchemaMeta</code>) so keys resolve to declared field
              names.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  decode_blind &amp; Field #0 SchemaMeta
                </div>
                <button
                  type="button"
                  data-copy={blindRsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={blindRsSnippet} lang="rust" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="rs-faq"
      class="scroll-mt-16 py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Rust{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
        </h2>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        {rsFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(rsFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="rs" />
  </main>

  <Footer />
</Layout>
