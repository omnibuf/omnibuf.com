---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { esBenchmarkCategories } from '../data/benchmarks';

const defineMessageSnippet = `import {
  defineMessage,
  create,
  toBinary,
  fromBinary,
  type Message,
} from '@omnibuf/core';

interface Peer extends Message<'app.Peer'> {
  peerId: number;
  router: string;
  active: boolean;
  prefixes: number[];
}

const PeerSchema = defineMessage<Peer, 'app.Peer'>('app.Peer', {
  peerId: { fieldNum: 1, name: 'peer_id', type: 'uint32' },
  router: { fieldNum: 2, type: 'string', omitEmpty: true },
  active: { fieldNum: 3, type: 'bool' },
  prefixes: { fieldNum: 4, type: 'uint32', repeated: true },
});

const peer = create(PeerSchema, {
  peerId: 64512,
  router: 'rtr-01',
  active: true,
});
const pkt = toBinary(PeerSchema, peer);
const out = fromBinary(PeerSchema, pkt);`;

const protobufEsSnippet = `import {
  create,
  toBinary,
  fromBinary,
} from '@omnibuf/core';
import { PeerUpdateSchema } from './gen/peer_pb.js';

const msg = create(PeerUpdateSchema, {
  asn: 64512,
  routerId: 'edge-rtr-fra01',
  active: true,
});
const pkt = toBinary(PeerUpdateSchema, msg);
const out = fromBinary(PeerUpdateSchema, pkt);`;

const bufGenEsSnippet = `version: v2
plugins:
  - local: protoc-gen-omnibuf-es
    out: src/gen
    opt: target=ts`;

const generatedEsSnippet = `import {
  create,
  toBinary,
  fromBinary,
} from '@omnibuf/core';
import {
  PeerUpdateSchema,
  OpaquePeerUpdate,
} from './gen/peer_omnibuf.pb.js';

const msg = create(PeerUpdateSchema, {
  asn: 64512,
  routerId: 'rtr-01',
  active: true,
});
const pkt = toBinary(PeerUpdateSchema, msg);

const view = new OpaquePeerUpdate(pkt);
if (view.getActive() && view.getAsn() === 64512) {
  view.setSequence(99n);
  const forwarded = view.marshal();
}`;

const opaqueSpliceEsCode = `const view = new OpaquePeerUpdate(pkt);
const router = view.getRouterId();

view.setActive(false);
view.setSequence(42n);
const updated = view.marshal();`;

const field0BlindEsCode = `import { toBinary, decodeBlind } from '@omnibuf/core';

const pkt = toBinary(PeerSchema, peer, {
  selfDescribing: true,
});
const fields = decodeBlind(pkt);`;

const runtimeAdaptersCode = `import {
  createOmniBufDecodeStream,
  inspectPacket,
} from '@omnibuf/web';

import { writeFrame, readFrames } from '@omnibuf/node';`;

const esFaqItems = [
  {
    id: 'es-faq-bufbuild',
    question: 'Does this work with @bufbuild/protobuf?',
    paragraphs: [
      'Yes. Pass any <code>protoc-gen-es</code> descriptor straight to <code>create</code>, <code>toBinary</code>, and <code>fromBinary</code>. Messages stay plain JS objects with normal <code>camelCase</code> properties.',
    ],
  },
  {
    id: 'es-faq-opaque',
    question: 'Do I have to parse the whole message to read one field?',
    paragraphs: [
      '<code>fromBinary</code> unpacks the full message, whereas the generated <code>Opaque</code> class (and <code>locateField</code> in <code>@omnibuf/core</code>) steps over earlier field headers by byte length to read or patch a single field in the <code>Uint8Array</code>. For length-framed streams over sockets or <code>fetch</code>, <code>@omnibuf/web</code> and <code>@omnibuf/node</code> decode packets as chunks arrive.',
    ],
    codeBlock: opaqueSpliceEsCode,
    codeLabel: 'Example',
  },
  {
    id: 'es-faq-blind',
    question: 'How do I decode without a schema?',
    paragraphs: [
      '<code>decodeBlind(pkt)</code> returns a plain JS object keyed by field number, or keyed by field name when the sender encoded the packet with <code>{ selfDescribing: true }</code> (Field #0).',
    ],
    codeBlock: field0BlindEsCode,
    codeLabel: 'Example',
  },
  {
    id: 'es-faq-packages',
    question: 'What are @omnibuf/web and @omnibuf/node?',
    paragraphs: [
      "<code>@omnibuf/core</code> has zero dependencies and runs in browsers, Node, Bun, Deno, and edge workers. <code>@omnibuf/web</code> adds <code>TransformStream</code> framing and packet inspection helpers, and <code>@omnibuf/node</code> uses Node's <code>Buffer</code> APIs for faster UTF-8 string decoding.",
    ],
    codeBlock: runtimeAdaptersCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const esFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: esFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for TypeScript & JS | protobuf-es, defineMessage & protoc-gen-omnibuf-es"
  description="Use OmniBuf in TypeScript and JavaScript: define schemas in TypeScript, pass in existing @bufbuild/protobuf descriptors, or generate single-pass codecs and Opaque views."
>
  <Navbar currentPage="es" />

  <main id="main-content">
    <!-- Page Header + Up-Front Install Bar -->
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for TypeScript &amp; JS.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            TypeScript and JS projects can{' '}
            <a href="#define-message" class="doc-link">
              define schemas in code
            </a>{' '}
            with <code>defineMessage</code>, pass existing{' '}
            <a href="#protobuf-es" class="doc-link">
              <code>@bufbuild/protobuf</code> descriptors
            </a>{' '}
            to <code>toBinary</code> and <code>fromBinary</code>, or generate codecs with{' '}
            <a href="#plugin-codegen" class="doc-link">
              <code>protoc-gen-omnibuf-es</code>
            </a>
            . V8 benchmark numbers are{' '}
            <a href="#benchmarks" class="doc-link">
              further down the page
            </a>
            .
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-es"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md"
            >
              GitHub Repository (omnibuf-es) &rarr;
            </a>
            <a href="/spec" class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
              Wire Specification &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111] space-y-3">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">Core Runtime (Universal)</div>
                <button
                  type="button"
                  data-copy="pnpm add @omnibuf/core"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add @omnibuf/core</code></pre>
            </div>

            <div class="pt-2.5 border-t border-paper/15 space-y-1.5 text-xs">
              <div class="text-paper/70 uppercase font-bold">Runtime-Specific Packages</div>
              <div class="flex items-center justify-between gap-2">
                <code class="text-paper/90">
                  <span class="text-paper/65 select-none">$ </span>pnpm add @omnibuf/web
                </code>
                <button
                  type="button"
                  data-copy="pnpm add @omnibuf/web"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2 py-0.5 text-[11px] font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <div class="flex items-center justify-between gap-2">
                <code class="text-paper/90">
                  <span class="text-paper/65 select-none">$ </span>pnpm add @omnibuf/node
                </code>
                <button
                  type="button"
                  data-copy="pnpm add @omnibuf/node"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2 py-0.5 text-[11px] font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Three Ways to Use OmniBuf in TypeScript & JS -->
    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Three ways to use{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
            OmniBuf in TypeScript.
          </span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          All three produce identical wire bytes.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <!-- 1. Declarative TypeScript Schemas -->
        <div
          id="define-message"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Declarative TypeScript schemas
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>defineMessage</code> (or class decorators) defines a message schema directly in
              TypeScript for <code>toBinary</code> and <code>fromBinary</code>. No{' '}
              <code>.proto</code> file needed. Each field specifies its field number (
              <code>1..65535</code>) and wire type (<code>uint32</code>, <code>sint64</code>,{' '}
              <code>string</code>, <code>message</code>, <code>map</code>). Optional{' '}
              <code>name</code> and <code>omitEmpty</code> flags control Field #0 names and zero
              values.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">defineMessage Schema</div>
                <button
                  type="button"
                  data-copy={defineMessageSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={defineMessageSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>

        <!-- 2. Existing @bufbuild/protobuf Descriptors -->
        <div
          id="protobuf-es"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Existing @bufbuild/protobuf schemas
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Standard <code>DescMessage</code> descriptors from <code>protoc-gen-es</code> work
              directly with <code>toBinary</code> and <code>fromBinary</code>. The first call
              compiles a cached dispatch table for that descriptor. Both <code>proto3</code> and
              Editions 2023/2024 are supported, and unrecognized tags stay in <code>$unknown</code>.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Existing @bufbuild/protobuf Descriptors
                </div>
                <button
                  type="button"
                  data-copy={protobufEsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufEsSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>

        <!-- 3. Generated Code with protoc-gen-omnibuf-es -->
        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated code with protoc-gen-omnibuf-es
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Adding <code>@omnibuf/protoc-gen-omnibuf-es</code> to <code>buf.gen.yaml</code>{' '}
              generates TypeScript interfaces, single-pass encoders, and <code>Opaque</code> wrapper
              classes. The <code>Opaque</code> class reads individual fields from a{' '}
              <code>Uint8Array</code> by stepping over earlier field headers and splices updated
              values directly into the buffer.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenEsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenEsSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Install Plugin &amp; Generate
                </div>
                <button
                  type="button"
                  data-copy="pnpm add -D @omnibuf/protoc-gen-omnibuf-es && buf generate"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add -D @omnibuf/protoc-gen-omnibuf-es
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Generated Schema &amp; Lazy Opaque View
                </div>
                <button
                  type="button"
                  data-copy={generatedEsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedEsSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TypeScript & JS Benchmarks -->
    <section
      id="benchmarks"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-6">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          TypeScript &amp; JS{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">benchmarks.</span>
        </h2>
        <p class="mt-2.5 text-base sm:text-lg text-ink/80 font-medium">
          11-field <code>PeerUpdate</code> numbers on Node.js v24 (Apple M1 Pro) across{' '}
          <code>@omnibuf/core</code>, <code>protobufjs</code>, <code>@bufbuild/protobuf</code>,{' '}
          <code>google-protobuf</code>, <code>@msgpack/msgpack</code>, and <code>JSON</code>.{' '}
          <strong>Shorter bars = Faster.</strong>
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-5 items-start select-none">
        {esBenchmarkCategories.map((cat) => (
          <div class="os-window overflow-hidden">
            <div class="os-titlebar bg-[#E5E0D5]">
              <span class="font-mono text-xs sm:text-sm font-bold uppercase">{cat.title}</span>
              <div class="os-stripes" />
            </div>

            <div class="p-3.5 sm:p-4 bg-[#FAF8F2] space-y-1">
              <p class="text-xs sm:text-sm text-ink/85 leading-snug pb-1.5 max-w-[70ch]">
                {cat.methodology}
              </p>
              {cat.rows.map((r) => {
                const numPct = Math.max(2, Math.min(100, (r.val / cat.maxVal) * 100));
                const pct = numPct.toFixed(1);
                return (
                  <div
                    class:list={[
                      'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1 rounded min-w-0',
                      r.baseline
                        ? 'bg-acid/45 border-2 border-ink shadow-[2px_2px_0px_#111111] font-bold'
                        : r.highlight
                          ? 'bg-acid/25 border-2 border-dashed border-ink font-bold'
                          : 'border border-ink/15 bg-white',
                    ]}
                    title={`${r.name}: ${r.val.toLocaleString('en-US')} ${cat.unit} (${r.ops})`}
                  >
                    <div class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate">
                      {r.name}
                    </div>
                    <div class="col-span-6 sm:col-span-3 flex items-center min-w-0">
                      <div class="w-full bg-[#E5E0D5] h-3.5 border border-ink rounded-sm overflow-hidden">
                        <div
                          class:list={[
                            'h-full',
                            numPct < 99.5 && 'border-r border-ink',
                            r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                          ]}
                          style={`width: ${pct}%;`}
                        />
                      </div>
                    </div>
                    <div class="col-span-6 sm:col-span-4 text-right font-mono text-xs tabular-nums whitespace-nowrap leading-none">
                      <span class="font-bold text-ink">{r.ratio}</span>{' '}
                      <span class="text-ink/70 font-normal">
                        ({r.val.toLocaleString('en-US')} {cat.unit})
                      </span>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      <!-- Benchmark Environment & Reproducibility -->
      <div class="mt-8 pt-8 border-t-2 border-ink/15 grid md:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="md:col-span-4 space-y-2">
          <h3 class="text-xl sm:text-2xl font-bold uppercase tracking-tight leading-snug">
            Benchmark Environment
          </h3>
          <div class="p-4 bg-ink text-paper rounded-md border-2 border-ink space-y-1.5 font-mono text-sm mt-3">
            <div class="text-acid font-bold uppercase">Hardware &amp; Runtime</div>
            <div>CPU: Apple M1 Pro (darwin/arm64)</div>
            <div>Runtime: Node.js v24.22.1 (V8)</div>
            <div>
              Command: <code>pnpm run bench</code>
            </div>
          </div>
        </div>
        <div class="md:col-span-8 md:pt-1 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch]">
          <p>
            I ran these benchmarks on an Apple M1 Pro Mac using Node.js v24.22.1. Each test uses the
            same 11-field <code>PeerUpdate</code> message as the Go benchmark suite (numbers,
            booleans, strings, a nested <code>Location</code> message, and 4 <code>Neighbor</code>{' '}
            messages).
          </p>
          <p class="text-sm sm:text-base text-ink/80">
            Benchmark source is in{' '}
            <a
              href="https://github.com/omnibuf/omnibuf-es/blob/main/benchmarks/bench.ts"
              target="_blank"
              rel="noopener noreferrer"
              class="doc-link font-mono"
            >
              benchmarks/bench.ts
            </a>{' '}
            in the <code>omnibuf-es</code> repository (<code>pnpm run bench</code>), with recorded
