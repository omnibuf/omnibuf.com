---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import RpcIntegration from '../components/RpcIntegration.astro';

const esRpcCode = `// @grpc/grpc-js (separate package: @omnibuf/grpc)
import { createGrpcMethodDefinition } from '@omnibuf/grpc';
const method = createGrpcMethodDefinition('/acme.v1.Svc/Ping', PingReqSchema, PingRespSchema);

// @connectrpc/connect (separate package: @omnibuf/connect)
import { createConnectCodec, createConnectUnaryClient } from '@omnibuf/connect';
const codec = createConnectCodec(PingReqSchema);
const call = createConnectUnaryClient('/acme.v1.Svc/Ping', PingReqSchema, PingRespSchema);`;
import { defaultTypeMappings } from '../data/typeMappings';

const defineMessageSnippet = `import {
  defineMessage,
  create,
  toBinary,
  fromBinary,
  type Message,
} from '@omnibuf/core';

interface Peer extends Message<'app.Peer'> {
  peerId: number;
  router: string;
  active: boolean;
  prefixes: number[];
}

const PeerSchema = defineMessage<Peer, 'app.Peer'>('app.Peer', {
  peerId: { fieldNum: 1, name: 'peer_id', type: 'uint32' },
  router: { fieldNum: 2, type: 'string', omitEmpty: true },
  active: { fieldNum: 3, type: 'bool' },
  prefixes: { fieldNum: 4, type: 'uint32[]' },
});

const peer = create(PeerSchema, {
  peerId: 64512,
  router: 'rtr-01',
  active: true,
});
const pkt = toBinary(PeerSchema, peer);
const out = fromBinary(PeerSchema, pkt);`;

const protobufEsSnippet = `import {
  create,
  toBinary,
  fromBinary,
} from '@omnibuf/core';
import { PeerUpdateSchema } from './gen/peer_pb.js';

const msg = create(PeerUpdateSchema, {
  asn: 64512,
  routerId: 'edge-rtr-fra01',
  active: true,
});
const pkt = toBinary(PeerUpdateSchema, msg);
const out = fromBinary(PeerUpdateSchema, pkt);`;

const bufGenEsSnippet = `version: v2
plugins:
  - local: protoc-gen-omnibuf-es
    out: src/gen
    opt: target=ts`;

const generatedEsSnippet = `import {
  create,
  toBinary,
  fromBinary,
} from '@omnibuf/core';
import {
  PeerUpdateSchema,
  OpaquePeerUpdate,
} from './gen/peer_omnibuf.pb.js';

const msg = create(PeerUpdateSchema, {
  asn: 64512,
  routerId: 'rtr-01',
  active: true,
});
const pkt = toBinary(PeerUpdateSchema, msg);

const view = new OpaquePeerUpdate(pkt);
if (view.getActive() && view.getAsn() === 64512) {
  view.setSequence(99n);
  const forwarded = view.marshal();
}`;

const opaqueSpliceEsCode = `const view = new OpaquePeerUpdate(pkt);
const router = view.getRouterId();

view.setActive(false);
view.setSequence(42n);
const updated = view.marshal();`;

const field0BlindEsCode = `import { toBinary, decodeBlind } from '@omnibuf/core';

const pkt = toBinary(PeerSchema, peer, {
  selfDescribing: true,
});
const fields = decodeBlind(pkt);`;

const runtimeAdaptersCode = `import {
  createOmniBufDecodeStream,
  inspectPacket,
} from '@omnibuf/web';

import { writeFrame, readFrames } from '@omnibuf/node';`;

const esFaqItems = [
  {
    id: 'es-faq-bufbuild',
    question: 'Does this work with @bufbuild/protobuf?',
    paragraphs: [
      'Yes. Pass any <code>protoc-gen-es</code> descriptor straight to <code>create</code>, <code>toBinary</code>, and <code>fromBinary</code>. Messages stay plain JS objects with normal <code>camelCase</code> properties.',
    ],
  },
  {
    id: 'es-faq-opaque',
    question: 'Do I have to parse the whole message to read one field?',
    paragraphs: [
      '<code>fromBinary</code> unpacks the full message, whereas the generated <code>Opaque</code> class (and <code>locateField</code> in <code>@omnibuf/core</code>) steps over earlier field headers by byte length to read or patch a single field in the <code>Uint8Array</code>. For length-framed streams over sockets or <code>fetch</code>, <code>@omnibuf/web</code> and <code>@omnibuf/node</code> decode packets as chunks arrive.',
    ],
    codeBlock: opaqueSpliceEsCode,
    codeLabel: 'Example',
  },
  {
    id: 'es-faq-blind',
    question: 'How do I decode without a schema?',
    paragraphs: [
      '<code>decodeBlind(pkt)</code> returns a plain JS object with synthetic <code>field_1</code>, <code>field_2</code>, ... keys, or keyed by field name when the sender encoded the packet with <code>{ selfDescribing: true }</code> (Field #0).',
    ],
    codeBlock: field0BlindEsCode,
    codeLabel: 'Example',
  },
  {
    id: 'es-faq-packages',
    question: 'What are @omnibuf/web and @omnibuf/node?',
    paragraphs: [
      "<code>@omnibuf/core</code> has zero dependencies and runs in browsers, Node, Bun, Deno, and edge workers. <code>@omnibuf/web</code> adds <code>TransformStream</code> framing and packet inspection helpers, and <code>@omnibuf/node</code> uses Node's <code>Buffer</code> APIs for faster UTF-8 string decoding.",
    ],
    codeBlock: runtimeAdaptersCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const esFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: esFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for TypeScript & JS | protobuf-es, defineMessage & protoc-gen-omnibuf-es"
  description="Use OmniBuf in TypeScript and JS: define schemas in TypeScript, pass @bufbuild/protobuf descriptors, or generate codecs and Opaque views."
>
  <Navbar currentPage="es" />

  <main id="main-content">
    <!-- Page Header + Up-Front Install Bar -->
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        OmniBuf <span class="text-[#FF4F18]">for TypeScript &amp; JS</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
            Zero-dependency runtime for browsers, Node.js, and edge workers.{' '}
            <a href="#define-message" class="doc-link">
              Define schemas in TypeScript
            </a>
            , reuse existing{' '}
            <a href="#protobuf-es" class="doc-link">
              Protobuf-ES descriptors
            </a>
            , or{' '}
            <a href="#plugin-codegen" class="doc-link">
              generate codecs and lazy packet views
            </a>{' '}
            with Buf. Dedicated streaming helpers ship for both Web Streams and Node.
          </p>
          <div class="flex flex-wrap gap-2.5 text-sm pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-es"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-4 py-2"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://www.npmjs.com/package/@omnibuf/core"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary px-4 py-2"
            >
              npm Package &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 space-y-3">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Core Runtime (Universal)</div>
                <button
                  type="button"
                  data-copy="pnpm add @omnibuf/core"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add @omnibuf/core</code></pre>
            </div>

            <div class="pt-2.5 border-t border-paper/12 space-y-1.5 text-xs">
              <div class="text-paper/60 font-medium">Runtime-Specific Packages</div>
              <div class="flex items-center justify-between gap-2">
                <code class="text-paper/90">
                  <span class="text-paper/65 select-none">$ </span>pnpm add @omnibuf/web
                </code>
                <button
                  type="button"
                  data-copy="pnpm add @omnibuf/web"
                  class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <div class="flex items-center justify-between gap-2">
                <code class="text-paper/90">
                  <span class="text-paper/65 select-none">$ </span>pnpm add @omnibuf/node
                </code>
                <button
                  type="button"
                  data-copy="pnpm add @omnibuf/node"
                  class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Three Ways to Use OmniBuf in TypeScript & JS -->
    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Three ways to use OmniBuf in TypeScript.
        </h2>
        <p class="mt-2 text-base sm:text-lg text-ink/75">All three produce identical wire bytes.</p>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        <!-- 1. Declarative TypeScript Schemas -->
        <div
          id="define-message"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Declarative TypeScript schemas
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>defineMessage</code> (or class decorators) defines a message schema directly in
              TypeScript for <code>toBinary</code> and <code>fromBinary</code>. No{' '}
              <code>.proto</code> file needed. Each field specifies its field number (
              <code>1..536,870,911</code>) and field type (<code>uint32</code>, <code>sint64</code>,{' '}
              <code>string</code>, <code>uint32[]</code>, <code>submsg</code>, <code>map</code>).
              Optional <code>name</code> and <code>omitEmpty</code> flags control Field #0 names and
              zero values.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">defineMessage Schema</div>
                <button
                  type="button"
                  data-copy={defineMessageSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={defineMessageSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.es} />
        </div>

        <!-- 2. Existing @bufbuild/protobuf Descriptors -->
        <div
          id="protobuf-es"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Existing @bufbuild/protobuf schemas
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Standard <code>DescMessage</code> descriptors from <code>protoc-gen-es</code> work
              directly with <code>toBinary</code> and <code>fromBinary</code>. The first call
              compiles a cached dispatch table for that descriptor. Both <code>proto3</code> and
              Editions 2023/2024 are supported, and unrecognized tags stay in <code>$unknown</code>.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">
                  Existing @bufbuild/protobuf Descriptors
                </div>
                <button
                  type="button"
                  data-copy={protobufEsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufEsSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>

        <!-- 3. Generated Code with protoc-gen-omnibuf-es -->
        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Generated code with protoc-gen-omnibuf-es
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Add <code>@omnibuf/protoc-gen-omnibuf-es</code> to <code>buf.gen.yaml</code> to
              generate TypeScript interfaces, single-pass encoders, and <code>Opaque</code> wrapper
              classes. The <code>Opaque</code> class reads individual fields from a{' '}
              <code>Uint8Array</code> by stepping over earlier field headers and splices updated
              values directly into the buffer.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenEsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenEsSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Install Plugin &amp; Generate</div>
                <button
                  type="button"
                  data-copy="pnpm add -D @omnibuf/protoc-gen-omnibuf-es && buf generate"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>pnpm add -D @omnibuf/protoc-gen-omnibuf-es
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">
                  Generated Schema &amp; Lazy Opaque View
                </div>
                <button
                  type="button"
                  data-copy={generatedEsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedEsSnippet} lang="ts" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TypeScript & JS FAQ -->
    <RpcIntegration
      heading="gRPC & Connect"
      accent="in TypeScript."
      summary="Two separate workspace packages (<code>@omnibuf/grpc</code> and <code>@omnibuf/connect</code>) plug OmniBuf into <code>@grpc/grpc-js</code> and <code>@connectrpc/connect</code> without adding RPC dependencies to <code>@omnibuf/core</code>."
      code={esRpcCode}
      lang="ts"
      codeLabel="@omnibuf/grpc & @omnibuf/connect"
    />

    <section
      id="es-faq"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          TypeScript &amp; JS questions.
        </h2>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        {esFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-lg sm:text-xl font-bold tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-lg border border-ink/15 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                    <div class="text-xs font-medium text-paper/70">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="ts" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(esFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="es" />
  </main>

  <Footer />
</Layout>
