---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Quickstart from '../components/Quickstart.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import Footer from '../components/Footer.astro';
import RpcIntegration from '../components/RpcIntegration.astro';

const goRpcCode = `// gRPC (github.com/omnibuf/omnibuf-go/omnibufgrpc)
omnibufgrpc.Register()
conn, _ := grpc.NewClient(addr, grpc.WithDefaultCallOptions(omnibufgrpc.CallOption()))

// ConnectRPC v2 (github.com/omnibuf/omnibuf-go/omnibufconnect)
connecthttp.Mount(mux, server, omnibufconnect.ServerOptions()...)
transport := connecthttp.NewTransport(http.DefaultClient, url, omnibufconnect.ClientOptions()...)
client := connect.NewClient(transport)`;

const opaqueSpliceCode = `var view pb.OpaquePeerUpdate
_ = view.Unmarshal(pkt)
router := view.GetRouterId()
view.SetActive(false)
updated := view.MarshalAppend(nil)`;

const field0BlindCode = `opts := omnibuf.MarshalOptions{SelfDescribing: true}
pkt, err := opts.Marshal(&peer)
fields, err := omnibuf.DecodeBlind(pkt)`;

const zeroCopyBufferCode = `buf = msg.MarshalOmniBufAppend(buf[:0])
err := out.UnmarshalOmniBuf(buf, true)`;

const goFaqItems = [
  {
    id: 'go-faq-opaque',
    question: 'Do I have to parse the whole message to read one field?',
    paragraphs: [
      '<code>omnibuf.Unmarshal</code> unpacks the full struct, whereas the generated <code>Opaque</code> view (and <code>wire.LocateField</code>) steps over earlier field headers by their byte lengths to read or overwrite a single field in the raw slice.',
    ],
    codeBlock: opaqueSpliceCode,
    codeLabel: 'Example',
  },
  {
    id: 'go-faq-blind',
    question: 'How do I decode without a schema?',
    paragraphs: [
      '<code>omnibuf.DecodeBlind(pkt)</code> returns a map with synthetic <code>field_1</code>, <code>field_2</code>, ... keys. Pass <code>MarshalOptions{SelfDescribing: true}</code> on encode to embed Field #0 so <code>DecodeBlind</code> keys the map by field name.',
    ],
    codeBlock: field0BlindCode,
    codeLabel: 'Example',
  },
  {
    id: 'go-faq-zerocopy',
    question: 'What does zeroCopy do?',
    paragraphs: [
      'Passing <code>true</code> to <code>UnmarshalOmniBuf(pkt, true)</code> aliases decoded Go strings directly to the <code>pkt</code> byte slice via <code>unsafe.String</code> with zero heap allocations. The caller must keep <code>pkt</code> immutable for the lifetime of the decoded strings.',
    ],
    codeBlock: zeroCopyBufferCode,
    codeLabel: 'Example',
  },
  {
    id: 'go-faq-plugin',
    question: 'Do I need protoc-gen-omnibuf-go?',
    paragraphs: [
      'Code generation is optional. Core <code>omnibuf.Marshal</code> and <code>omnibuf.Unmarshal</code> serialize tagged Go structs with zero external dependencies, while the separate <code>omnibufproto</code> submodule handles standard <code>.pb.go</code> messages via <code>protoreflect</code>. For the fastest path, <code>protoc-gen-omnibuf-go</code> compiles single-pass struct methods and lazy <code>Opaque</code> packet views.',
    ],
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const goFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: goFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Go | Struct Tags, Protobuf Structs & protoc-gen-omnibuf-go"
  description="Use OmniBuf in Go: tag plain Go structs, encode standard .pb.go Protobuf messages, or generate single-pass codecs and Opaque views."
>
  <Navbar currentPage="go" />

  <main id="main-content">
    <!-- Page Header + Up-Front Install Bar -->
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        OmniBuf <span class="text-[#FF4F18]">for Go</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
            Zero-dependency runtime for Go. Serialize{' '}
            <a href="#struct-tags" class="doc-link">
              tagged structs
            </a>
            , existing{' '}
            <a href="#pb-go-structs" class="doc-link">
              Protobuf messages
            </a>
            , or{' '}
            <a href="#plugin-tiers" class="doc-link">
              Buf-generated types
            </a>
            . Generated packet views read and update individual fields in place on raw byte slices,
            and self-describing payloads decode straight to maps or JSON.
          </p>
          <div class="flex flex-wrap gap-2.5 text-sm pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-go"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-4 py-2"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://pkg.go.dev/github.com/omnibuf/omnibuf-go"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary px-4 py-2"
            >
              pkg.go.dev &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
              <div class="text-xs font-medium text-paper/70">Install Go Runtime</div>
              <button
                type="button"
                data-copy="go get github.com/omnibuf/omnibuf-go"
                class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>go get github.com/omnibuf/omnibuf-go</code></pre>
          </div>
        </div>
      </div>
    </section>

    <!-- Three Ways to Use OmniBuf in Go -->
    <Quickstart />

    <!-- Go FAQ -->
    <RpcIntegration
      heading="gRPC & Connect"
      accent="in Go."
      summary="Separate Go modules (<code>omnibufgrpc</code> and <code>omnibufconnect</code>) register OmniBuf with <code>google.golang.org/grpc</code> and <code>connectrpc.com/connect/v2</code> without adding RPC dependencies to core <code>omnibuf-go</code>."
      code={goRpcCode}
      lang="go"
      codeLabel="omnibufgrpc & omnibufconnect"
    />

    <section
      id="go-faq"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">Go questions.</h2>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        {goFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-lg sm:text-xl font-bold tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-lg border border-ink/15 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                    <div class="text-xs font-medium text-paper/70">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="go" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(goFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="go" />
  </main>

  <Footer />
</Layout>
