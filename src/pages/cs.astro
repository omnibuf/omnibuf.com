---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import RpcIntegration from '../components/RpcIntegration.astro';

const csRpcCode = `// Separate project: OmniBuf.Grpc (keeps core OmniBuf free of Grpc.Core.Api)
using Grpc.Core;
using OmniBuf.Grpc;

var method = new Method<PingRequest, PingResponse>(
    MethodType.Unary,
    "acme.v1.Svc",
    "Ping",
    OmniBufGrpcMarshaller.Create<PingRequest>(),
    OmniBufGrpcMarshaller.Create<PingResponse>());`;
import { defaultTypeMappings } from '../data/typeMappings';

const attributeCsSnippet = `using OmniBuf;

[OmniBufMessage(TypeName = "SensorSample")]
public sealed record SensorSample(
    [property: OmniBufField(1, Name = "sensor_id")] string SensorId,
    [property: OmniBufField(2, Name = "celsius")] double Celsius,
    [property: OmniBufField(3, Name = "seq")] ulong Seq);

var sample = new SensorSample("rack-42-inlet", 21.75, 1042UL);
byte[] pkt = OmniBufSerializer.Marshal(sample);
SensorSample outSample = OmniBufSerializer.Unmarshal<SensorSample>(pkt);`;

const googleProtoCsSnippet = `using Omnibuf.Bench;
using OmniBuf;

byte[] pkt = OmniBufProtobuf.Marshal(peer);
PeerUpdate copy = OmniBufProtobuf.Unmarshal<PeerUpdate>(pkt);`;

const bufGenCsSnippet = `version: v2
clean: true
plugins:
  - protoc_builtin: csharp
    out: src/Generated
  - local: protoc-gen-omnibuf-cs
    out: src/Generated`;

const generatedCsSnippet = `using Omnibuf.Bench;
using OmniBuf;

byte[] pkt = peer.MarshalOmniBuf();

var view = new OpaquePeerUpdate(pkt);
string city = view.GetLocationCity();

view.Sequence = 9_876_543_211UL;
byte[] updated = view.MarshalOmniBuf();`;

const blindCsCode = `using OmniBuf;

byte[] pkt = OmniBufSerializer.Marshal(sample, new MarshalOptions { SelfDescribing = true });
string json = OmniBufBlind.DecodeBlindJson(pkt);`;

const csFaqItems = [
  {
    id: 'cs-faq-partial',
    question: 'Why does protoc-gen-omnibuf-cs pair with protoc_builtin: csharp?',
    paragraphs: [
      '<code>Google.Protobuf</code> generates <code>sealed partial class</code> message types in C#. <code>protoc-gen-omnibuf-cs</code> emits companion <code>partial class</code> files adding <code>MarshalOmniBuf()</code> and <code>ParseOmniBuf(ReadOnlySpan&lt;byte&gt;)</code> directly onto your existing message types alongside standalone <code>Opaque*</code> views.',
    ],
  },
  {
    id: 'cs-faq-expressions',
    question: 'Why is [OmniBufField] nearly as fast as generated code on .NET 8?',
    paragraphs: [
      '<code>OmniBufSerializer</code> compiles typed <code>System.Linq.Expressions</code> delegates once per type, avoiding per-field reflection and primitive boxing. Under RyuJIT Dynamic PGO, <code>[OmniBufField]</code> decodes within 20% of generated partial methods while still edging out <code>Google.Protobuf</code>.',
    ],
  },
  {
    id: 'cs-faq-blind',
    question: 'How does OmniBufBlind inspect schema-less packets?',
    paragraphs: [
      '<code>OmniBufBlind.DecodeBlind(pkt)</code> reads 4-bit wire tags into a dictionary with <code>field_1</code>, <code>field_2</code>, ... keys, or maps Field #0 names when <code>SelfDescribing = true</code> was set on encode.',
    ],
    codeBlock: blindCsCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const csFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: csFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for C# & .NET 8: Span Runtime & Protobuf"
  description="Use OmniBuf on .NET 8: annotate C# records, serialize Google.Protobuf messages, or generate Span-based codecs and zero-copy Opaque views."
>
  <Navbar currentPage="cs" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        OmniBuf <span class="text-[#FF4F18]">for C# &amp; .NET</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
            Managed .NET 8 library on NuGet paired with a Buf code generator. Serialize{' '}
            <a href="#attributes" class="doc-link">
              attributed records, classes, and structs
            </a>
            , pass in{' '}
            <a href="#google-protobuf" class="doc-link">
              Google Protobuf messages
            </a>
            , or{' '}
            <a href="#plugin-codegen" class="doc-link">
              generate partial classes and lazy packet views
            </a>{' '}
            for in-place field reads and updates.
          </p>
          <div class="flex flex-wrap gap-2.5 text-sm pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-cs"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-4 py-2"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://www.nuget.org/packages/OmniBuf"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary px-4 py-2"
            >
              NuGet Package &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
              <div class="text-xs font-medium text-paper/70">Add .NET Package</div>
              <button
                type="button"
                data-copy="dotnet add package OmniBuf"
                class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>dotnet add package OmniBuf</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Three ways to use OmniBuf in C#.
        </h2>
        <p class="mt-2 text-base sm:text-lg text-ink/75">
          All three produce identical wire bytes across .NET 8 and newer runtimes.
        </p>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        <div
          id="attributes"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Attribute-annotated C# records and classes
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>[OmniBufMessage]</code> and <code>[OmniBufField]</code> work on mutable classes,
              value structs, and immutable C# positional records. <code>OmniBufSerializer</code>{' '}
              compiles expression-tree encoders and decoders once per type.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">[OmniBufField] C# Record</div>
                <button
                  type="button"
                  data-copy={attributeCsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={attributeCsSnippet} lang="csharp" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.cs} />
        </div>

        <div
          id="google-protobuf"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Standard Google.Protobuf.IMessage types
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              ASP.NET Core and gRPC projects already generating <code>Google.Protobuf</code> classes
              pass any <code>IMessage</code> directly to <code>OmniBufProtobuf.Marshal</code> and{' '}
              <code>OmniBufProtobuf.Unmarshal&lt;T&gt;</code>.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Google.Protobuf Bridge</div>
                <button
                  type="button"
                  data-copy={googleProtoCsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={googleProtoCsSnippet} lang="csharp" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Generated partial classes with protoc-gen-omnibuf-cs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Add <code>protoc-gen-omnibuf-cs</code> to <code>buf.gen.yaml</code> to attach direct{' '}
              <code>Span&lt;byte&gt;</code> encoders and decoders onto generated C# partial classes
              and emits <code>Opaque*</code> views. Single-field sequence updates complete in ~134
              ns.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenCsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenCsSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Lint &amp; Generate with Buf</div>
                <button
                  type="button"
                  data-copy="buf lint && buf generate"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>buf lint
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">
                  Generated Partial Class &amp; Opaque Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedCsSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedCsSnippet} lang="csharp" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <RpcIntegration
      heading="gRPC in C#"
      accent="with OmniBuf.Grpc."
      summary="The <code>OmniBuf.Grpc</code> package builds contextual <code>Grpc.Core.Marshaller&lt;T&gt;</code> instances for <code>Grpc.Net.Client</code> and ASP.NET Core gRPC without adding gRPC to core <code>OmniBuf</code>."
      code={csRpcCode}
      lang="csharp"
      codeLabel="OmniBuf.Grpc"
    />

    <section
      id="cs-faq"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          C# &amp; .NET questions.
        </h2>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        {csFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-lg sm:text-xl font-bold tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-lg border border-ink/15 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                    <div class="text-xs font-medium text-paper/70">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="csharp" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(csFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="cs" />
  </main>

  <Footer />
</Layout>
