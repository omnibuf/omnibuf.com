---
import { Code } from 'astro:components';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const vscodeInstallSnippet = `code --install-extension omnibuf.omnibuf-vscode`;

const lazyNvimSnippet = `{ "omnibuf/omnibuf-vim" }`;

const vimPlugSnippet = `Plug 'omnibuf/omnibuf-vim'`;
---

<Layout
  title="Editor Plugins | VS Code & Neovim for OmniBuf"
  description="Edit binary .obuf files as syntax-highlighted JSON with split hex views in Visual Studio Code, Neovim, and Vim."
>
  <Navbar currentPage="tooling-editors" />

  <main id="main-content">
    <section class="pt-6 pb-8 sm:pt-8 sm:pb-10 px-4 sm:px-6 max-w-4xl mx-auto space-y-3">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        Editor plugins
      </h1>
      <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[64ch]">
        Open binary <code>.obuf</code> files straight in Visual Studio Code or Neovim as readable
        JSON, and save valid edits back to wire bytes. Both plugins call the{' '}
        <a href="/tooling/cli" class="doc-link">
          <code>omnibuf</code> CLI
        </a>{' '}
        on your <code>PATH</code>.
      </p>
    </section>

    <section class="pb-12 sm:pb-16 px-4 sm:px-6 max-w-4xl mx-auto space-y-6">
      <!-- VS Code -->
      <div
        id="vscode"
        class="scroll-mt-16 bg-[#FAF8F2] border border-ink/15 rounded-lg p-5 sm:p-6 space-y-4"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3.5">
            <svg
              aria-hidden="true"
              viewBox="0 0 100 100"
              class="w-8 h-8 shrink-0"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M95.5 20.4L74.8 10.4C72.5 9.3 69.8 9.8 68 11.6L32.1 44.3L16.3 32.3C14.7 31.1 12.5 31.2 11 32.5L4.5 38.4C2.5 40.2 2.5 43.3 4.5 45.1L16.2 50L4.5 54.9C2.5 56.7 2.5 59.8 4.5 61.6L11 67.5C12.5 68.8 14.7 68.9 16.3 67.7L32.1 55.7L68 88.4C69.8 90.2 72.5 90.7 74.8 89.6L95.5 79.6C97.6 78.6 99 76.5 99 74.1V25.9C99 23.5 97.6 21.4 95.5 20.4Z"
                fill="#0065A9"
              />
              <path
                d="M95.5 20.4L74.8 10.4C72.5 9.3 69.8 9.8 68 11.6L11 67.5C12.5 68.8 14.7 68.9 16.3 67.7L95.5 20.4Z"
                fill="#007ACC"
              />
              <path
                d="M95.5 79.6L74.8 89.6C72.5 90.7 69.8 90.2 68 88.4L11 32.5C12.5 31.2 14.7 31.1 16.3 32.3L95.5 79.6Z"
                fill="#1F9CF0"
              />
              <path
                d="M74.8 89.6C72.5 90.7 69.8 90.2 68 88.4V11.6C69.8 9.8 72.5 9.3 74.8 10.4L95.5 20.4C97.6 21.4 99 23.5 99 25.9V74.1C99 76.5 97.6 78.6 95.5 79.6L74.8 89.6Z"
                fill="#1F9CF0"
              />
              <path d="M74 30.8L48.5 50L74 69.2V30.8Z" fill="#FAF8F2" />
            </svg>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">
              Visual Studio Code
            </h2>
          </div>
          <code class="text-xs font-mono text-ink/65">omnibuf.omnibuf-vscode</code>
        </div>

        <p class="text-sm sm:text-base text-ink/85 leading-relaxed max-w-[65ch]">
          Custom editor for <code>*.obuf</code> files with syntax-highlighted JSON editing, Split
          and 16-byte Hex views, live reload on disk changes, and optional{' '}
          <code>FileDescriptorSet</code> schema settings. Invalid JSON blocks save so the underlying
          binary file stays intact.
        </p>

        <div class="bg-ink text-paper rounded-lg border border-ink/15 overflow-hidden">
          <div class="flex items-center justify-between gap-2 px-3.5 py-2 border-b border-paper/12 text-xs font-mono text-paper/70">
            <span>Install VS Code extension</span>
            <button
              type="button"
              data-copy={vscodeInstallSnippet}
              class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <div class="p-3.5 font-mono text-xs sm:text-sm overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
            <Code code={vscodeInstallSnippet} lang="sh" theme="github-dark" />
          </div>
        </div>

        <div class="flex flex-wrap gap-2.5 text-xs sm:text-sm no-print">
          <a
            href="https://marketplace.visualstudio.com/items?itemName=omnibuf.omnibuf-vscode"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary px-3.5 py-2"
          >
            VS Code Marketplace &rarr;
          </a>
          <a
            href="https://open-vsx.org/extension/omnibuf/omnibuf-vscode"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary px-3.5 py-2"
          >
            Open VSX &rarr;
          </a>
          <a
            href="https://github.com/omnibuf/omnibuf-vscode"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary px-3.5 py-2"
          >
            GitHub &rarr;
          </a>
        </div>

        <figure class="space-y-2 pt-1">
          <a
            href="/images/tooling/vscode-split.webp"
            target="_blank"
            rel="noopener noreferrer"
            title="Open full-size VS Code screenshot"
            class="block rounded-lg overflow-hidden border border-ink/15 hover:border-ink/40 bg-ink transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]"
          >
            <img
              src="/images/tooling/vscode-split.webp"
              alt="Visual Studio Code custom editor showing peer_update.obuf in Split mode with editable syntax-highlighted JSON on the left and a 16-byte binary hex dump on the right."
              width="2560"
              height="1480"
              loading="eager"
              class="w-full h-auto block"
            />
          </a>
          <figcaption class="text-xs text-ink/65">
            VS Code custom editor in Split mode: editable JSON on the left, live 16-byte hex dump on
            the right. Click image to view full size.
          </figcaption>
        </figure>
      </div>

      <!-- Neovim / Vim -->
      <div
        id="neovim"
        class="scroll-mt-16 bg-[#FAF8F2] border border-ink/15 rounded-lg p-5 sm:p-6 space-y-4"
      >
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3.5">
            <svg
              aria-hidden="true"
              viewBox="0 0 100 100"
              class="w-8 h-8 shrink-0"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M16 20.5L34.5 4V96L16 77.5V20.5Z" fill="#54A2E0" />
              <path d="M84 22.5L65.5 4V96L84 79.5V22.5Z" fill="#57A143" />
              <path d="M34.5 4L84 79.5L65.5 96L16 20.5L34.5 4Z" fill="#46993A" />
              <path d="M34.5 42.5L16 20.5L34.5 4V42.5Z" fill="#2E7D32" fill-opacity="0.35" />
            </svg>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">Neovim / Vim</h2>
          </div>
          <code class="text-xs font-mono text-ink/65">omnibuf/omnibuf-vim</code>
        </div>

        <p class="text-sm sm:text-base text-ink/85 leading-relaxed max-w-[65ch]">
          <code>BufReadCmd</code> / <code>BufWriteCmd</code> plugin for <code>*.obuf</code> buffers
          with atomic write-back, companion hex split view (<code>:OmnibufSplit</code>), hex toggle
          (<code>:OmnibufHex</code>), and per-buffer schema switching (<code>:OmnibufSchema</code>).
        </p>

        <div class="space-y-3">
          <div class="bg-ink text-paper rounded-lg border border-ink/15 overflow-hidden">
            <div class="flex items-center justify-between gap-2 px-3.5 py-2 border-b border-paper/12 text-xs font-mono text-paper/70">
              <span>lazy.nvim</span>
              <button
                type="button"
                data-copy={lazyNvimSnippet}
                class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <div class="p-3.5 font-mono text-xs sm:text-sm overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <Code code={lazyNvimSnippet} lang="lua" theme="github-dark" />
            </div>
          </div>

          <div class="bg-ink text-paper rounded-lg border border-ink/15 overflow-hidden">
            <div class="flex items-center justify-between gap-2 px-3.5 py-2 border-b border-paper/12 text-xs font-mono text-paper/70">
              <span>vim-plug</span>
              <button
                type="button"
                data-copy={vimPlugSnippet}
                class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <div class="p-3.5 font-mono text-xs sm:text-sm overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <Code code={vimPlugSnippet} lang="viml" theme="github-dark" />
            </div>
          </div>
        </div>

        <div class="flex flex-wrap gap-2.5 text-xs sm:text-sm no-print">
          <a
            href="https://github.com/omnibuf/omnibuf-vim"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary px-3.5 py-2"
          >
            GitHub Repository &rarr;
          </a>
        </div>

        <figure class="space-y-2 pt-1">
          <a
            href="/images/tooling/vim-split.webp"
            target="_blank"
            rel="noopener noreferrer"
            title="Open full-size Neovim screenshot"
            class="block rounded-lg overflow-hidden border border-ink/15 hover:border-ink/40 bg-ink transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]"
          >
            <img
              src="/images/tooling/vim-split.webp"
              alt="Neovim with omnibuf-vim showing peer_update.obuf decoded as JSON on the left and a read-only xxd hex companion buffer on the right via :OmnibufSplit."
              width="2560"
              height="1380"
              loading="lazy"
              class="w-full h-auto block"
            />
          </a>
          <figcaption class="text-xs text-ink/65">
            <code>:OmnibufSplit</code> opening the decoded JSON buffer alongside a read-only{' '}
            <code>xxd</code> hex view. Click image to view full size.
          </figcaption>
        </figure>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
