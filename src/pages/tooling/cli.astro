---
import { Code } from 'astro:components';
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const cliInstallOptions = [
  { label: 'Homebrew (macOS & Linux)', command: 'brew install omnibuf/tap/omnibuf' },
  { label: 'mise', command: 'mise use -g github:omnibuf/omnibuf-cli' },
  { label: 'Shell script', command: 'curl -fsSL https://omnibuf.com/install.sh | sh' },
  { label: 'Go', command: 'go install github.com/omnibuf/omnibuf-cli/cmd/omnibuf@latest' },
];

const jqFilterSnippet = `# Pretty-print any OmniBuf packet as JSON
omnibuf packet.obuf

# Extract a nested field as a raw string (-r)
omnibuf -r '.location.city' packet.obuf

# Filter array elements and emit compact JSON (-c)
omnibuf -c '.neighbors[] | select(.established) | .router' packet.obuf`;

const encodeSnippet = `# Pipe JSON directly into omnibuf to produce self-describing wire bytes (Field #0)
echo '{"event": {"int": 10, "city": "FRA"}}' | omnibuf > event.obuf

# Round-trip back to JSON or query a field in one pipeline
echo '{"event": {"int": 10, "city": "FRA"}}' | omnibuf | omnibuf '.event.city'

# Encode or decode against a compiled Protobuf FileDescriptorSet (.pb, .pb.gz, .json)
omnibuf encode --schema descriptors.pb --type demo.v1.PeerUpdate input.json > packet.obuf
omnibuf decode --schema descriptors.pb --type demo.v1.PeerUpdate packet.obuf`;
---

<Layout
  title="OmniBuf CLI: Decode, Encode & Query .obuf Packets"
  description="Standalone omnibuf CLI for decoding raw .obuf files to JSON without a schema, running built-in jq filters, and encoding JSON back to wire bytes."
>
  <Navbar currentPage="tooling-cli" />

  <main id="main-content">
    <section class="pt-6 pb-8 sm:pt-8 sm:pb-10 px-4 sm:px-6 max-w-4xl mx-auto space-y-5">
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
          OmniBuf CLI
        </h1>
        <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[64ch]">
          Standalone command-line binary for decoding raw <code>.obuf</code> packets to JSON,
          querying fields with built-in <code>jq</code> filters, and encoding JSON back to wire
          bytes with or without a <code>FileDescriptorSet</code> schema.
        </p>
      </div>

      <div class="bg-[#FAF8F2] border border-ink/15 rounded-lg p-5 sm:p-6 space-y-4">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <div class="flex items-center gap-3.5">
            <svg
              aria-hidden="true"
              viewBox="0 0 100 100"
              class="w-8 h-8 shrink-0"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <rect
                x="6"
                y="12"
                width="88"
                height="76"
                rx="10"
                fill="#16181D"
                stroke="#16181D"
                stroke-width="4"
              />
              <path
                d="M24 38L44 52L24 66"
                stroke="#FF7A4D"
                stroke-width="8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
              <path d="M52 66H76" stroke="#FAF8F2" stroke-width="8" stroke-linecap="round" />
            </svg>
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-ink">Install</h2>
          </div>
          <code class="text-xs font-mono text-ink/65">omnibuf/omnibuf-cli</code>
        </div>

        <div class="space-y-3">
          {cliInstallOptions.map((opt) => (
            <div class="bg-ink text-paper rounded-lg border border-ink/15 overflow-hidden">
              <div class="flex items-center justify-between gap-2 px-3.5 py-2 border-b border-paper/12 text-xs font-mono text-paper/70">
                <span>{opt.label}</span>
                <button
                  type="button"
                  data-copy={opt.command}
                  class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <div class="p-3.5 font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                <Code code={opt.command} lang="sh" theme="github-dark" />
              </div>
            </div>
          ))}
        </div>

        <div class="flex flex-wrap gap-2.5 text-xs sm:text-sm pt-1 no-print">
          <a
            href="https://github.com/omnibuf/omnibuf-cli"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary px-3.5 py-2"
          >
            GitHub Repository &rarr;
          </a>
          <a
            href="https://github.com/omnibuf/omnibuf-cli/releases"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary px-3.5 py-2"
          >
            Release Binaries &rarr;
          </a>
        </div>
      </div>
    </section>

    <section class="pb-12 sm:pb-16 px-4 sm:px-6 max-w-4xl mx-auto space-y-10">
      <!-- 1. Schema-less inspection -->
      <div id="inspect-without-schema" class="scroll-mt-16 pt-8 border-t border-ink/15 space-y-4">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          Schema-less inspection
        </h2>
        <!-- prettier-ignore -->
        <p class="text-base text-ink/85 leading-relaxed max-w-[65ch]">
          Protobuf collapses strings, byte slices, sub-messages, maps, and packed arrays into one wire type, and shares a single varint wire type across booleans, signed integers, and unsigned integers. Hand a raw Protobuf packet to <a href="https://github.com/protocolbuffers/protoscope" target="_blank" rel="noopener noreferrer" class="doc-link"><code>protoscope</code></a> and you end up guessing what half the fields mean. OmniBuf tags every field with an explicit 4-bit wire type, plus element types on arrays and maps. The <code>omnibuf</code> CLI prints the exact booleans, signed numbers, UTF-8 strings, arrays, and maps on the wire, and packets with <strong>Field #0</strong> include their original field names.
        </p>
        <div class="border border-ink/15 rounded-lg overflow-hidden font-mono text-xs sm:text-sm bg-ink text-paper p-4 space-y-4">
          <div>
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
              <span class="font-semibold text-paper/85">$ protoscope packet.pb</span>
              <span class="text-paper/65">Protobuf &middot; guesses types</span>
            </div>
            <pre class="leading-relaxed overflow-x-auto"><code><span class="text-paper/80 font-semibold">1:</span> 1          <span class="text-paper/65"># bool / uint / sint / enum?</span>
<span class="text-paper/80 font-semibold">2:</span> 3          <span class="text-paper/65"># +3 uint or -2 sint?</span>
<span class="text-paper/80 font-semibold">3:</span> &#123;<span class="text-paper/90">"FRA"</span>&#125;    <span class="text-paper/65"># string / bytes / sub-msg?</span>
<span class="text-paper/80 font-semibold">4:</span> <span class="text-paper/90">"\x0a\x14"</span> <span class="text-paper/65"># bytes / string / packed array?</span></code></pre>
          </div>
          <div class="pt-3.5 border-t border-paper/12">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
              <span class="font-semibold text-[#FF7A4D]">$ omnibuf -c packet.obuf</span>
              <span class="text-paper/65">OmniBuf &middot; actual values</span>
            </div>
            <pre class="leading-relaxed overflow-x-auto"><code>&#123;<span class="text-acid">"field_1"</span>: <span class="text-[#FF7A4D] font-semibold">true</span>, <span class="text-acid">"field_2"</span>: -2, <span class="text-acid">"field_3"</span>: <span class="text-acid">"FRA"</span>, <span class="text-acid">"field_4"</span>: [10, 20]&#125;</code></pre>
          </div>
          <div class="pt-3.5 border-t border-paper/12">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 text-xs">
              <span class="font-semibold text-[#FF7A4D]">$ omnibuf -c packet-field0.obuf</span>
              <span class="text-paper/65">
                OmniBuf + Field #0 &middot; actual values &amp; names
              </span>
            </div>
            <pre class="leading-relaxed overflow-x-auto"><code>&#123;<span class="text-acid">"active"</span>: <span class="text-[#FF7A4D] font-semibold">true</span>, <span class="text-acid">"delta"</span>: -2, <span class="text-acid">"city"</span>: <span class="text-acid">"FRA"</span>, <span class="text-acid">"peers"</span>: [10, 20]&#125;</code></pre>
          </div>
        </div>
      </div>

      <!-- 2. jq queries -->
      <div id="jq-queries" class="scroll-mt-16 pt-8 border-t border-ink/12 space-y-4">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">jq queries</h2>
        <p class="text-base text-ink/85 leading-relaxed max-w-[65ch]">
          Pass a <code>jq</code> filter expression as the first argument (or via <code>-q</code> /{' '}
          <code>--query</code> or <code>-f</code> / <code>--filter</code>) to slice, select, or
          reshape decoded fields in a single command. Flags such as <code>-r</code> (raw string
          output) and <code>-c</code> (compact single-line JSON) work the same way as{' '}
          <code>jq</code>. Hex (<code>-x</code>), base64 (<code>-b</code>), and explicit file paths
          (<code>-i</code> / <code>--input</code> and <code>-o</code> / <code>--output</code>) are
          supported directly.
        </p>
        <div class="border border-ink/15 rounded-lg overflow-hidden bg-ink text-paper">
          <div class="flex items-center justify-between gap-2 px-4 py-2 border-b border-paper/12 text-xs font-mono text-paper/70">
            <span>jq filter examples</span>
            <button
              type="button"
              data-copy={jqFilterSnippet}
              class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <div class="font-mono text-xs sm:text-sm p-4 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed [&>pre]:overflow-x-auto">
            <Code code={jqFilterSnippet} lang="sh" theme="github-dark" />
          </div>
        </div>
      </div>

      <!-- 3. JSON conversion -->
      <div id="encode-json" class="scroll-mt-16 pt-8 border-t border-ink/12 space-y-4">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          JSON conversion
        </h2>
        <p class="text-base text-ink/85 leading-relaxed max-w-[65ch]">
          <code>omnibuf</code> auto-detects whether its input is JSON or OmniBuf wire bytes (pass{' '}
          <code>-e</code> / <code>--encode</code> or <code>-d</code> / <code>--decode</code> to
          force a direction). Pipe a JSON object into <code>omnibuf</code> to encode it into a
          self-describing OmniBuf packet with <code>Field #0</code> field names, keeping the JSON
          object's key order for sequential tags. Pass <code>--schema</code> (<code>-s</code>) with
          a compiled <code>FileDescriptorSet</code> to encode or decode against your{' '}
          <code>.proto</code> definitions, with <code>--field0</code> (alias{' '}
          <code>--self-describing</code>) to embed inline field names and{' '}
          <code>--max-schema-bytes</code> (default 64 MiB) to cap descriptor file and decompressed
          size.
        </p>
        <div class="border border-ink/15 rounded-lg overflow-hidden bg-ink text-paper">
          <div class="flex items-center justify-between gap-2 px-4 py-2 border-b border-paper/12 text-xs font-mono text-paper/70">
            <span>Encode &amp; decode examples</span>
            <button
              type="button"
              data-copy={encodeSnippet}
              class="copy-snippet-btn min-w-[4rem] text-center px-2 py-0.5 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
            >
              Copy
            </button>
          </div>
          <div class="font-mono text-xs sm:text-sm p-4 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0! [&>pre]:leading-relaxed [&>pre]:overflow-x-auto">
            <Code code={encodeSnippet} lang="sh" theme="github-dark" />
          </div>
        </div>
      </div>

      <!-- 4. Schemaless type mapping -->
      <div id="json-type-mapping" class="scroll-mt-16 pt-8 border-t border-ink/12 space-y-4">
        <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
          Schemaless type mapping
        </h2>
        <p class="text-base text-ink/85 leading-relaxed max-w-[65ch]">
          Converting JSON without <code>--schema</code> requires a top-level JSON object.{' '}
          <code>omnibuf</code> infers each wire type from the JSON literal and assigns sequential
          field numbers starting at <code>1</code> (keys named <code>field_&lt;N&gt;</code> reserve
          field number <code>N</code> directly). Pass <code>--deterministic</code> to sort keys
          lexicographically before numbering, or <code>--no-field0</code> to omit inline field
          names. Pass <code>--schema descriptors.pb --type pkg.Msg</code> for exact{' '}
          <code>.proto</code> field numbers, 32-bit floats, fixed-width integers, enums, and maps.
        </p>
        <div class="border border-ink/15 rounded-lg overflow-hidden">
          <div class="overflow-x-auto bg-[#FAF8F2]">
            <table class="w-full text-left border-collapse text-sm">
              <thead>
                <tr class="border-b border-ink/15 bg-[#EDE8DC] text-ink/75 text-xs font-mono">
                  <th class="py-2.5 px-3.5 font-semibold">JSON input</th>
                  <th class="py-2.5 px-3.5 font-semibold">Wire type</th>
                  <th class="py-2.5 px-3.5 font-semibold text-right">Tag</th>
                  <th class="py-2.5 px-3.5 font-semibold">Protobuf</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-ink/10 text-ink">
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Boolean</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">true, false</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireBoolFalse / WireBoolTrue
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums whitespace-nowrap">
                    2, 3
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    bool
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Unsigned integer</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">0 .. 2^64-1</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireUint
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    0
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    uint32 / uint64
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Negative integer</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">-2^63 .. -1</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireSint
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    1
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    sint32 / sint64
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Decimal or exponent</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">3.14, 1e9, &gt;64-bit</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireFloat64
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    9
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    double
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">String</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">&quot;FRA&quot;</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireString
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    10
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    string
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Base64 string</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">&quot;base64:...&quot;</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireBytes
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    11
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    bytes
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Nested object</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">&#123;...&#125;</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireSubMsg
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    12
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    message
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Array</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">[...]</span>
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm whitespace-nowrap">
                    WireArray
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/65 text-right tabular-nums">
                    13
                  </td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/80 whitespace-nowrap">
                    repeated T
                  </td>
                </tr>
                <tr>
                  <td class="py-2.5 px-3.5">
                    <span class="font-medium">Null</span>
                    <span class="font-mono text-xs text-ink/65 ml-2">null</span>
                  </td>
                  <td class="py-2.5 px-3.5 text-ink/65">Omitted</td>
                  <td class="py-2.5 px-3.5 font-mono text-xs text-ink/50 text-right">&ndash;</td>
                  <td class="py-2.5 px-3.5 font-mono text-xs sm:text-sm text-ink/65">unset</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
        <div class="text-sm text-ink/80 leading-relaxed max-w-[65ch] space-y-1.5">
          <p class="font-medium text-ink">Array rules</p>
          <ul class="list-disc pl-5 space-y-1">
            <li>
              Numeric arrays widen to fit all elements: <code>WireUint</code> &rarr;{' '}
              <code>WireSint</code> &rarr; <code>WireFloat64</code>.
            </li>
            <li>
              Arrays where every element is a valid <code>"base64:..."</code> string encode as a{' '}
              <code>WireBytes</code> array.
            </li>
            <li>
              Object arrays share a single field table. Nested and empty arrays are supported,{' '}
              <code>null</code> elements are skipped, and mixed incompatible types return an error.
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
