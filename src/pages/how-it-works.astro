---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Capabilities from '../components/Capabilities.astro';
import Comparisons from '../components/Comparisons.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import Footer from '../components/Footer.astro';

interface WireTypeRow {
  ids: string;
  title: string;
  protoTypes: string;
  onTheWire: string;
}

const wireTypeRows: WireTypeRow[] = [
  {
    ids: '0, 1',
    title: 'Dynamic Ints',
    protoTypes: 'uint32, uint64, int32, int64, sint32, sint64, enum',
    onTheWire: '[Value: Prefix-Varint] (0 = unsigned, 1 = ZigZag)',
  },
  {
    ids: '2, 3',
    title: 'Booleans',
    protoTypes: 'bool',
    onTheWire: '0 bytes (2 = false, 3 = true in tag)',
  },
  {
    ids: '4..9',
    title: 'Fixed Numbers',
    protoTypes: 'fixed32/64, sfixed32/64, float, double',
    onTheWire: '4B or 8B little-endian (uint, sint, IEEE-754)',
  },
  {
    ids: '10..12',
    title: 'Length-Prefixed',
    protoTypes: 'string, bytes, message',
    onTheWire: '[ByteLen][UTF-8 | Bytes | SubMsg]',
  },
  {
    ids: '13',
    title: 'Arrays',
    protoTypes: 'repeated T',
    onTheWire: '[ByteLen][ElemType: 1B][Count][Elem_0..N]',
  },
  {
    ids: '14',
    title: 'Maps',
    protoTypes: 'map<K, V>',
    onTheWire: '[ByteLen][KeyType: 1B][ValType: 1B][Count][K_0, V_0..]',
  },
  {
    ids: '15',
    title: 'Extended',
    protoTypes: 'extensions',
    onTheWire: '[ByteLen][ExtType: 1B][Payload]',
  },
];
---

<Layout
  title="How It Works | OmniBuf"
  description="How the OmniBuf binary wire format works: flat [Tag][Value] streams, Prefix-Varints, 4-bit wire types, single-pass length prefixes, and format comparisons."
>
  <Navbar currentPage="how-it-works" />

  <main id="main-content">
    <!-- Page Header -->
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        How OmniBuf <span class="text-[#FF4F18]">works on the wire</span>
      </h1>
      <p class="mt-4 max-w-[65ch] text-base sm:text-lg text-ink/80 leading-relaxed">
        An OmniBuf message is just a flat stream of <code>[Tag][Value]</code> fields. There's no
        file header, no footer, and no offset table at the front of the packet.
      </p>
    </section>

    <!-- Binary Format Anatomy -->
    <section id="wire-format" class="pb-12 sm:pb-16 px-4 sm:px-6 max-w-6xl mx-auto space-y-10">
      <div class="border-t border-ink/15 pt-8 sm:pt-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <div class="lg:col-span-5 space-y-3.5 min-w-0">
          <h2 class="text-2xl sm:text-[1.75rem] font-bold tracking-tight text-ink">
            Anatomy of a packet
          </h2>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
            Fields go on the wire back-to-back as <code>[Tag][Value]</code> pairs: an empty message
            is 0 bytes, and concatenating two buffers merges them just as Protobuf does. Each tag is
            a Prefix-Varint with the field number in the upper bits and a{' '}
            <strong>4-bit wire type (0..15)</strong> in the bottom 4 bits:
          </p>
          <div class="p-3.5 bg-[#FAF8F2] border border-ink/15 rounded-lg font-mono space-y-1">
            <div class="text-sm font-semibold">Tag = (FieldNumber &lt;&lt; 4) | WireType</div>
            <div class="text-xs text-ink/70">
              1-byte Prefix-Varints encode <code>x</code> as <code>(x &lt;&lt; 1) | 1</code>, so
              Field #1 (<code>0x10</code>) is <code>0x21</code> on the wire and value <code>1</code>{' '}
              is <code>0x03</code>.
            </div>
          </div>
          <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
            The low 4 bits of each tag carry both the data type and how to size the value. Booleans
            take 0 value bytes (<code>2</code> = false, <code>3</code> = true). Integers and floats
            use a 1/2/4/9-byte Prefix-Varint or a fixed 4/8-byte word; strings, bytes, sub-messages,
            arrays, and maps start with a <code>ByteLen</code> Prefix-Varint.
          </p>
        </div>

        <!-- Concrete Wire Breakdown Example -->
        <div class="lg:col-span-7 min-w-0 select-none">
          <div class="os-window overflow-hidden">
            <div class="os-titlebar">
              <span class="font-mono text-xs sm:text-sm font-semibold text-ink/80">
                Example packet on the wire (8 bytes)
              </span>
            </div>
            <div class="p-4 sm:p-5 bg-ink text-paper font-mono text-xs sm:text-sm space-y-4">
              <!-- Protoscope-style message + contiguous wire bytes -->
              <div class="grid sm:grid-cols-2 gap-3">
                <div class="bg-[#1F232B] p-3 rounded-md border border-paper/12">
                  <div class="text-[11px] text-paper/60 font-semibold mb-1.5">
                    Message (Protoscope)
                  </div>
                  <pre class="text-xs sm:text-sm leading-relaxed text-paper overflow-x-auto"><code>1: 1       <span class="text-paper/50"># id (uint)</span>
2: "FRA"   <span class="text-paper/50"># city (string)</span>
3: true    <span class="text-paper/50"># active (bool)</span></code></pre>
                </div>

                <div class="bg-[#1F232B] p-3 rounded-md border border-paper/12 flex flex-col justify-between">
                  <div>
                    <div class="text-[11px] text-paper/60 font-semibold mb-1.5">
                      Wire stream (8 bytes)
                    </div>
                    <div class="text-sm sm:text-base font-semibold text-acid tracking-wide leading-relaxed">
                      21 03 55 07 46 52 41 67
                    </div>
                  </div>
                  <div class="flex flex-wrap items-center gap-3 pt-2 mt-2 border-t border-paper/10 text-[11px] text-paper/75">
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-sm bg-[#b7e48a] inline-block"></span>
                      Tag
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-sm bg-[#FF4F18] inline-block"></span>
                      Length
                    </span>
                    <span class="inline-flex items-center gap-1.5">
                      <span class="w-2.5 h-2.5 rounded-sm bg-paper/25 border border-paper/40 inline-block"></span>
                      Value
                    </span>
                  </div>
                </div>
              </div>

              <!-- Compact 3-row field breakdown -->
              <div class="bg-[#1F232B] rounded-md border border-paper/12 divide-y divide-paper/10">
                <!-- Field 1 -->
                <div class="grid sm:grid-cols-12 gap-2 items-center px-3 py-2.5">
                  <div class="sm:col-span-3 font-semibold text-paper">#1 id</div>
                  <div class="sm:col-span-4 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 bg-[#b7e48a] text-[#111111] font-semibold rounded">
                      21
                    </span>
                    <span class="px-1.5 py-0.5 bg-paper/15 text-paper font-semibold rounded border border-paper/25">
                      03
                    </span>
                  </div>
                  <div class="sm:col-span-5 text-paper/75 text-xs">
                    WireUint (0) &middot; value = 1
                  </div>
                </div>

                <!-- Field 2 -->
                <div class="grid sm:grid-cols-12 gap-2 items-center px-3 py-2.5">
                  <div class="sm:col-span-3 font-semibold text-paper">#2 city</div>
                  <div class="sm:col-span-4 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 bg-[#b7e48a] text-[#111111] font-semibold rounded">
                      55
                    </span>
                    <span class="px-1.5 py-0.5 bg-[#FF4F18] text-white font-semibold rounded">
                      07
                    </span>
                    <span class="px-1.5 py-0.5 bg-paper/15 text-paper font-semibold rounded border border-paper/25">
                      46 52 41
                    </span>
                  </div>
                  <div class="sm:col-span-5 text-paper/75 text-xs">
                    WireString (10) &middot; len = 3 &middot; "FRA"
                  </div>
                </div>

                <!-- Field 3 -->
                <div class="grid sm:grid-cols-12 gap-2 items-center px-3 py-2.5">
                  <div class="sm:col-span-3 font-semibold text-paper">#3 active</div>
                  <div class="sm:col-span-4 flex items-center gap-1.5">
                    <span class="px-1.5 py-0.5 bg-[#b7e48a] text-[#111111] font-semibold rounded">
                      67
                    </span>
                  </div>
                  <div class="sm:col-span-5 text-paper/75 text-xs">
                    WireBoolTrue (3) &middot; 0 value bytes
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Full-Width Grouped Wire Type Reference (0..15) -->
      <div id="wire-types" class="pt-6 sm:pt-8 space-y-5 scroll-mt-16">
        <div class="flex flex-wrap items-baseline justify-between gap-4">
          <div class="max-w-3xl">
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink">The 16 wire types</h3>
          </div>
          <a href="/spec#sec-6" class="doc-link text-sm">
            Section 6 of the spec &rarr;
          </a>
        </div>

        <div class="overflow-x-auto border border-ink/15 rounded-lg bg-[#FAF8F2]">
          <table class="w-full text-left border-collapse text-sm sm:text-base">
            <thead>
              <tr class="border-b border-ink/15 bg-[#EDE8DC] font-mono text-xs text-ink/75">
                <th class="px-4 py-3 font-semibold">Wire Type</th>
                <th class="px-4 py-3 font-semibold">Schema Types</th>
                <th class="px-4 py-3 font-semibold">On the Wire</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-ink/10">
              {wireTypeRows.map((row, idx) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-[#FAF8F2]'}>
                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class="font-mono font-semibold text-ink">{row.ids}</span>
                    <span class="text-ink/75 ml-2 font-medium">{row.title}</span>
                  </td>
                  <td class="px-4 py-3 font-mono text-xs sm:text-sm text-ink/80">
                    {row.protoTypes}
                  </td>
                  <td class="px-4 py-3 text-ink/85">{row.onTheWire}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <HowItWorks />
    <Capabilities />
    <Comparisons />
    <LanguageStrip currentPage="how-it-works" />
  </main>

  <Footer />
</Layout>
