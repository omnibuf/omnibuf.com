---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const zigZagGoCode = `// Encode signed int64 -> unsigned uint64:
u := uint64((n << 1) ^ (n >> 63))

// Decode unsigned uint64 -> signed int64:
n := int64(u >> 1) ^ -int64(u & 1)`;

const sec8MetaProtoCode = `syntax = "proto3";
package omnibuf.v1;

// Written at Field #0 (Tag = 0x19, WireSubMsg = 12) when self-describing mode is enabled.
message SchemaMeta {
  string type_name = 1;               // Optional message name (e.g. "Location")
  map<uint32, string> fields = 2;     // FieldNumber -> FieldName (e.g. 3 -> "city")
  map<uint32, SchemaMeta> children = 3; // Parent FieldNumber -> child SchemaMeta (stored once)
}`;

const sec9ProtoCode = `message Location {
  string city = 3; // "FRA"
  uint32 rack = 4; // 42
}

message Node {
  uint32   id       = 1; // 300
  bool     active   = 3; // true
  Location location = 9; // { city: "FRA", rack: 42 }
}`;

const wireTypes = [
  [0, 'WireUint', '[Value: Prefix-Varint] (uint)'],
  [1, 'WireSint', '[ZigZag Value: Prefix-Varint] (sint)'],
  [2, 'WireBoolFalse', '0B in tag (0x00 in collections)'],
  [3, 'WireBoolTrue', '0B in tag (invalid in collections)'],
  [4, 'WireFixed32', '4B LE uint32'],
  [5, 'WireFixed64', '8B LE uint64'],
  [6, 'WireSfixed32', '4B LE int32'],
  [7, 'WireSfixed64', '8B LE int64'],
  [8, 'WireFloat32', '4B LE IEEE-754 binary32'],
  [9, 'WireFloat64', '8B LE IEEE-754 binary64'],
  [10, 'WireString', '[ByteLen][UTF-8 bytes]'],
  [11, 'WireBytes', '[ByteLen][Raw bytes]'],
  [12, 'WireSubMsg', '[ByteLen][FieldStream]'],
  [13, 'WireArray', '[ByteLen][ElementType: 1B][Count][Elements]'],
  [14, 'WireMap', '[ByteLen][KeyType: 1B][ValueType: 1B][Count][Entries]'],
  [15, 'WireExtended', '[ByteLen][ExtType: 1B][Payload]'],
];

const arrayExamples = `// Field #7: array<string> ["a", "bc"]
fb 1e 00 0a 05 03 61 05 62 63
// tag | len=7 | string | count=2 | "a" | "bc"

// Field #8: array<uint> [10, 300]
36 02 16 00 00 05 15 b2 04
// tag   | len=5 | uint | count=2 | 10 | 300

// Field #1: array<bool> [false, true]
3b 12 00 02 05 00 01
// tag | len=4 | bool | count=2 | false | true

// Field #1: empty array<bytes>
3b 0a 00 0b 01
// tag | len=2 | bytes | count=0`;

const nestedArrayExample = `// Field #1: array<array> [[1, 2], [300]]
3b          // field #1, WireArray
32 00       // outer ByteLen = 12
0d 05       // ElementType = WireArray, Count = 2
09 00 05 03 05 // inner ByteLen=4, uint, Count=2, 1, 2
09 00 03 b2 04 // inner ByteLen=4, uint, Count=1, 300`;

const mapExample = `// Field #2: map<string, uint> {"a": 7, "b": 300}
5d 2a 00 0a 00 05 03 61 0f 03 62 b2 04
// tag | len=10 | key=string | val=uint | count=2 | "a":7 | "b":300`;

const fixedExamples = `// Field #1: fixed32 integer 42
29 2a 00 00 00

// Field #1: sfixed32 integer -42
2d d6 ff ff ff

// Field #1: float32 number 42.0
31 00 00 28 42`;

const nodeExample = `21 b2 04                  // #1 uint: id = 300
67                        // #3 bool: active = true
72 02 1e 00               // #9 message: location, ByteLen = 7
  75 07 46 52 41          // #3 string: city = "FRA"
  81 55                   // #4 uint: rack = 42`;

const sec11ConformanceProtoCode = `syntax = "proto3";
package omnibuf.conformance;

enum WireFormat {
  WIRE_FORMAT_UNSPECIFIED = 0;
  WIRE_FORMAT_OMNIBUF = 1;
  WIRE_FORMAT_JSON = 2;
}

enum TestTier {
  TEST_TIER_UNSPECIFIED = 0;
  TEST_TIER_PLUGIN = 1;           // Generated code from protoc-gen-omnibuf-* plugin
  TEST_TIER_PROTOBUF_TYPES = 2;   // Standard Protobuf descriptors / generated types
  TEST_TIER_ANNOTATED_STRUCT = 3; // Native structs, classes, or declarative schemas
  TEST_TIER_BLIND = 4;            // Schema-less inspection (DecodeBlind)
}

// Prefixed by a 4-byte little-endian uint32 byte length on stdin.
message ConformanceRequest {
  string test_name = 1;
  string message_type = 2;
  TestTier tier = 3;
  WireFormat requested_output_format = 4;
  bytes omnibuf_payload = 5;
  string json_payload = 6;
  bool self_describing = 7;
  bool test_opaque_splice = 8;
  bool test_opaque_splice_shrink = 9;
}

// Prefixed by a 4-byte little-endian uint32 byte length on stdout.
message ConformanceResponse {
  string parse_error = 1;
  string serialize_error = 2;
  string runtime_error = 3;
  string skipped = 4;
  bytes omnibuf_payload = 5;
  string json_payload = 6;
}`;

const sectionTitles = [
  'Design Goals & Overview',
  'Message Layout & Concatenation',
  'Prefix-Varint Encoding',
  'Signed Integers',
  'Field Tags & Value Types',
  'Wire Type Specifications',
  'Field Lookup & Validation',
  'Optional Naming Metadata',
  'Complete Message Example',
  'Validity & Rejection Rules',
  'Schema Mapping & Conformance',
];
const subsectionTitles: Record<number, string[]> = {
  1: ['Design Goals', 'Core Wire Primitives'],
  3: ['Bit-Level Layout', 'Examples & Size Tradeoffs', 'Non-Minimal Encodings & Backpatching'],
  4: ['ZigZag Mapping', 'Examples'],
  5: ['Tag Width'],
  6: [
    'Variable-Width Integers (0..1)',
    'Booleans (2..3)',
    'Fixed-Width Numbers (4..9)',
    'Strings, Bytes & Submessages (10..12)',
    'WireArray (13)',
    'WireMap (14)',
    'WireExtended (15)',
  ],
  8: ['SchemaMeta Definition', 'Placement, Inheritance & Merge'],
  11: ['Schema Mapping', 'Conformance Runner & Client Protocol', 'Conformance Test Coverage'],
};
const tocSections = sectionTitles.map((title, index) => ({
  id: `sec-${index + 1}`,
  label: `${index + 1}. ${title}`,
  children: (subsectionTitles[index + 1] ?? []).map((subtitle, childIndex) => ({
    id: `sec-${index + 1}-${childIndex + 1}`,
    label: `${index + 1}.${childIndex + 1} ${subtitle}`,
  })),
}));
---

<Layout
  title="Wire Format Specification (v0.1) | OmniBuf"
  description="OmniBuf v0.1 wire-format draft: precise scalar types, composable arrays and maps, prefix-varints, recursive merge rules, validation, and annotated byte examples."
>
  <Navbar currentPage="spec" />

  <main id="main-content" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Spec Header -->
    <div class="mb-12">
      <div class="mb-5">
        <span class="inline-flex items-center gap-2.5 px-3.5 py-1.5 bg-ink text-acid font-mono text-xs sm:text-sm font-bold uppercase tracking-wider rounded border-2 border-ink shadow-[2px_2px_0px_#111]">
          <span class="w-2.5 h-2.5 rounded-full bg-[#FF4F18] inline-block shrink-0"></span>
          <span>Version 0.1 (Draft)</span>
        </span>
      </div>
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight uppercase leading-[0.94] text-ink">
        Wire Format
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          Specification v0.1.
        </span>
      </h1>
      <p class="mt-6 max-w-3xl text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
        The byte-level encoding rules for Prefix-Varints, field tags, scalars, containers, Field #0
        metadata, and cross-language conformance.
      </p>
    </div>

    <!-- Sticky Mobile Section Jump Bar (< lg viewports) -->
    <div class="lg:hidden sticky top-14 z-30 mb-6 flex items-start gap-2 font-mono text-sm no-print select-none">
      <details id="mobile-spec-toc" class="flex-1 os-window bg-[#FAF8F2]">
        <summary class="px-4 py-2.5 font-bold uppercase cursor-pointer focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-ink">
          <span id="mobile-spec-toc-label">Jump to Spec Section</span>
        </summary>
        <nav
          aria-label="Mobile specification sections"
          class="p-3 border-t-2 border-ink space-y-1 max-h-64 overflow-y-auto"
        >
          {tocSections.map((sec) => (
            <div>
              <a
                href={`#${sec.id}`}
                data-mobile-spec-link={sec.id}
                data-active="false"
                class="block px-2.5 py-1.5 rounded font-bold hover:bg-ink/5 data-[active=true]:bg-acid data-[active=true]:text-ink"
              >
                {sec.label}
              </a>
              {sec.children.length > 0 && (
                <div class="pl-3 ml-2.5 mt-0.5 mb-1 space-y-0.5 border-l-2 border-ink/25">
                  {sec.children.map((sub) => (
                    <a
                      href={`#${sub.id}`}
                      data-mobile-spec-link={sub.id}
                      data-active="false"
                      class="block px-2 py-1 rounded text-xs text-ink/80 hover:text-ink hover:bg-ink/5 data-[active=true]:bg-acid/40 data-[active=true]:text-ink data-[active=true]:font-bold"
                    >
                      {sub.label}
                    </a>
                  ))}
                </div>
              )}
            </div>
          ))}
        </nav>
      </details>
      <a
        href="#main-content"
        class="os-btn px-3 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md shrink-0"
      >
        Top &uarr;
      </a>
    </div>

    <div class="grid lg:grid-cols-12 gap-8 items-start">
      <!-- Left Sticky Table of Contents -->
      <aside class="hidden lg:block lg:col-span-3 lg:sticky lg:top-16 no-print select-none">
        <div class="os-window bg-[#FAF8F2] p-4 lg:max-h-[calc(100vh-5.5rem)] lg:overflow-y-auto">
          <div class="font-mono text-sm font-bold uppercase pb-2.5 mb-2.5 border-b-2 border-ink flex items-center justify-between gap-2">
            <span>Contents</span>
            <a
              href="#main-content"
              class="text-xs px-2 py-0.5 bg-white border border-ink rounded hover:bg-acid transition shrink-0 whitespace-nowrap"
            >
              Top &uarr;
            </a>
          </div>
          <nav aria-label="Specification sections" class="space-y-1 font-mono text-sm">
            {tocSections.map((sec) => (
              <div>
                <a
                  href={`#${sec.id}`}
                  data-spec-link={sec.id}
                  data-active="false"
                  class="block px-2.5 py-1.5 rounded border border-transparent hover:bg-ink/5 transition data-[active=true]:bg-acid data-[active=true]:border-ink data-[active=true]:font-bold"
                >
                  {sec.label}
                </a>
                {sec.children.length > 0 && (
                  <div
                    data-subtoc={sec.id}
                    class:list={[
                      'pl-3 ml-2.5 mt-1 mb-1.5 space-y-1 border-l-2 border-ink/25',
                      sec.id === 'sec-6' ? 'block' : 'hidden',
                    ]}
                  >
                    {sec.children.map((sub) => (
                      <a
                        href={`#${sub.id}`}
                        data-spec-h3={sub.id}
                        data-active="false"
                        class="block px-2 py-1 rounded text-xs sm:text-sm text-ink/80 hover:text-ink hover:bg-ink/5 transition data-[active=true]:text-ink data-[active=true]:font-bold data-[active=true]:bg-acid/40"
                      >
                        {sub.label}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </nav>
        </div>
      </aside>

      <!-- Main Specification Document Sheet -->
      <article class="lg:col-span-9 min-w-0 os-window-lg bg-[#FAF8F2] p-6 sm:p-10 lg:p-12 spec-prose">
        <h2 id="sec-1">1. Design Goals &amp; Overview</h2>
        <h3 id="sec-1-1">1.1 Design Goals</h3>
        <p>OmniBuf v0.1 is a binary wire format for numbered fields:</p>
        <ul>
          <li>
            Keep Protobuf field numbers so existing <code>.proto</code> schemas map directly onto
            the wire.
          </li>
          <li>
            Give UTF-8 strings, raw bytes, signed/unsigned ints, fixed-width ints, and IEEE-754
            floats distinct wire codes so raw packets decode cleanly with no external schema.
          </li>
          <li>
            Encode all lists with <code>WireArray</code> (1-byte <code>ElementType</code> +{' '}
            <code>Count</code>) and all maps with <code>WireMap</code> (1-byte <code>KeyType</code>{' '}
            + <code>ValueType</code> + <code>Count</code>), including nested collections.
          </li>
          <li>
            Prefix every container with its byte length so encoders can write messages in a single
            forward pass and readers can merge packets by byte concatenation.
          </li>
        </ul>
        <h3 id="sec-1-2">1.2 Core Wire Primitives</h3>
        <p>
          Fields are written back-to-back as <code>[Tag][Value]</code> pairs. Field tags,
          variable-width integers, byte lengths, and collection counts all use Prefix-Varints;
          fixed-width words are little-endian. Each tag packs{' '}
          <code>(FieldNumber &lt;&lt; 4) | WireType</code>.
        </p>
        <p>
          A wire type code describes the physical bytes on the wire (for example, signed enums and
          signed integers both use <code>WireSint = 1</code>), whereas schema-level details like
          field names, enum labels, 32-bit vs. 64-bit bounds, defaults, and <code>oneof</code>{' '}
          groups live in the caller's schema or in optional Field #0 metadata.
        </p>

        <h2 id="sec-2">2. Message Layout &amp; Concatenation</h2>
        <pre><code>[Tag][Value] [Tag][Value] ... [Tag][Value]</code></pre>
        <p>
          Root messages have no framing header, footer, padding, or outer length prefix (an empty
          message is 0 bytes, so the outer transport or file format supplies the packet boundary).
          Encoders SHOULD emit fields in ascending field-number order, while decoders MUST accept
          fields in any order and merge repeated occurrences under concatenation:
        </p>
        <ul>
          <li>
            <strong>Scalars:</strong> last occurrence wins.
          </li>
          <li>
            <strong>Arrays:</strong> elements append in wire order (an empty array adds 0 items and
            does not clear prior elements).
          </li>
          <li>
            <strong>Submessages:</strong> inner fields merge recursively, including nested arrays
            and maps.
          </li>
          <li>
            <strong>Maps:</strong> entries merge in wire order; a duplicate key replaces the prior
            value for that key outright, even for submessage, array, or map values.
          </li>
        </ul>
        <p>
          Schema-aware decoders apply <code>oneof</code> and explicit-presence rules from their
          schema (a blind reader cannot infer <code>oneof</code> groups), and changing a field's
          wire type or an array's <code>ElementType</code> is a breaking wire change.
        </p>

        <h2 id="sec-3">3. Prefix-Varint Encoding</h2>
        <h3 id="sec-3-1">3.1 Bit-Level Layout</h3>
        <p>
          The first byte determines the encoded width. An implementation can dispatch with bit tests
          or a trailing-zero-count instruction, and the format does not require a particular
          instruction or a branchless implementation.
        </p>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>First byte</th>
                <th>Total width</th>
                <th>Value capacity</th>
                <th>Encoding</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <code>xxxxxxx1</code>
                </td>
                <td>1 byte</td>
                <td>7 bits</td>
                <td>
                  <code>(v &lt;&lt; 1) | 1</code>
                </td>
              </tr>
              <tr>
                <td>
                  <code>xxxxxx10</code>
                </td>
                <td>2 bytes</td>
                <td>14 bits</td>
                <td>
                  <code>LE16((v &lt;&lt; 2) | 2)</code>
                </td>
              </tr>
              <tr>
                <td>
                  <code>xxxxx100</code>
                </td>
                <td>4 bytes</td>
                <td>29 bits</td>
                <td>
                  <code>LE32((v &lt;&lt; 3) | 4)</code>
                </td>
              </tr>
              <tr>
                <td>
                  <code>00000000</code>
                </td>
                <td>9 bytes</td>
                <td>64 bits</td>
                <td>
                  <code>00 + LE64(v)</code>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Decode the first three forms by loading the indicated little-endian word and shifting
          right by 1, 2, or 3 bits. The nine-byte form stores its value in bytes 1 through 8. Other
          first-byte patterns with their low three bits zero are reserved and MUST be rejected. A
          decoder MUST check the available width before loading.
        </p>
        <h3 id="sec-3-2">3.2 Examples &amp; Size Tradeoffs</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Unsigned value</th>
                <th>OmniBuf hex</th>
                <th>OmniBuf bytes</th>
                <th>LEB128 bytes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0</td>
                <td>
                  <code>01</code>
                </td>
                <td>1</td>
                <td>1</td>
              </tr>
              <tr>
                <td>127</td>
                <td>
                  <code>ff</code>
                </td>
                <td>1</td>
                <td>1</td>
              </tr>
              <tr>
                <td>128</td>
                <td>
                  <code>02 02</code>
                </td>
                <td>2</td>
                <td>2</td>
              </tr>
              <tr>
                <td>300</td>
                <td>
                  <code>b2 04</code>
                </td>
                <td>2</td>
                <td>2</td>
              </tr>
              <tr>
                <td>16,384</td>
                <td>
                  <code>04 00 02 00</code>
                </td>
                <td>4</td>
                <td>3</td>
              </tr>
              <tr>
                <td>536,870,912</td>
                <td>
                  <code>00 00 00 00 20 00 00 00 00</code>
                </td>
                <td>9</td>
                <td>5</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Only 1-, 2-, 4-, and 9-byte widths exist so every value loads as a standard 1-, 2-, 4-, or
          8-byte CPU word. Numbers that would fit in 3, 5, 6, 7, or 8 bytes under LEB128 round up to
          the next width, and values at or above 2<sup>29</sup> always take 9 bytes.
        </p>
        <h3 id="sec-3-3">3.3 Non-Minimal Encodings &amp; Backpatching</h3>
        <p>
          Decoders MUST accept a value encoded in any of the four widths that can hold it, even when
          a narrower width would fit. Encoders SHOULD pick the shortest width except when reserving
          a wider header slot for single-pass backpatching. For example, <code>42</code> is valid as
          1-byte <code>55</code> or 2-byte <code>aa 00</code>.
        </p>
        <p>
          During single-pass forward encoding, an encoder can reserve a 2-byte Prefix-Varint slot
          for a container's byte length, serialize the body right after it, and then patch{' '}
          <code>LE16((byteLen &lt;&lt; 2) | 2)</code> into the reserved slot. A 2-byte slot covers
          up to 16,383 bytes; if the body grows past that, the encoder widens the length header to 4
          or 9 bytes and shifts the written body forward by 2 or 7 bytes.
        </p>
        <p>
          Encoders may pick different Prefix-Varint widths for backpatched lengths, emit fields in
          different orders, or iterate maps in arbitrary order. Consequently, OmniBuf wire output is
          not byte-for-byte canonical.
        </p>

        <h2 id="sec-4">4. Signed Integers</h2>
        <h3 id="sec-4-1">4.1 ZigZag Mapping</h3>
        <p>
          <code>WireSint</code> stores a ZigZag-mapped signed integer as a Prefix-Varint. Protobuf
          <code>int32</code>, <code>int64</code>, <code>sint32</code>, <code>sint64</code>, and enum
          numbers use this type. Negative enum values retain their sign.
        </p>
        <Code code={zigZagGoCode} lang="go" />
        <h3 id="sec-4-2">4.2 Examples</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Signed value</th>
                <th>ZigZag value</th>
                <th>Hex</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0</td>
                <td>0</td>
                <td>
                  <code>01</code>
                </td>
              </tr>
              <tr>
                <td>-1</td>
                <td>1</td>
                <td>
                  <code>03</code>
                </td>
              </tr>
              <tr>
                <td>1</td>
                <td>2</td>
                <td>
                  <code>05</code>
                </td>
              </tr>
              <tr>
                <td>-64</td>
                <td>127</td>
                <td>
                  <code>ff</code>
                </td>
              </tr>
              <tr>
                <td>64</td>
                <td>128</td>
                <td>
                  <code>02 02</code>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Signed fixed-width integers use <code>WireSfixed32</code> or <code>WireSfixed64</code>
          and two's-complement bits, without ZigZag.
        </p>

        <h2 id="sec-5">5. Field Tags &amp; Value Types</h2>
        <pre><code>Tag = (FieldNumber &lt;&lt; 4) | WireType</code></pre>
        <p>
          Encode Tag as a Prefix-Varint. Field numbers range from 1 through 536,870,911, while Field
          #0 is reserved for naming metadata. Protobuf-backed schemas retain protobuf's
          reserved-field-number rules. Implementations MUST reject out-of-range tags before
          narrowing them to a language integer type.
        </p>
        <h3 id="sec-5-1">5.1 Tag Width</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field numbers</th>
                <th>Minimum tag width</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>0 to 7</td>
                <td>1 byte</td>
              </tr>
              <tr>
                <td>8 to 1,023</td>
                <td>2 bytes</td>
              </tr>
              <tr>
                <td>1,024 to 33,554,431</td>
                <td>4 bytes</td>
              </tr>
              <tr>
                <td>33,554,432 to 536,870,911</td>
                <td>9 bytes</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Array elements and map keys/values reuse the same 4-bit codes without per-item field tags
          (variable-length items keep their <code>ByteLen</code> prefix; booleans use code{' '}
          <code>2</code> + 1 byte inside collections).
        </p>

        <h2 id="sec-6">6. Wire Type Specifications</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Code</th>
                <th>Type</th>
                <th>Field payload</th>
              </tr>
            </thead>
            <tbody>
              {wireTypes.map(([code, name, payload]) => (
                <tr>
                  <td>{code}</td>
                  <td>
                    <code>{name}</code>
                  </td>
                  <td>{payload}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <h3 id="sec-6-1">6.1 Variable-Width Integers (0..1)</h3>
        <pre><code>WireUint (0): [Value: Prefix-Varint]
WireSint (1): [ZigZag Value: Prefix-Varint]</code></pre>
        <p>
          <code>WireUint = 0</code> encodes an unsigned integer up to 64 bits wide (
          <code>uint32</code> and <code>uint64</code>). <code>WireSint = 1</code> encodes a
          ZigZag-mapped signed integer (<code>int32</code>, <code>int64</code>, <code>sint32</code>,{' '}
          <code>sint64</code>, and enums).
        </p>

        <h3 id="sec-6-2">6.2 Booleans (2..3)</h3>
        <p>
          In a field tag, <code>WireBoolFalse = 2</code> and <code>WireBoolTrue = 3</code> put the
          boolean value directly in the low four bits of the tag and write zero payload bytes.
        </p>
        <p>
          Inside an array or map header, code <code>2</code> is the boolean type code, and each
          element or key/value entry is one raw byte (<code>00</code> = false, <code>01</code> =
          true; any other byte MUST be rejected). Code <code>3</code> is valid only on field tags
          and MUST be rejected as an array <code>ElementType</code> or map <code>KeyType</code> /{' '}
          <code>ValueType</code>.
        </p>

        <h3 id="sec-6-3">6.3 Fixed-Width Numbers (4..9)</h3>
        <pre><code>WireFixed32  (4): [4B uint32, little-endian]
WireFixed64  (5): [8B uint64, little-endian]
WireSfixed32 (6): [4B int32, two's-complement little-endian]
WireSfixed64 (7): [8B int64, two's-complement little-endian]
WireFloat32  (8): [4B IEEE-754 binary32, little-endian]
WireFloat64  (9): [8B IEEE-754 binary64, little-endian]</code></pre>
        <p>
          Unsigned fixed integers (<code>4</code>, <code>5</code>), signed two's-complement fixed
          integers (<code>6</code>, <code>7</code>), and IEEE-754 floats (<code>8</code>,{' '}
          <code>9</code>) each have distinct wire codes so 4-byte and 8-byte values are never
          ambiguous on the wire. Signed zero, infinities, and NaN bit patterns are valid in{' '}
          <code>WireFloat32</code> and <code>WireFloat64</code>.
        </p>
        <Code code={fixedExamples} lang="text" />

        <h3 id="sec-6-4">6.4 Strings, Bytes &amp; Submessages (10..12)</h3>
        <pre><code>WireString (10): [ByteLen: Prefix-Varint][UTF-8 bytes]
WireBytes  (11): [ByteLen: Prefix-Varint][Raw bytes]
WireSubMsg (12): [ByteLen: Prefix-Varint][Message field stream]</code></pre>
        <p>
          <code>WireString = 10</code> carries UTF-8 text with no null terminator (invalid UTF-8
          MUST be rejected). <code>WireBytes = 11</code> carries arbitrary raw bytes.{' '}
          <code>WireSubMsg = 12</code> carries a nested field stream whose inner fields follow the
          same layout as root fields; a zero-length payload represents a present, empty submessage.
        </p>

        <h3 id="sec-6-5">6.5 WireArray (13)</h3>
        <pre><code>[Tag: WireArray]
[ByteLen: Prefix-Varint][ElementType: 1 byte][Count: Prefix-Varint][Element_0]…[Element_N-1]
                       |&lt;------------------- ByteLen bytes -----------------------------&gt;|</code></pre>
        <p>
          Every array uses <code>WireArray = 13</code>. One <code>ElementType</code> byte precedes{' '}
          <code>Count</code>, and all elements follow back-to-back with no per-element field tags.{' '}
          <code>ByteLen</code> covers <code>ElementType</code>, <code>Count</code>, and the encoded
          elements.
        </p>
        <ul>
          <li>
            <code>ElementType</code> is a 1-byte wire type code whose upper four bits MUST be zero.
            Code <code>3</code> is invalid here; boolean arrays always use code <code>2</code>.
          </li>
          <li>
            <code>Count</code> is mandatory for every element type, including submessages and
            fixed-width numbers. <code>Count = 0</code> is valid and still requires the{' '}
            <code>ElementType</code> byte.
          </li>
          <li>
            Variable-width elements (<code>WireString</code>, <code>WireBytes</code>,{' '}
            <code>WireSubMsg</code>) each start with their own <code>ByteLen</code> prefix, while
            fixed-width scalars pack contiguously with no padding. Decoders MUST read all{' '}
            <code>Count</code> elements and finish on the exact <code>ByteLen</code> boundary.
          </li>
        </ul>
        <Code code={arrayExamples} lang="text" />
        <p>
          Arrays of arrays set <code>ElementType = 13</code> and arrays of maps set{' '}
          <code>ElementType = 14</code>; each inner element is a complete length-prefixed container.
        </p>
        <Code code={nestedArrayExample} lang="text" />

        <h3 id="sec-6-6">6.6 WireMap (14)</h3>
        <pre><code>[Tag: WireMap]
[ByteLen: Prefix-Varint][KeyType: 1 byte][ValueType: 1 byte][Count: Prefix-Varint][Key_0][Value_0]…
                       |&lt;----------------------- ByteLen bytes ------------------------&gt;|</code></pre>
        <p>
          Every map uses <code>WireMap = 14</code>. The header writes <code>KeyType</code> (1 byte),{' '}
          <code>ValueType</code> (1 byte), and <code>Count</code> once. High four bits of both type
          bytes MUST be zero. Entries follow directly as alternating <code>[Key][Value]</code> pairs
          with no field tags or synthetic entry wrappers. <code>ByteLen</code> covers both type
          bytes, <code>Count</code>, and all entries.
        </p>
        <ul>
          <li>
            Valid <code>KeyType</code> codes are <code>0</code>, <code>1</code>, <code>2</code>,{' '}
            <code>4</code>, <code>5</code>, <code>6</code>, <code>7</code>, and <code>10</code>{' '}
            (integers, booleans, and UTF-8 strings). Float, bytes, submessage, array, and map keys
            are invalid.
          </li>
          <li>
            <code>ValueType</code> accepts any wire type code except <code>3</code>. Nested arrays (
            <code>13</code>) and maps (<code>14</code>) carry their own length-prefixed headers.
          </li>
          <li>
            <code>Count</code> records the total number of encoded key/value pairs (<code>0</code>{' '}
            is valid). Map entries may appear in any order, though deterministic encoders SHOULD
            sort keys by value.
          </li>
          <li>
            Duplicate keys obey last-entry-wins rules, and a repeated map key with a submessage
            value replaces the previous submessage for that key.
          </li>
        </ul>
        <Code code={mapExample} lang="text" />

        <h3 id="sec-6-7">6.7 WireExtended (15)</h3>
        <pre><code>[ByteLen: Prefix-Varint][ExtType: 1 byte][Extension payload]</code></pre>
        <p>
          <code>WireExtended = 15</code> reserves a length-prefixed envelope (
          <code>ByteLen &gt;= 1</code>, covering <code>ExtType</code> and payload) for future types;
          v0.1 assigns no <code>ExtType</code> codes. Scanners can skip unknown extensions by{' '}
          <code>ByteLen</code>, whereas a reader asked to decode an unknown <code>ExtType</code>{' '}
          MUST return an unsupported-type error.
        </p>

        <h2 id="sec-7">7. Field Lookup &amp; Validation</h2>
        <p>
          Each tag either fixes the scalar width or precedes a <code>ByteLen</code> Prefix-Varint,
          so a field scanner steps from tag to tag in <code>O(fields)</code> time (<code>O(1)</code>{' '}
          per skipped field) and never visits inner container items. Lookup APIs MUST document
          whether they return the last occurrence, all occurrences, or a recursively merged value,
          and whether skipping unknown fields bypasses full inner validation. A schema-less blind
          decoder MUST validate all core-type contents across every field, while schema-aware
          decoders validate container headers and nesting depth on unknown fields and skip
          unreferenced scalar and string payload bytes by length.
        </p>

        <h2 id="sec-8">8. Optional Naming Metadata (Field #0)</h2>
        <h3 id="sec-8-1">8.1 SchemaMeta Definition</h3>
        <p>
          Field #0 (<code>Tag = 0x19</code>, <code>FieldNumber = 0</code>,{' '}
          <code>WireSubMsg = 12</code>) optionally embeds message and field names encoded as an
          OmniBuf <code>SchemaMeta</code> submessage:
        </p>
        <Code code={sec8MetaProtoCode} lang="proto" />
        <h3 id="sec-8-2">8.2 Placement, Inheritance &amp; Merge</h3>
        <p>
          Encoders SHOULD write Field #0 first, and decoders MUST accept it at any position
          (including multiple Field #0 blocks in concatenated packets) and validate its wire
          structure even when an external schema is present. Blind readers resolve merged Field #0
          metadata before emitting field keys (falling back to <code>field_&lt;N&gt;</code> when
          unnamed) and MUST NOT let presentation names alter numeric field merging or silently
          overwrite colliding keys.
        </p>
        <p>
          In <code>SchemaMeta</code>, <code>children[N]</code> stores the child naming table for
          field <code>N</code> once and propagates automatically through arrays and map values of
          submessages unless overridden by an inner message's own Field #0. Across multiple Field #0
          blocks, later non-empty <code>type_name</code> values win, later <code>fields</code>{' '}
          entries override per field number (an empty string <code>""</code> clears an inherited
          field name back to <code>field_&lt;N&gt;</code>), and <code>children</code> maps merge
          recursively by field number.
        </p>

        <h2 id="sec-9">9. Complete Message Example</h2>
        <Code code={sec9ProtoCode} lang="proto" />
        <Code code={nodeExample} lang="text" />
        <p>
          The seven-byte Location body has a two-byte reserved length prefix. The root message
          occupies 15 bytes. A reader can skip Location directly from its length, or decode its
          fields with no external schema, and Field #0 can add field names to that inspection.
        </p>

        <h2 id="sec-10">10. Validity &amp; Rejection Rules</h2>
        <ul>
          <li>
            Reject truncated tags, scalar payloads, and length or count prefixes, invalid prefix
            patterns, and field numbers outside the defined range. Check lengths before converting
            to a platform-sized integer or adding them to an offset.
          </li>
          <li>
            For every length-prefixed value, require
            <code>byteLen &lt;= remainingBytes</code> after consuming the length prefix. Nested
            values MUST stay within their own enclosing container, not merely the root packet.
          </li>
          <li>
            An array body MUST contain ElementType and Count. Validate its type even when Count is
            zero. Reject invalid element codes, invalid boolean bytes, mismatched counts, and
            trailing bytes. For fixed-width elements require
            <code>count == remainingBytes / width</code> and
            <code>remainingBytes % width == 0</code>.
          </li>
          <li>
            Before allocating variable-width array elements, require
            <code>count &lt;= remainingBytes</code>. Every value encoding consumes at least one
            byte. Then parse exactly Count elements and require an exact end boundary.
          </li>
          <li>
            A map body MUST contain KeyType, ValueType, and Count. Validate both type bytes even
            when empty. Before allocating entries, require{' '}
            <code>count &lt;= remainingBytes / 2</code>. Check by division (multiplying an untrusted
            count can overflow). Parse all Count entries and require an exact end boundary.
          </li>
          <li>Strings MUST contain valid UTF-8. Arbitrary binary data MUST use WireBytes.</li>
          <li>
            Field #0 MUST use WireSubMsg and contain valid SchemaMeta. Its fields map uses
            <code>KeyType = 0x00, ValueType = 0x0A</code> and its children map uses{' '}
            <code>KeyType = 0x00, ValueType = 0x0C</code>.
          </li>
          <li>
            <strong>Nesting &amp; allocation caps:</strong> enforce a default max container depth of
            32 below the root (including nested collections and <code>SchemaMeta</code> recursion)
            and configurable message-size / allocation caps so large <code>uint64</code> length
            prefixes cannot trigger unbounded allocations.
          </li>
        </ul>
        <p>
          Unknown core field numbers remain skippable and inspectable by wire type; unknown{' '}
          <code>WireExtended</code> fields can be skipped by <code>ByteLen</code>. Implementations
          MUST document whether unknown fields are preserved across decode/re-encode cycles.
        </p>

        <h2 id="sec-11">11. Schema Mapping &amp; Conformance</h2>
        <h3 id="sec-11-1">11.1 Schema Mapping</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Protobuf schema kind</th>
                <th>OmniBuf wire type</th>
                <th>Collection &amp; value notes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>
                  <code>uint32</code>, <code>uint64</code>
                </td>
                <td>
                  <code>WireUint (0)</code>
                </td>
                <td>[Value: Prefix-Varint] (low 32 bits retained on uint32)</td>
              </tr>
              <tr>
                <td>
                  <code>int32</code>, <code>sint32</code>, <code>enum</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>[ZigZag Value: Prefix-Varint] (low 32 bits retained as signed int32)</td>
              </tr>
              <tr>
                <td>
                  <code>int64</code>, <code>sint64</code>
                </td>
                <td>
                  <code>WireSint (1)</code>
                </td>
                <td>[ZigZag Value: Prefix-Varint] (signed 64-bit range)</td>
              </tr>
              <tr>
                <td>
                  <code>bool</code>
                </td>
                <td>
                  <code>WireBoolFalse (2)</code> / <code>WireBoolTrue (3)</code>
                </td>
                <td>
                  0B in tag; code <code>2</code> + 1B (<code>00</code>/<code>01</code>) in
                  collections
                </td>
              </tr>
              <tr>
                <td>
                  <code>fixed32</code>, <code>fixed64</code>
                </td>
                <td>
                  <code>WireFixed32 (4)</code> / <code>WireFixed64 (5)</code>
                </td>
                <td>4B LE uint32 / 8B LE uint64</td>
              </tr>
              <tr>
                <td>
                  <code>sfixed32</code>, <code>sfixed64</code>
                </td>
                <td>
                  <code>WireSfixed32 (6)</code> / <code>WireSfixed64 (7)</code>
                </td>
                <td>4B LE int32 / 8B LE int64</td>
              </tr>
              <tr>
                <td>
                  <code>float</code>, <code>double</code>
                </td>
                <td>
                  <code>WireFloat32 (8)</code> / <code>WireFloat64 (9)</code>
                </td>
                <td>4B LE binary32 / 8B LE binary64 (IEEE-754)</td>
              </tr>
              <tr>
                <td>
                  <code>string</code>
                </td>
                <td>
                  <code>WireString (10)</code>
                </td>
                <td>[ByteLen][UTF-8 bytes]</td>
              </tr>
              <tr>
                <td>
                  <code>bytes</code>
                </td>
                <td>
                  <code>WireBytes (11)</code>
                </td>
                <td>[ByteLen][Raw bytes]</td>
              </tr>
              <tr>
                <td>
                  <code>message</code>
                </td>
                <td>
                  <code>WireSubMsg (12)</code>
                </td>
                <td>[ByteLen][Nested field stream]</td>
              </tr>
              <tr>
                <td>
                  <code>repeated T</code>
                </td>
                <td>
                  <code>WireArray (13)</code>
                </td>
                <td>
                  [ByteLen][<code>ElementType</code>: 1B][<code>Count</code>][Elements]
                </td>
              </tr>
              <tr>
                <td>
                  <code>map&lt;K, V&gt;</code>
                </td>
                <td>
                  <code>WireMap (14)</code>
                </td>
                <td>
                  [ByteLen][<code>KeyType</code>: 1B][<code>ValueType</code>: 1B][<code>Count</code>
                  ][Pairs]
                </td>
              </tr>
            </tbody>
          </table>
        </div>
        <p>
          Implementations MUST preserve explicit presence and active <code>oneof</code> members,
          including present zero values. Unsupported schema features MUST return an explicit error
          and never silently drop data. Sharing a <code>.proto</code> schema does not make OmniBuf
          bytes wire-compatible with Protobuf, and libraries MUST document their supported schema
          subset.
        </p>
        <h3 id="sec-11-2">11.2 Conformance Runner &amp; Client Protocol</h3>
        <p>
          Cross-language conformance uses a standalone test runner (<code>omnibuf conformance</code>{' '}
          / <code>conformance-runner</code>) paired with a per-language client binary (
          <code>conformance-go</code>, <code>conformance-es</code>). This split follows Protobuf's{' '}
          <code>conformance-test-runner</code> and <code>protovalidate-conformance</code>.
        </p>
        <p>
          The runner embeds the test corpus and launches the target client as a subprocess. Requests
          arrive on <code>stdin</code> and responses return on <code>stdout</code> as
          length-delimited frames. Every frame starts with a 4-byte little-endian{' '}
          <code>uint32</code> byte length (max 16 MiB) followed by an OmniBuf{' '}
          <code>ConformanceRequest</code> or <code>ConformanceResponse</code>. The client loops on{' '}
          <code>stdin</code> until <code>EOF</code> and logs diagnostics to <code>stderr</code>.
        </p>
        <Code code={sec11ConformanceProtoCode} lang="proto" />
        <p>
          The runner tests four <code>TestTier</code> modes on each vector.{' '}
          <code>TEST_TIER_PLUGIN (1)</code> exercises code from <code>protoc-gen-omnibuf-*</code>:
          decoding into dirty structs (verifying omitted fields clear), re-encoding, lazy{' '}
          <code>Opaque</code> getters, and in-place wire splicing (<code>test_opaque_splice</code>{' '}
          and <code>test_opaque_splice_shrink</code>). <code>TEST_TIER_PROTOBUF_TYPES (2)</code>{' '}
          exercises standard Protobuf descriptors or generated Protobuf structs with no OmniBuf
          plugin. <code>TEST_TIER_ANNOTATED_STRUCT (3)</code> exercises plain language structs,
          classes, or runtime schemas (Go <code>omnibuf</code> struct tags; TypeScript{' '}
          <code>defineMessage</code> or decorators). <code>TEST_TIER_BLIND (4)</code> exercises{' '}
          <code>DecodeBlind</code> / <code>decodeBlind</code>, returning{' '}
          <code>WIRE_FORMAT_JSON</code> keyed by Field #0 <code>SchemaMeta</code> names when present
          or <code>field_&lt;N&gt;</code> fallback keys.
        </p>
        <p>
          Map ordering and backpatched Prefix-Varint widths can vary across encoders, so the runner
          decodes the client's returned <code>omnibuf_payload</code> and compares decoded values for
          semantic equality. Requests with <code>self_describing = true</code> must return a valid
          Field #0 <code>SchemaMeta</code> block. On malformed or hostile input vectors,{' '}
          <code>TEST_TIER_BLIND</code> MUST return a non-empty <code>parse_error</code>, and every
          tier MUST reject the payload cleanly with no crash, panic, or <code>runtime_error</code>.
          Unimplemented optional tiers or message types MAY return a non-empty <code>skipped</code>{' '}
          string.
        </p>
        <h3 id="sec-11-3">11.3 Conformance Test Coverage</h3>
        <p>
          Generated codecs, descriptor-based codecs, plain-struct codecs, and blind readers MUST
          agree on value encodings wherever their supported features overlap. The conformance suite
          covers:
        </p>
        <ul>
          <li>Every scalar type, prefix width, non-minimal prefix, and field-number boundary.</li>
          <li>
            Every valid array element type, empty arrays, arrays of arrays, arrays of maps, and maps
            containing arrays or maps.
          </li>
          <li>Distinct string/bytes and float/fixed/sfixed interpretations without Field #0.</li>
          <li>
            Recursive message merges, concatenated messages, out-of-order fields, nested repeated
            fields, duplicate map keys, late metadata, present oneof zero values, and size-changing
            wire splicing.
          </li>
          <li>
            Counts near integer limits, mismatched byte lengths, malformed empty collections,
            invalid UTF-8, nesting limits, corrupt Field #0 headers, and unsupported extensions.
          </li>
        </ul>
      </article>
    </div>

