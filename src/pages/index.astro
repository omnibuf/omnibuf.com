---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Motivation from '../components/Motivation.astro';
import Footer from '../components/Footer.astro';
---

<Layout>
  <Navbar currentPage="home" />
  <main id="main-content">
    <Hero />
    <Motivation />

    <section
      id="status"
      class="scroll-mt-16 py-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink no-print"
    >
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="font-mono text-sm sm:text-base font-bold uppercase text-ink/80">
          v0.1 Draft Wire Format &middot;{' '}
          <a
            href="https://github.com/omnibuf/omnibuf-go/issues"
            target="_blank"
            rel="noopener noreferrer"
            class="doc-link"
          >
            GitHub Feedback &rarr;
          </a>
        </div>
        <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base">
          <a href="/how-it-works" class="os-btn px-5 py-2.5 bg-acid text-ink font-bold rounded-md">
            How It Works &rarr;
          </a>
          <a href="/go" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            OmniBuf for Go &rarr;
          </a>
          <a href="/es" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            TypeScript / JS &rarr;
          </a>
          <a href="/cli" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            OmniBuf CLI &rarr;
          </a>
          <a href="/spec" class="os-btn px-5 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
            Wire Specification &rarr;
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
