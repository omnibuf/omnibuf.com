---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Benchmarks from '../components/Benchmarks.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import Footer from '../components/Footer.astro';

const structTraitsSnippet = `#include "omnibuf/omnibuf.hpp"

struct PeerEvent {
  uint32_t asn = 0;
  std::string router_id;
  bool active = false;
  int32_t rssi_dbm = 0;
};

template <>
struct omnibuf::StructTraits<PeerEvent> {
  static constexpr std::string_view type_name = "PeerEvent";
  static constexpr auto fields() {
    return std::make_tuple(
        omnibuf::field<1, &PeerEvent::asn>("asn"),
        omnibuf::field<2, &PeerEvent::router_id>("router_id"),
        omnibuf::field<3, &PeerEvent::active>("active"),
        omnibuf::field<4, &PeerEvent::rssi_dbm, omnibuf::WireOverride::Sint>("rssi_dbm"));
  }
};

auto pkt = omnibuf::marshal(PeerEvent{.asn = 64512, .router_id = "rtr-01", .active = true});`;

const descriptorCppSnippet = `omnibuf::DescriptorPool pool;
pool.load_file_descriptor_set(fds_bytes);

const omnibuf::MessageDesc* desc = pool.find_message("omnibuf.bench.PeerUpdate");
auto msg = omnibuf::proto::from_binary(*desc, protobuf_wire_bytes);
auto pkt = omnibuf::marshal_dynamic(*desc, msg.value());`;

const bufGenCppSnippet = `version: v2
plugins:
  - local: ./build/protoc-gen-omnibuf-cpp
    out: build/gen`;

const generatedCppSnippet = `#include "omnibuf/bench/peer.omnibuf.pb.hpp"

std::vector<uint8_t> pkt = update.marshal_omnibuf();

omnibuf::bench::OpaquePeerUpdate view(pkt);
std::string_view city = view.get_location().get_city_view();

view.set_sequence(9876543211ULL);
std::vector<uint8_t> updated = view.marshal();`;

const blindCppCode = `auto pkt = omnibuf::marshal(event, {.self_describing = true});
auto json = omnibuf::decode_blind_json(pkt.value());`;

const cppFaqItems = [
  {
    id: 'cpp-faq-deps',
    question: 'Does the C++20 runtime depend on libprotobuf or Abseil?',
    paragraphs: [
      '<code>include/omnibuf/</code> is a standalone C++20 header library built strictly on standard headers (<code>&lt;bit&gt;</code>, <code>&lt;span&gt;</code>, <code>&lt;string_view&gt;</code>, <code>&lt;charconv&gt;</code>). Even <code>DescriptorPool</code> parses <code>buf build</code> descriptor sets directly, so binaries link zero third-party C++ archives.',
    ],
  },
  {
    id: 'cpp-faq-exceptions',
    question: 'How are malformed packets reported?',
    paragraphs: [
      'Decoders return <code>omnibuf::Status</code> and <code>omnibuf::Result&lt;T&gt;</code> values, so wire errors never throw C++ exceptions. Truncated slices, reserved Prefix-Varint markers, invalid UTF-8, and nesting past <code>MaxNestingDepth</code> fail deterministically.',
    ],
  },
  {
    id: 'cpp-faq-blind',
    question: 'How does decode_blind_json handle unknown schemas?',
    paragraphs: [
      'Compact packets decode into deterministic JSON with <code>field_1</code>, <code>field_2</code>, ... keys inferred from each tag&apos;s 4-bit wire type. Enabling <code>.self_describing = true</code> writes Field #0 so <code>decode_blind_json</code> restores exact field names.',
    ],
    codeBlock: blindCppCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const cppFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: cppFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for C++20 | Header-Only Runtime, StructTraits & protoc-gen-omnibuf-cpp"
  description="Use OmniBuf in C++20: zero-dependency header runtime, compile-time StructTraits on plain C++ structs, Buf FileDescriptorSet transcoding, and Opaque views."
>
  <Navbar currentPage="cpp" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for C++20.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            Zero external C++ dependencies. Specialize{' '}
            <a href="#struct-traits" class="doc-link">
              <code>StructTraits&lt;T&gt;</code>
            </a>{' '}
            on plain structs, load{' '}
            <a href="#descriptor-pool" class="doc-link">
              <code>buf build</code> descriptor sets
            </a>{' '}
            at runtime, or emit single-pass headers and <code>Opaque</code> views with{' '}
            <a href="#plugin-codegen" class="doc-link">
              <code>protoc-gen-omnibuf-cpp</code>
            </a>
            . Clang <code>-O3</code> benchmarks are{' '}
            <a href="#benchmarks" class="doc-link">
              further down
            </a>
            .
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a href="#benchmarks" class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md">
              C++20 Benchmarks &rarr;
            </a>
            <a href="/spec" class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
              Wire Specification &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Header-Only Runtime</div>
              <button
                type="button"
                data-copy='#include "omnibuf/omnibuf.hpp"'
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code>#include &quot;omnibuf/omnibuf.hpp&quot;</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Three ways to use{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
            OmniBuf in C++20.
          </span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          Built on <code>std::countr_zero</code>, <code>std::span</code>, and{' '}
          <code>std::string_view</code>.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <div
          id="struct-traits"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Compile-time StructTraits on plain C++ structs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>omnibuf::StructTraits&lt;T&gt;</code> binds member pointers to field IDs via{' '}
              <code>constexpr</code> tuples. Standard containers (<code>std::optional</code>,{' '}
              <code>std::vector</code>, <code>std::map</code>, <code>std::unique_ptr</code>) fold
              into direct template code with zero virtual dispatch.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">StructTraits&lt;T&gt;</div>
                <button
                  type="button"
                  data-copy={structTraitsSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={structTraitsSnippet} lang="cpp" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="descriptor-pool"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Buf descriptor sets and Protobuf wire transcoding
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>omnibuf::DescriptorPool</code> reads binary <code>FileDescriptorSet</code>{' '}
              images emitted by <code>buf build -o schemas.fds.pb</code>. Gateways can ingest
              standard Protobuf payloads and re-emit OmniBuf packets dynamically with no linked{' '}
              <code>libprotobuf</code> runtime.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  DescriptorPool &amp; DynamicMessage
                </div>
                <button
                  type="button"
                  data-copy={descriptorCppSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={descriptorCppSnippet} lang="cpp" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated headers with protoc-gen-omnibuf-cpp
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Running <code>buf generate</code> with <code>protoc-gen-omnibuf-cpp</code> outputs
              <code>.omnibuf.pb.hpp</code> headers containing value structs, register-cursor
              encoders, and <code>Opaque</code> views. Nested string reads return{' '}
              <code>std::string_view</code> directly into{' '}
              <code>std::span&lt;const uint8_t&gt;</code> in ~122 ns.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenCppSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenCppSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">Build Plugin &amp; Generate</div>
                <button
                  type="button"
                  data-copy="cmake --build build --target protoc-gen-omnibuf-cpp && buf generate"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>cmake --build build --target protoc-gen-omnibuf-cpp
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Generated Header &amp; Opaque View
                </div>
                <button
                  type="button"
                  data-copy={generatedCppSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedCppSnippet} lang="cpp" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <Benchmarks lang="cpp" />

    <section
      id="cpp-faq"
      class="scroll-mt-16 py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          C++20{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
        </h2>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        {cppFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-md border-2 border-ink font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                    <div class="text-xs font-bold uppercase text-acid">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="cpp" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(cppFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="cpp" />
  </main>

  <Footer />
</Layout>
