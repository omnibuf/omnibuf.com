---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import { defaultTypeMappings } from '../data/typeMappings';

let hexVersion = '0.1.0';
const isNewerSemver = (candidate: string, current: string) => {
  const pa = candidate.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
  const pb = current.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
  for (let i = 0; i < 3; i++) {
    if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pa[i] ?? 0) > (pb[i] ?? 0);
  }
  return false;
};
try {
  const res = await fetch('https://hex.pm/api/packages/omnibuf', {
    signal: AbortSignal.timeout(4000),
  });
  if (res.ok) {
    const data = (await res.json()) as {
      latest_stable_version?: string;
      latest_version?: string;
    };
    const latest = (data.latest_stable_version ?? data.latest_version ?? '').trim();
    if (
      /^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$/.test(latest) &&
      isNewerSemver(latest, hexVersion)
    ) {
      hexVersion = latest;
    }
  }
} catch {
  // Keep fallback version during offline builds
}

const mixInstallSnippet = `def deps do
  [
    {:omnibuf, "~> ${hexVersion}"}
  ]
end`;

const schemaElixirSnippet = `defmodule MyApp.Location do
  use OmniBuf.Schema, name: "Location"

  field 3, :city, :string
  field 4, :rack, :uint32
  field 5, :latitude, :float
  field 6, :longitude, :float
end

wire = MyApp.Location.encode(%MyApp.Location{city: "Frankfurt", rack: 42})
{:ok, loc} = MyApp.Location.decode(wire)`;

const elixirProtoSnippet = `wire = OmniBuf.encode_proto(pb_struct)
{:ok, decoded} = OmniBuf.decode_proto(wire, MyApp.PB.PeerUpdate)`;

const bufGenElixirSnippet = `version: v2
clean: true
plugins:
  - local: ./protoc-gen-omnibuf-elixir
    out: lib/generated`;

const generatedElixirSnippet = `alias Omnibuf.Bench.{Location, PeerUpdate}

city =
  packet
  |> PeerUpdate.Opaque.new()
  |> PeerUpdate.Opaque.get_location()
  |> Location.Opaque.get_city()

updated =
  packet
  |> PeerUpdate.Opaque.new()
  |> PeerUpdate.Opaque.set_sequence(9_876_543_211)
  |> PeerUpdate.Opaque.marshal!()`;

const blindElixirCode = `wire = MyApp.Location.encode(loc, self_describing: true)
{:ok, map} = OmniBuf.decode_blind(wire)
{:ok, json} = OmniBuf.decode_blind_json(wire)`;

const elixirFaqItems = [
  {
    id: 'elixir-faq-dsl',
    question: 'Why is OmniBuf.Schema as fast as generated code on the BEAM?',
    paragraphs: [
      '<code>use OmniBuf.Schema</code> expands at compile time into specialized iodata encoders and binary pattern-matching decoders. There is no runtime schema interpretation, so the DSL matches generated plugin modules in both encode and decode throughput.',
    ],
  },
  {
    id: 'elixir-faq-subbinaries',
    question: 'How do Opaque views avoid copying untouched fields in Elixir?',
    paragraphs: [
      'BEAM binaries support zero-copy sub-binary slicing. <code>PeerUpdate.Opaque</code> records byte spans for untouched fields and reassembles mutated packets as iodata, keeping unmodified nested payloads as references into the original binary.',
    ],
  },
  {
    id: 'elixir-faq-blind',
    question: 'How does OmniBuf.decode_blind inspect packets without a schema?',
    paragraphs: [
      '<code>OmniBuf.decode_blind/1</code> and <code>OmniBuf.decode_blind_json/1</code> walk the 4-bit wire types directly into an Elixir map or JSON string. Unnamed fields default to <code>field_1</code>, <code>field_2</code>, ... while packets encoded with <code>self_describing: true</code> resolve Field #0 names recursively.',
    ],
    codeBlock: blindElixirCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const elixirFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: elixirFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Elixir & BEAM | OmniBuf.Schema DSL, elixir-protobuf & protoc-gen-omnibuf-elixir"
  description="Use OmniBuf in Elixir: define OmniBuf.Schema structs, encode elixir-protobuf messages, or generate iodata codecs and Opaque views."
>
  <Navbar currentPage="elixir" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="text-[#FF4F18]">for Elixir.</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            Pure Elixir library on Hex.pm built for BEAM binary pattern matching and iodata. Define{' '}
            <a href="#schema-dsl" class="doc-link">
              compile-time <code>OmniBuf.Schema</code> structs
            </a>
            , bridge{' '}
            <a href="#elixir-protobuf" class="doc-link">
              <code>elixir-protobuf</code> modules
            </a>
            , or{' '}
            <a href="#plugin-codegen" class="doc-link">
              generate codecs and zero-copy sub-binary Opaque views
            </a>
            .
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-elixir"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://hex.pm/packages/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              Hex.pm &rarr;
            </a>
            <a
              href="https://hexdocs.pm/omnibuf"
              target="_blank"
              rel="noopener noreferrer"
              class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md"
            >
              HexDocs &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0 space-y-3">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111] [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">mix.exs</div>
              <button
                id="elixir-mix-copy-btn"
                type="button"
                data-copy={mixInstallSnippet}
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code>def deps do
  [
    &#123;:omnibuf, "~&gt; <span id="elixir-mix-version">{hexVersion}</span>"&#125;
  ]
end</code></pre>
          </div>

          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">
                Optional: Rustler NIF (omnibuf-rs)
              </div>
              <button
                type="button"
                data-copy="OMNIBUF_BUILD_NATIVE=1 mix deps.compile omnibuf"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>OMNIBUF_BUILD_NATIVE=1 mix deps.compile omnibuf</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Three ways to use <span class="text-[#FF4F18]">OmniBuf in Elixir.</span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          All three emit identical v1 DRAFT-1 binaries on Elixir 1.17+ and Erlang/OTP 27+.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <div
          id="schema-dsl"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Compile-time OmniBuf.Schema DSL
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Declare numbered fields straight inside an Elixir module with{' '}
              <code>use OmniBuf.Schema</code>. Macros compile specialized iodata encoders and
              pattern-matching decoders directly into your module.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">OmniBuf.Schema Module</div>
                <button
                  type="button"
                  data-copy={schemaElixirSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={schemaElixirSnippet} lang="elixir" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.elixir} />
        </div>

        <div
          id="elixir-protobuf"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Existing elixir-protobuf structs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Services already generating <code>use Protobuf</code> structs pass them directly to{' '}
              <code>OmniBuf.encode_proto/1</code> and <code>OmniBuf.decode_proto/2</code>.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">elixir-protobuf Bridge</div>
                <button
                  type="button"
                  data-copy={elixirProtoSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={elixirProtoSnippet} lang="elixir" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated modules and Opaque views
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Build the escript plugin with <code>mix escript.build</code> and run{' '}
              <code>buf generate</code>. Generated <code>&lt;Message&gt;.Opaque</code> views slice
              untouched fields as zero-copy sub-binaries and splice single-field updates in ~2,420
              ns.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenElixirSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenElixirSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">Build Plugin &amp; Generate</div>
                <button
                  type="button"
                  data-copy="mix escript.build && buf generate"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>mix escript.build
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Lazy Opaque View &amp; Sub-Binary Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedElixirSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedElixirSnippet} lang="elixir" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <section
      id="elixir-faq"
      class="scroll-mt-16 py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Elixir <span class="text-[#FF4F18]">questions.</span>
        </h2>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        {elixirFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-md border-2 border-ink font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                    <div class="text-xs font-bold uppercase text-acid">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="elixir" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(elixirFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="elixir" />
  </main>

  <Footer />

  <script>
    const verEl = document.getElementById('elixir-mix-version');
    const copyBtn = document.getElementById('elixir-mix-copy-btn');
    if (verEl && copyBtn) {
      const isNewer = (candidate: string, current: string) => {
        const pa = candidate.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
        const pb = current.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
        for (let i = 0; i < 3; i++) {
          if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pa[i] ?? 0) > (pb[i] ?? 0);
        }
        return false;
      };
      void (async () => {
        try {
          const res = await fetch('https://hex.pm/api/packages/omnibuf');
          if (!res.ok) return;
          const data = (await res.json()) as {
            latest_stable_version?: string;
            latest_version?: string;
          };
          const raw = (data.latest_stable_version ?? data.latest_version ?? '').trim();
          if (!/^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$/.test(raw)) return;
          const currentVer = (verEl.textContent ?? '').trim() || '0.0.0';
          if (!isNewer(raw, currentVer)) return;
          verEl.textContent = raw;
          copyBtn.setAttribute(
            'data-copy',
            `def deps do\n  [\n    {:omnibuf, "~> ${raw}"}\n  ]\nend`,
          );
        } catch {
          // Keep build-time version on network failure
        }
      })();
    }
  </script>
</Layout>
