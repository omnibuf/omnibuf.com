---
import Footer from '../components/Footer.astro';
import Navbar from '../components/Navbar.astro';
import { benchmarkCategories, languageBenchmarkList, type BenchmarkRow } from '../data/benchmarks';
import { languages, type LanguageKey } from '../data/languages';
import Layout from '../layouts/Layout.astro';

function formatMetric(val: number, unit: string): string {
  if (unit === 'ns') {
    if (val >= 1_000_000) {
      return `${(val / 1_000_000).toFixed(2)} ms`;
    }
    if (val >= 10_000) {
      return `${(val / 1_000).toFixed(1)} µs`;
    }
  }
  return `${val.toLocaleString('en-US')} ${unit}`;
}

function formatMultiplier(competitorVal: number | null, omniVal: number): string {
  if (competitorVal === null || omniVal <= 0) return 'n/a';
  if (competitorVal === omniVal) return '1.0x';
  if (competitorVal > omniVal) {
    const ratio = competitorVal / omniVal;
    return ratio >= 10 ? `${Math.round(ratio)}x faster` : `${ratio.toFixed(1)}x faster`;
  }
  const ratio = omniVal / competitorVal;
  return `${ratio.toFixed(1)}x slower`;
}

function findPrimaryProtobuf(rows: BenchmarkRow[]): BenchmarkRow | undefined {
  const candidates = rows.filter(
    (r) =>
      !r.highlight &&
      /protobuf|prost|buffa|libprotobuf|upb|swiftprotobuf|package:protobuf|elixir-protobuf|nanopb/i.test(
        r.name,
      ) &&
      !/pure php|leb128 wire/i.test(r.name),
  );
  if (candidates.length === 0) return undefined;
  return (
    candidates.find((r) =>
      /^(Protobuf|@bufbuild\/protobuf|prost|google\/protobuf \(upb|libprotobuf|protobuf-java|Google\.Protobuf|SwiftProtobuf|package:protobuf|google\/protobuf \(C ext|elixir-protobuf|nanopb)/i.test(
        r.name,
      ),
    ) ?? candidates[0]
  );
}

function findPrimaryJson(rows: BenchmarkRow[]): BenchmarkRow | undefined {
  const candidates = rows.filter((r) => !r.highlight && /json|jason/i.test(r.name));
  if (candidates.length === 0) return undefined;
  return candidates.find((r) => !/json\/v2/i.test(r.name)) ?? candidates[0];
}

function shortCompetitorName(name: string | null): string {
  if (!name) return '';
  return name
    .replace(/^Protobuf \(([^)]+)\)$/i, '$1')
    .replace(/^JSON \(([^)]+)\)$/i, '$1')
    .replace(/^([^(]+) \(Protobuf\)$/i, '$1')
    .replace(/^([^(]+) \(JSON\)$/i, '$1')
    .replace(/^google\/protobuf \(C ext\)$/i, 'ext-protobuf')
    .replace(/^json \(stdlib\)$/i, 'stdlib json')
    .replace(/^encoding\/json$/i, 'encoding/json');
}

interface CrossLangBenchDef {
  slug: string;
  shortLabel: string;
  title: string;
  summary: string;
}

const crossLangDefs: CrossLangBenchDef[] = [
  {
    slug: 'decode',
    shortLabel: 'Full Decode',
    title: 'Full Message Decode Speed',
    summary:
      'Decodes PeerUpdate and reads all 11 fields across every codec so lazy decoders do the same work as eager ones.',
  },
  {
    slug: 'encode',
    shortLabel: 'Full Encode',
    title: 'Full Message Encode Speed',
    summary:
      'Serializes the 11-field PeerUpdate struct into a byte buffer, testing single-pass 2-byte length slots and Prefix-Varint writes.',
  },
  {
    slug: 'nested-read',
    shortLabel: 'Nested Read',
    title: 'Read a Single Nested Field',
    summary:
      'Extracts one nested city string straight from raw wire bytes by jumping past earlier fields using their byte lengths.',
  },
  {
    slug: 'splice',
    shortLabel: 'Field Splice',
    title: 'Selective Single-Field Mutation',
    summary:
      'Checks a nested city string, increments a 64-bit sequence counter, and splices only the dirty field back into the packet.',
  },
  {
    slug: 'large-embed',
    shortLabel: 'Large Embed',
    title: 'Large Embedded Message Encode',
    summary:
      'Encodes a ~39 KiB message with embedded sub-messages past the 16 KiB 2-byte slot to exercise the 4-byte length path.',
  },
  {
    slug: 'growth',
    shortLabel: 'Growth',
    title: 'Embedded Message Growth',
    summary:
      'Grows embedded sub-message payloads across size thresholds to verify linear O(N) scaling.',
  },
];

const langMetaByKey = new Map(languages.map((l) => [l.key, l]));

const crossLangPanels = crossLangDefs.map((def) => {
  const rawEntries = languageBenchmarkList
    .map((suite) => {
      const cat = suite.categories.find((c) => c.title === def.title);
      if (!cat) return null;
      const omniRow =
        cat.rows.find((r) => r.baseline) ?? cat.rows.find((r) => r.highlight) ?? cat.rows[0];
      const protoRow = findPrimaryProtobuf(cat.rows);
      const jsonRow = findPrimaryJson(cat.rows);
      const meta = langMetaByKey.get(suite.key);
      return {
        key: suite.key,
        label: suite.label,
        shortLabel: suite.shortLabel,
        href: meta?.href ?? `/${suite.key}`,
        val: omniRow.val,
        unit: cat.unit,
        protoVal: protoRow?.val ?? null,
        protoName: protoRow?.name ?? null,
        jsonVal: jsonRow?.val ?? null,
        jsonName: jsonRow?.name ?? null,
      };
    })
    .filter((entry): entry is NonNullable<typeof entry> => entry !== null)
    .sort((a, b) => a.val - b.val);

  const maxVal = Math.max(...rawEntries.map((e) => e.val), 1);

  const rows = rawEntries.map((entry, idx) => {
    const linearPct = Math.max(3, Math.min(100, (entry.val / maxVal) * 100)).toFixed(1);
    return {
      ...entry,
      rank: idx + 1,
      linearPct,
      vsProto: formatMultiplier(entry.protoVal, entry.val),
      vsJson: formatMultiplier(entry.jsonVal, entry.val),
    };
  });

  return {
    ...def,
    rows,
  };
});

const wireSizeCategory = benchmarkCategories.find((cat) => cat.unit === 'B');

const methodologyBenchmarks = [
  {
    title: 'Full Message Encode Speed',
    slug: 'encode',
    description:
      'Serializes the 11-field PeerUpdate struct into a byte buffer. Every RPC response, event producer, and cache write hits full-message encoding on the hot path, and this workload directly tests whether single-pass 2-byte length slots and Prefix-Varint writes outperform Protobuf two-pass Size() walks and LEB128 loops.',
  },
  {
    title: 'Full Message Decode Speed',
    slug: 'decode',
    description:
      'Decodes PeerUpdate into a reused struct and reads all 11 fields into a checksum the compiler cannot optimize away. That forces lazy decoders (like FlatBuffers or C upb) to unpack every field just like eager structs, isolating Prefix-Varint loads and packed arrays against LEB128 byte loops and JSON parsers.',
  },
  {
    title: 'Read a Single Nested Field',
    slug: 'nested-read',
    description:
      "Extracts one nested string (location.city) straight from raw wire bytes. Proxies, routers, and log filters often inspect a single routing key inside a larger payload, so this test highlights length-prefixed field skipping over Protobuf and JSON full decodes while showing honestly where FlatBuffers and Cap'n Proto offset tables stay faster.",
  },
  {
    title: 'Selective Single-Field Mutation',
    slug: 'splice',
    description:
      'Checks location.city, increments a 64-bit sequence counter, and returns updated packet bytes. Middleware and stream processors frequently validate one field, stamp a counter or flag, and forward the message, making this the direct test of Opaque in-place field splicing against a full decode, allocate, and re-encode cycle.',
  },
  {
    title: 'Large Embedded Message Encode',
    slug: 'large-embed',
    description:
      "Encodes a ~39 KiB message with embedded sub-messages exceeding OmniBuf's 16 KiB 2-byte length slot. Real batch responses and nested blobs routinely cross 16 KiB, so this benchmark exercises the 4-byte container length fallback path to confirm the 2-byte fast path is not masking a performance cliff on large payloads.",
  },
  {
    title: 'Embedded Message Growth',
    slug: 'growth',
    description:
      'Measures encode latency as embedded sub-message sizes scale up across multiple thresholds. Tracking growth catches quadratic buffer shifting or repeated re-sizing early and verifies linear O(N) scaling across container sizes.',
  },
];

const validLangKeys: LanguageKey[] = languageBenchmarkList.map((s) => s.key);
---

<Layout
  title="Benchmarks & Methodology Across 12 Languages | OmniBuf"
  description="Cross-language OmniBuf benchmarks across Go, TypeScript, Rust, Python, C++20, C99, Java, C#, Swift, Dart, PHP, and Elixir, plus full methodology."
>
  <Navbar currentPage="benchmarks" />

  <main id="main-content">
    <!-- Page Header -->
    <section class="pt-10 sm:pt-14 pb-6 sm:pb-8 px-4 sm:px-6 max-w-6xl mx-auto">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-3xl space-y-2.5">
          <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
            Runtime <span class="text-accent">benchmarks</span>
          </h1>
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[64ch]">
            Every runtime runs the same 11-field <code>PeerUpdate</code> suite on an Apple M1 Pro
            against Protobuf, JSON, and native serializers. Browse by language or compare all{' '}
            {languageBenchmarkList.length} runtimes side by side.
          </p>
        </div>
        <div class="flex flex-wrap gap-2 text-sm">
          <a href="#wire-size" class="btn-secondary px-3.5 py-2">
            Wire Size &darr;
          </a>
          <a href="#methodology" class="btn-secondary px-3.5 py-2">
            Methodology &darr;
          </a>
        </div>
      </div>
    </section>

    <!-- Interactive Benchmark Explorer -->
    <section
      id="results"
      data-benchmark-explorer
      class="scroll-mt-14 pb-12 sm:pb-16 px-4 sm:px-6 max-w-6xl mx-auto"
    >
      <!-- Compact Sticky Explorer Controls (sticks until after #results) -->
      <div
        data-explorer-bar
        class="sticky top-14 z-30 -mx-4 sm:-mx-6 px-4 sm:px-6 py-2 mb-5 bg-[var(--bg-paper)]"
      >
        <div class="bg-[#FAF8F2] border border-ink/15 rounded-lg shadow-sm px-2.5 py-1.5 flex flex-col lg:flex-row lg:items-center gap-2 lg:gap-2.5">
          <!-- Mode Switcher -->
          <div
            role="tablist"
            aria-label="Benchmark view mode"
            class="inline-flex items-center gap-1 text-xs font-medium shrink-0"
          >
            <button
              type="button"
              role="tab"
              id="view-tab-language"
              data-view-tab="language"
              aria-selected="true"
              aria-controls="view-panel-language"
              tabindex="0"
              class="seg-tab px-2.5 py-1.5 sm:py-1 whitespace-nowrap"
            >
              By language
            </button>
            <button
              type="button"
              role="tab"
              id="view-tab-compare"
              data-view-tab="compare"
              aria-selected="false"
              aria-controls="view-panel-compare"
              tabindex="-1"
              class="seg-tab px-2.5 py-1.5 sm:py-1 whitespace-nowrap"
            >
              Compare languages
            </button>
          </div>

          <span class="hidden lg:block w-px h-5 bg-ink/15 shrink-0" aria-hidden="true"></span>

          <!-- Sub-tabs: Languages (By Language mode) -->
          <div
            data-language-subtabs
            role="tablist"
            aria-label="Select language runtime"
            class="flex items-center gap-1 overflow-x-auto pt-1.5 border-t border-ink/12 lg:pt-0 lg:border-t-0 font-mono text-xs min-w-0"
          >
            {languageBenchmarkList.map((suite, idx) => (
              <button
                type="button"
                role="tab"
                id={`lang-tab-${suite.key}`}
                data-lang-tab={suite.key}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`lang-panel-${suite.key}`}
                tabindex={idx === 0 ? 0 : -1}
                class="seg-tab px-2 py-1.5 sm:py-1 whitespace-nowrap shrink-0"
              >
                {suite.shortLabel}
              </button>
            ))}
          </div>

          <!-- Sub-tabs: 6 Workloads (Compare Languages mode) -->
          <div
            data-compare-subtabs
            role="tablist"
            aria-label="Select benchmark workload"
            class="hidden items-center gap-1 overflow-x-auto pt-1.5 border-t border-ink/12 lg:pt-0 lg:border-t-0 font-mono text-xs min-w-0"
          >
            {crossLangPanels.map((panel, idx) => (
              <button
                type="button"
                role="tab"
                id={`bench-tab-${panel.slug}`}
                data-bench-tab={panel.slug}
                aria-selected={idx === 0 ? 'true' : 'false'}
                aria-controls={`bench-panel-${panel.slug}`}
                tabindex={idx === 0 ? 0 : -1}
                class="seg-tab px-2 py-1.5 sm:py-1 whitespace-nowrap shrink-0"
              >
                {panel.shortLabel}
              </button>
            ))}
          </div>
        </div>
      </div>

      <!-- VIEW 1: CROSS-LANGUAGE COMPARISON -->
      <div
        id="view-panel-compare"
        role="tabpanel"
        aria-labelledby="view-tab-compare"
        data-view-panel="compare"
        class="hidden"
      >
        {crossLangPanels.map((panel, pIdx) => (
          <div
            id={`bench-panel-${panel.slug}`}
            role="tabpanel"
            aria-labelledby={`bench-tab-${panel.slug}`}
            data-bench-panel={panel.slug}
            class:list={[pIdx !== 0 && 'hidden']}
          >
            <div class="os-window overflow-hidden">
              <div class="os-titlebar">
                <h2 class="text-sm font-semibold text-ink">
                  {panel.title} &middot; {panel.rows.length} runtimes
                </h2>
              </div>

              <div class="p-4 sm:p-5 bg-[#FAF8F2] space-y-3">
                <p class="text-sm sm:text-base text-ink/80 leading-relaxed max-w-[75ch]">
                  {panel.summary}
                </p>

                <!-- Column Headers (Desktop) -->
                <div class="hidden md:grid md:grid-cols-[minmax(180px,1.2fr)_minmax(210px,1.45fr)_minmax(170px,1fr)_minmax(170px,1fr)] gap-4 px-3 pb-1.5 border-b border-ink/15 font-mono text-xs font-semibold text-ink/65">
                  <div>Language</div>
                  <div>Latency</div>
                  <div class="text-right">vs Protobuf</div>
                  <div class="text-right">vs JSON</div>
                </div>

                <div class="space-y-1.5">
                  {panel.rows.map((row) => (
                    <button
                      type="button"
                      data-inspect-lang={row.key}
                      aria-label={`View all ${row.label} benchmark charts`}
                      title={`View all ${row.label} benchmark charts`}
                      class:list={[
                        'group w-full text-left cursor-pointer grid grid-cols-1 md:grid-cols-[minmax(180px,1.2fr)_minmax(210px,1.45fr)_minmax(170px,1fr)_minmax(170px,1fr)] gap-x-4 gap-y-2 items-center px-3 py-2.5 rounded-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#FF4F18]',
                        row.rank === 1 ? 'bench-compare-row-top' : 'bench-compare-row',
                      ]}
                    >
                      <!-- Language -->
                      <span class="flex items-center gap-2 min-w-0">
                        <span class="font-mono text-xs font-semibold text-ink/60 tabular-nums w-5 shrink-0">
                          #{row.rank}
                        </span>
                        <span class="text-sm font-semibold text-ink group-hover:text-accent transition-colors truncate">
                          {row.label}
                        </span>
                        <span
                          class="text-xs text-ink/60 group-hover:text-accent group-hover:translate-x-0.5 transition-all shrink-0"
                          aria-hidden="true"
                        >
                          &rarr;
                        </span>
                      </span>

                      <!-- Latency Bar + Metric -->
                      <span class="flex items-center gap-2.5 min-w-0">
                        <span class="flex-1 bench-track h-2.5 rounded-full overflow-hidden block">
                          <span
                            class="block h-full bench-bar-omni rounded-full"
                            style={`width: ${row.linearPct}%;`}
                          />
                        </span>
                        <span class="font-mono text-xs sm:text-sm font-semibold text-ink tabular-nums whitespace-nowrap w-20 text-right shrink-0">
                          {formatMetric(row.val, row.unit)}
                        </span>
                      </span>

                      <!-- vs Protobuf -->
                      <span class="flex items-baseline justify-between md:block font-mono text-xs tabular-nums md:text-right min-w-0 gap-2">
                        <span class="md:hidden text-xs text-ink/65 shrink-0">vs Protobuf</span>
                        <span class="block text-right min-w-0">
                          <span
                            class="block font-semibold text-ink text-xs sm:text-sm"
                            title={
                              row.protoVal !== null && row.protoName
                                ? `${row.protoName}: ${formatMetric(row.protoVal, row.unit)}`
                                : undefined
                            }
                          >
                            {row.vsProto}
                          </span>
                          {row.protoVal !== null && (
                            <span class="block text-xs text-ink/65 truncate">
                              {formatMetric(row.protoVal, row.unit)} &middot;{' '}
                              {shortCompetitorName(row.protoName)}
                            </span>
                          )}
                        </span>
                      </span>

                      <!-- vs JSON -->
                      <span class="flex items-baseline justify-between md:block font-mono text-xs tabular-nums md:text-right min-w-0 gap-2">
                        <span class="md:hidden text-xs text-ink/65 shrink-0">vs JSON</span>
                        <span class="block text-right min-w-0">
                          <span
                            class="block font-semibold text-ink text-xs sm:text-sm"
                            title={
                              row.jsonVal !== null && row.jsonName
                                ? `${row.jsonName}: ${formatMetric(row.jsonVal, row.unit)}`
                                : undefined
                            }
                          >
                            {row.vsJson}
                          </span>
                          {row.jsonVal !== null && (
                            <span class="block text-xs text-ink/65 truncate">
                              {formatMetric(row.jsonVal, row.unit)} &middot;{' '}
                              {shortCompetitorName(row.jsonName)}
                            </span>
                          )}
                        </span>
                      </span>
                    </button>
                  ))}
                </div>

                <p class="pt-2 text-xs text-ink/70 leading-relaxed">
                  Note: Cross-language latency reflects each runtime model (AOT native, JIT,
                  interpreter + compiled Rust extension/NIF for Python, PHP, and Elixir, or BEAM).
                  Click any row to inspect all competitors and pure-language variants for that
                  ecosystem.
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- VIEW 2: BY-LANGUAGE DETAILED BREAKDOWN -->
      <div
        id="view-panel-language"
        role="tabpanel"
        aria-labelledby="view-tab-language"
        data-view-panel="language"
      >
        {languageBenchmarkList.map((suite, sIdx) => {
          const langMeta = langMetaByKey.get(suite.key);
          return (
            <div
              id={`lang-panel-${suite.key}`}
              role="tabpanel"
              aria-labelledby={`lang-tab-${suite.key}`}
              data-lang-panel={suite.key}
              class:list={['space-y-6', sIdx !== 0 && 'hidden']}
            >
              <div class="flex flex-wrap items-center justify-between gap-4">
                <h2
                  tabindex="-1"
                  data-lang-heading={suite.key}
                  class="text-2xl sm:text-3xl font-bold tracking-tight text-ink focus:outline-none"
                >
                  {suite.headingPrefix} benchmarks
                </h2>
                <a
                  href={langMeta?.href ?? `/${suite.key}`}
                  class="btn-primary px-3.5 py-2 text-xs sm:text-sm"
                >
                  {suite.label} Guide &rarr;
                </a>
              </div>

              <div class="grid lg:grid-cols-2 gap-5 items-start">
                {suite.categories.map((cat) => (
                  <div class="os-window overflow-hidden">
                    <div class="os-titlebar">
                      <span class="text-sm font-semibold text-ink">{cat.title}</span>
                    </div>

                    <div class="p-4 bg-[#FAF8F2] space-y-1.5">
                      <p class="text-xs sm:text-sm text-ink/75 leading-relaxed pb-2 max-w-[70ch]">
                        {cat.methodology}
                      </p>
                      {(() => {
                        const sortedRows = [...cat.rows].sort((a, b) => a.val - b.val);
                        const omniVal =
                          sortedRows.find((row) => row.baseline)?.val ??
                          sortedRows.find((row) => row.highlight)?.val ??
                          sortedRows[0].val;
                        return sortedRows.map((r) => {
                          const numPct = Math.max(2, Math.min(100, (r.val / cat.maxVal) * 100));
                          const pct = numPct.toFixed(1);
                          let ratioStr = r.ratio ?? '1.0x (base)';
                          if (!r.ratio && r.val !== omniVal) {
                            ratioStr =
                              r.val < omniVal
                                ? `${(omniVal / r.val).toFixed(1)}x faster`
                                : `${(r.val / omniVal).toFixed(1)}x slower`;
                          }
                          const rowTitle = r.ops
                            ? `${r.name}: ${r.val.toLocaleString('en-US')} ${cat.unit} (${r.ops})`
                            : r.name;
                          return (
                            <div
                              class:list={[
                                'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1.5 rounded-md min-w-0',
                                r.baseline
                                  ? 'bench-row-omni font-semibold'
                                  : r.highlight
                                    ? 'bench-row-omni-secondary font-medium'
                                    : 'border border-ink/10 bg-white',
                              ]}
                              title={rowTitle}
                            >
                              <div class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate">
                                {r.name}
                              </div>
                              <div class="col-span-6 sm:col-span-3 flex items-center min-w-0">
                                <div class="w-full bench-track h-2.5 rounded-full overflow-hidden">
                                  <div
                                    class:list={[
                                      'h-full rounded-full',
                                      r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                                    ]}
                                    style={`width: ${pct}%;`}
                                  />
                                </div>
                              </div>
                              <div class="col-span-6 sm:col-span-4 flex flex-wrap items-baseline justify-end gap-x-1 text-right font-mono text-xs tabular-nums leading-tight min-w-0">
                                <span class="font-semibold text-ink whitespace-nowrap">
                                  {ratioStr}
                                </span>
                                <span class="text-ink/65 font-normal whitespace-nowrap">
                                  ({formatMetric(r.val, cat.unit)})
                                </span>
                              </div>
                            </div>
                          );
                        });
                      })()}
                    </div>
                  </div>
                ))}
              </div>

              <!-- Per-Language Runtime & Reproducibility Notes -->
              <div class="pt-6 border-t border-ink/15 grid md:grid-cols-12 gap-6 items-start">
                <div class="md:col-span-4">
                  <div class="p-4 bg-ink text-paper rounded-lg border border-ink/15 space-y-1.5 font-mono text-xs sm:text-sm">
                    <div class="text-acid font-semibold">{suite.label} environment</div>
                    {suite.hardwareLines.map((line) => (
                      <div class="text-paper/85">{line}</div>
                    ))}
                  </div>
                </div>
                <div class="md:col-span-8 space-y-3 text-sm sm:text-base text-ink/85 leading-relaxed max-w-[68ch]">
                  {suite.environmentParagraphs.map((para) => (
                    <p set:html={para} />
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Packet Wire Size (Language-Independent) -->
    {wireSizeCategory && (
      <section
        id="wire-size"
        class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
      >
        <div class="grid lg:grid-cols-12 gap-6 lg:gap-8 items-start">
          <div class="lg:col-span-4 space-y-3">
            <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">Wire size</h2>
            <p class="text-sm sm:text-base text-ink/85 leading-relaxed">
              Packet size is identical across all {languageBenchmarkList.length} OmniBuf runtimes.
              Protobuf saves ~7% on dense messages by omitting type disambiguation, while OmniBuf
              stays 35% to 54% smaller than Cap&apos;n Proto, FlatBuffers, MessagePack, and JSON.
            </p>
            <p class="text-xs sm:text-sm text-ink/75 leading-relaxed">
              Even with optional <strong>Field #0</strong> metadata enabled (writing field names
              once at the top of the packet), OmniBuf is still 4% smaller than MessagePack.
            </p>
          </div>

          <div class="lg:col-span-8">
            <div class="os-window overflow-hidden">
              <div class="os-titlebar">
                <span class="text-sm font-semibold text-ink">
                  {wireSizeCategory.title} &middot; 11-field PeerUpdate
                </span>
              </div>
              <div class="p-4 bg-[#FAF8F2] space-y-1.5">
                {(() => {
                  const sorted = [...wireSizeCategory.rows].sort((a, b) => a.val - b.val);
                  const baseVal = sorted.find((r) => r.baseline)?.val ?? 366;
                  return sorted.map((r) => {
                    const numPct = Math.max(
                      3,
                      Math.min(100, (r.val / wireSizeCategory.maxVal) * 100),
                    );
                    const pct = numPct.toFixed(1);
                    const deltaPct = Math.round(((r.val - baseVal) / baseVal) * 100);
                    const deltaLabel =
                      r.val === baseVal
                        ? '1.0x (base)'
                        : deltaPct < 0
                          ? `${deltaPct}% smaller`
                          : `+${deltaPct}% larger`;
                    return (
                      <div
                        class:list={[
                          'grid grid-cols-12 gap-x-2 gap-y-1 items-center px-2.5 py-1.5 rounded-md min-w-0',
                          r.baseline
                            ? 'bench-row-omni font-semibold'
                            : r.highlight
                              ? 'bench-row-omni-secondary font-medium'
                              : 'border border-ink/10 bg-white',
                        ]}
                      >
                        <div class="col-span-12 sm:col-span-5 font-mono text-xs text-ink truncate">
                          {r.name}
                        </div>
                        <div class="col-span-6 sm:col-span-3 flex items-center min-w-0">
                          <div class="w-full bench-track h-2.5 rounded-full overflow-hidden">
                            <div
                              class:list={[
                                'h-full rounded-full',
                                r.highlight ? 'bench-bar-omni' : 'bench-bar-competitor',
                              ]}
                              style={`width: ${pct}%;`}
                            />
                          </div>
                        </div>
                        <div class="col-span-6 sm:col-span-4 flex flex-wrap items-baseline justify-end gap-x-1 text-right font-mono text-xs tabular-nums leading-tight min-w-0">
                          <span class="font-semibold text-ink whitespace-nowrap">{deltaLabel}</span>
                          <span class="text-ink/65 font-normal whitespace-nowrap">
                            ({r.val.toLocaleString('en-US')} B)
                          </span>
                        </div>
                      </div>
                    );
                  });
                })()}
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Benchmark Methodology (Placed AFTER Data) -->
    <section
      id="methodology"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15 space-y-10"
    >
      <div class="max-w-3xl space-y-2.5">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Benchmark methodology
        </h2>
        <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
          Every runtime runs the same six workloads on the same Apple M1 Pro machine against
          idiomatic Protobuf, JSON, and native serializers. Each test targets a specific wire-format
          property so fast paths cannot hide regressions elsewhere.
        </p>
      </div>

      <!-- Shared Test Setup & Equal-Footing Rules -->
      <div class="space-y-4">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">
          Test payloads and equal-footing rules
        </h3>
        <div class="border-t border-ink/15 divide-y divide-ink/12">
          <div class="py-4 grid md:grid-cols-12 gap-2 md:gap-8 items-baseline">
            <div class="md:col-span-3 font-mono text-sm font-semibold text-ink">
              Shared Payloads
            </div>
            <p class="md:col-span-9 text-sm sm:text-base text-ink/85 leading-relaxed max-w-[58ch]">
              The primary workload is an 11-field <code>PeerUpdate</code> struct with unsigned and
              signed integers, booleans, UTF-8 strings, a nested <code>Location</code> sub-message,
              packed integer arrays, and repeated nested peer entries (366 B in OmniBuf, 341 B in
              Protobuf, 803 B in JSON). The large-embed and growth workloads use a ~39 KiB message
              with embedded sub-messages exceeding OmniBuf&apos;s 16 KiB 2-byte length slot, forcing
              the 4-byte container length path.
            </p>
          </div>
          <div class="py-4 grid md:grid-cols-12 gap-2 md:gap-8 items-baseline">
            <div class="md:col-span-3 font-mono text-sm font-semibold text-ink">
              Every Field Actually Read
            </div>
            <p class="md:col-span-9 text-sm sm:text-base text-ink/85 leading-relaxed max-w-[58ch]">
              Some formats (like FlatBuffers or C <code>upb</code>) decode lazily and only unpack a
              field when your code asks for it. Every full-decode benchmark reads all 11 fields and
              folds them into a checksum the compiler cannot optimize away, so lazy and eager
              decoders both do the same amount of work.
            </p>
          </div>
          <div class="py-4 grid md:grid-cols-12 gap-2 md:gap-8 items-baseline">
            <div class="md:col-span-3 font-mono text-sm font-semibold text-ink">
              Equal Reuse &amp; Warmup
            </div>
            <!-- prettier-ignore -->
            <p class="md:col-span-9 text-sm sm:text-base text-ink/85 leading-relaxed max-w-[58ch]">
              Where a benchmark reuses output buffers or destination structs, every competitor in that chart gets the same reuse. AOT languages compile with release optimizations (<code>-O3</code>, <code>--release</code>, <code>-c release</code>), and JIT runtimes (V8, JVM C2, .NET RyuJIT) warm up before timing. Every harness lives in its language repository&apos;s benchmark directory alongside recorded output in <code>testdata/benchmarks.json</code>.
            </p>
          </div>
        </div>
      </div>

      <!-- The Six Benchmarks Explained -->
      <div class="space-y-4">
        <h3 class="text-lg sm:text-xl font-bold tracking-tight text-ink">
          Why these six benchmarks
        </h3>
        <div class="border-t border-ink/15 divide-y divide-ink/12">
          {methodologyBenchmarks.map((item) => (
            <div class="py-4 sm:py-5 grid md:grid-cols-12 gap-2 md:gap-8 items-baseline">
              <h4 class="md:col-span-3 font-mono text-sm font-semibold text-ink">{item.title}</h4>
              <p class="md:col-span-9 text-sm sm:text-base text-ink/85 leading-relaxed max-w-[58ch]">
                {item.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script define:vars={{ validLangKeys }}>
  const root = document.querySelector('[data-benchmark-explorer]');
  if (root) {
    const viewTabs = Array.from(root.querySelectorAll('[data-view-tab]'));
    const viewPanels = Array.from(root.querySelectorAll('[data-view-panel]'));
    const compareSubtabs = root.querySelector('[data-compare-subtabs]');
    const languageSubtabs = root.querySelector('[data-language-subtabs]');
    const benchTabs = Array.from(root.querySelectorAll('[data-bench-tab]'));
    const benchPanels = Array.from(root.querySelectorAll('[data-bench-panel]'));
    const langTabs = Array.from(root.querySelectorAll('[data-lang-tab]'));
    const langPanels = Array.from(root.querySelectorAll('[data-lang-panel]'));
    const inspectButtons = Array.from(root.querySelectorAll('[data-inspect-lang]'));

    const validBenchSlugs = benchTabs
      .map((btn) => btn.getAttribute('data-bench-tab'))
      .filter(Boolean);

    let activeView = 'language';
    let activeBench = validBenchSlugs[0] || 'decode';
    let activeLang = validLangKeys[0] || 'go';

    function setTabStyle(btn, isActive) {
      btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      btn.setAttribute('tabindex', isActive ? '0' : '-1');
    }

    function syncUrl(push = false) {
      const url = new URL(window.location.href);
      url.hash = '';
      if (activeView === 'compare') {
        url.searchParams.delete('lang');
        url.searchParams.set('view', 'compare');
        if (activeBench !== 'decode') {
          url.searchParams.set('bench', activeBench);
        } else {
          url.searchParams.delete('bench');
        }
      } else {
        url.searchParams.delete('view');
        url.searchParams.delete('bench');
        if (activeLang !== 'go') {
          url.searchParams.set('lang', activeLang);
        } else {
          url.searchParams.delete('lang');
        }
      }
      const nextUrl = url.pathname + url.search;
      if (push && nextUrl !== window.location.pathname + window.location.search) {
        window.history.pushState(null, '', nextUrl);
      } else {
        window.history.replaceState(null, '', nextUrl);
      }
    }

    function applyView(view, updateUrl = true, push = false) {
      activeView = view === 'language' ? 'language' : 'compare';
      viewTabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-view-tab') === activeView;
        setTabStyle(tab, isActive);
      });
      viewPanels.forEach((panel) => {
        const isActive = panel.getAttribute('data-view-panel') === activeView;
        panel.classList.toggle('hidden', !isActive);
      });
      if (compareSubtabs) {
        compareSubtabs.classList.toggle('hidden', activeView !== 'compare');
        compareSubtabs.classList.toggle('flex', activeView === 'compare');
      }
      if (languageSubtabs) {
        languageSubtabs.classList.toggle('hidden', activeView !== 'language');
        languageSubtabs.classList.toggle('flex', activeView === 'language');
      }
      if (updateUrl) syncUrl(push);
    }

    function applyBench(slug, updateUrl = true) {
      if (!validBenchSlugs.includes(slug)) return;
      activeBench = slug;
      benchTabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-bench-tab') === activeBench;
        setTabStyle(tab, isActive);
        if (isActive) tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      benchPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-bench-panel') !== activeBench);
      });
      if (updateUrl) syncUrl(false);
    }

    function applyLang(lang, updateUrl = true, push = false) {
      if (!validLangKeys.includes(lang)) return;
      activeLang = lang;
      langTabs.forEach((tab) => {
        const isActive = tab.getAttribute('data-lang-tab') === activeLang;
        setTabStyle(tab, isActive);
        if (isActive) tab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      });
      langPanels.forEach((panel) => {
        panel.classList.toggle('hidden', panel.getAttribute('data-lang-panel') !== activeLang);
      });
      if (updateUrl) syncUrl(push);
    }

    function wireArrowNav(tabs, onSelect) {
      tabs.forEach((tab, idx) => {
        tab.addEventListener('keydown', (e) => {
          let next = -1;
          if (e.key === 'ArrowRight') next = (idx + 1) % tabs.length;
          else if (e.key === 'ArrowLeft') next = (idx - 1 + tabs.length) % tabs.length;
          else if (e.key === 'Home') next = 0;
          else if (e.key === 'End') next = tabs.length - 1;
          if (next === -1) return;
          e.preventDefault();
          tabs[next].focus();
          onSelect(tabs[next]);
        });
      });
    }

    function scrollToResultsTopIfStuck() {
      if (root.getBoundingClientRect().top < 56) {
        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        root.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
      }
    }

    viewTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        applyView(tab.getAttribute('data-view-tab') || 'language', true, false);
        scrollToResultsTopIfStuck();
      });
    });
    wireArrowNav(viewTabs, (tab) => {
      applyView(tab.getAttribute('data-view-tab') || 'language', true, false);
      scrollToResultsTopIfStuck();
    });

    benchTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        applyBench(tab.getAttribute('data-bench-tab') || 'decode');
        scrollToResultsTopIfStuck();
      });
    });
    wireArrowNav(benchTabs, (tab) => {
      applyBench(tab.getAttribute('data-bench-tab') || 'decode');
      scrollToResultsTopIfStuck();
    });

    langTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        applyLang(tab.getAttribute('data-lang-tab') || 'go', true, false);
        scrollToResultsTopIfStuck();
      });
    });
    wireArrowNav(langTabs, (tab) => {
      applyLang(tab.getAttribute('data-lang-tab') || 'go', true, false);
      scrollToResultsTopIfStuck();
    });

    inspectButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lang = btn.getAttribute('data-inspect-lang');
        if (lang) {
          applyLang(lang, false);
          applyView('language', true, true);
          const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          root.scrollIntoView({ behavior: prefersReduced ? 'auto' : 'smooth', block: 'start' });
          const heading = root.querySelector(`[data-lang-heading="${lang}"]`);
          if (heading) heading.focus({ preventScroll: true });
        }
      });
    });

    function hydrateFromLocation() {
      const params = new URLSearchParams(window.location.search);
      const rawHash = window.location.hash.replace(/^#/, '').toLowerCase();
      const hashLang = rawHash.startsWith('lang-panel-')
        ? rawHash.slice('lang-panel-'.length)
        : rawHash;
      const hashBench = rawHash.startsWith('bench-panel-')
        ? rawHash.slice('bench-panel-'.length)
        : '';
      const paramLang = (params.get('lang') || '').toLowerCase();
      const paramView = (params.get('view') || '').toLowerCase();
      const paramBench = (params.get('bench') || hashBench).toLowerCase();

      if (paramView === 'compare' || validBenchSlugs.includes(paramBench)) {
        if (validBenchSlugs.includes(paramBench)) {
          applyBench(paramBench, false);
        }
        applyView('compare', false);
      } else {
        if (validLangKeys.includes(paramLang)) {
          applyLang(paramLang, false);
        } else if (validLangKeys.includes(hashLang)) {
          applyLang(hashLang, false);
        } else {
          applyLang('go', false);
        }
        applyView('language', false);
      }
    }

    hydrateFromLocation();
    window.addEventListener('popstate', hydrateFromLocation);
  }
</script>
