---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import TypeMappingTable from '../components/TypeMappingTable.astro';
import Footer from '../components/Footer.astro';
import RpcIntegration from '../components/RpcIntegration.astro';

const javaRpcCode = `// gRPC (com.omnibuf.grpc; io.grpc:grpc-api is provided-scoped)
import com.omnibuf.grpc.OmniBufGrpcMarshaller;

MethodDescriptor<PingReq, PingResp> method = MethodDescriptor.<PingReq, PingResp>newBuilder()
    .setType(MethodDescriptor.MethodType.UNARY)
    .setFullMethodName("acme.v1.Svc/Ping")
    .setRequestMarshaller(OmniBufGrpcMarshaller.forClass(PingReq.class))
    .setResponseMarshaller(OmniBufGrpcMarshaller.forClass(PingResp.class))
    .build();

// Connect (separate package: com.omnibuf.connect)
import com.omnibuf.connect.OmniBufConnectCodec;
OmniBufConnectCodec codec = OmniBufConnectCodec.compact();`;
import { defaultTypeMappings } from '../data/typeMappings';

let mavenVersion = '0.1.1';
const isNewerSemver = (candidate: string, current: string) => {
  const pa = candidate.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
  const pb = current.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
  for (let i = 0; i < 3; i++) {
    if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pa[i] ?? 0) > (pb[i] ?? 0);
  }
  return false;
};
try {
  const res = await fetch(
    'https://repo1.maven.org/maven2/com/omnibuf/omnibuf-java/maven-metadata.xml',
    { signal: AbortSignal.timeout(4000) },
  );
  if (res.ok) {
    const xml = await res.text();
    const match = xml.match(/<release>([0-9A-Za-z._-]+)<\/release>/);
    if (match?.[1] && isNewerSemver(match[1], mavenVersion)) {
      mavenVersion = match[1];
    }
  }
} catch {
  // Keep fallback coordinate during offline builds
}
const mavenCoordinate = `com.omnibuf:omnibuf-java:${mavenVersion}`;

const recordJavaSnippet = `import com.omnibuf.OmniBufMapper;
import com.omnibuf.annotation.OmniBufField;
import com.omnibuf.annotation.OmniBufMessage;
import com.omnibuf.annotation.WireKind;

@OmniBufMessage(name = "SensorReading")
public record SensorReading(
    @OmniBufField(id = 1, name = "sensor_id") String sensorId,
    @OmniBufField(id = 2, name = "delta_mk", wire = WireKind.SINT) int deltaMk,
    @OmniBufField(id = 3, name = "healthy") boolean healthy
) {}

byte[] pkt = OmniBufMapper.marshal(new SensorReading("rack-12", -45, true));
SensorReading out = OmniBufMapper.unmarshal(pkt, SensorReading.class);`;

const protobufJavaSnippet = `import com.omnibuf.OmniBufProtobuf;
import com.omnibuf.pb.bench.PeerUpdate;

byte[] pkt = OmniBufProtobuf.marshal(protoPeer);
PeerUpdate out = OmniBufProtobuf.unmarshal(pkt, PeerUpdate.getDefaultInstance());`;

const bufGenJavaSnippet = `version: v2
clean: true
plugins:
  - protoc_builtin: java
    out: src/main/gen
  - local: ./bin/protoc-gen-omnibuf-java
    out: src/main/gen`;

const generatedJavaSnippet = `import com.omnibuf.pb.bench.OmniBufPeerUpdate;
import com.omnibuf.pb.bench.OpaquePeerUpdate;
import com.omnibuf.pb.bench.PeerUpdateOmniBuf;

byte[] pkt = PeerUpdateOmniBuf.marshal(msg);

OpaquePeerUpdate view = new OpaquePeerUpdate(pkt);
String city = view.getLocation().getCity();

byte[] updated = view.setSequence(9_876_543_211L).marshal();`;

const blindJavaCode = `import com.omnibuf.MarshalOptions;
import com.omnibuf.OmniBufBlind;

byte[] pkt = PeerUpdateOmniBuf.marshal(msg, MarshalOptions.SELF_DESCRIBING);
String json = OmniBufBlind.decodeBlindJson(pkt);`;

const javaFaqItems = [
  {
    id: 'java-faq-encode',
    question: 'Why does protobuf-java lead on the 39 KiB Large Embedded Message Encode test?',
    paragraphs: [
      'Immutable <code>protobuf-java</code> messages cache <code>memoizedSerializedSize</code> and UTF-8 <code>ByteString</code> slices. Repeated <code>toByteArray()</code> calls allocate the exact 39,227-byte array upfront and copy cached bytes in one pass (4.38 µs). Mutable OmniBuf classes never cache stale sizes, streaming UTF-8 into a pooled encoder and copying out in 5.04 µs. OmniBuf leads every other Java benchmark, up to about 8x faster on single-field reads.',
    ],
  },
  {
    id: 'java-faq-records',
    question: 'Can OmniBufMapper reuse mutable POJO instances on decode?',
    paragraphs: [
      'Java 21 <code>record</code> types construct fresh instances via canonical constructors through <code>OmniBufMapper.unmarshal(pkt, RecordClass.class)</code>. Mutable POJOs also accept <code>OmniBufMapper.unmarshal(pkt, existingInstance)</code> to clear fields and decode into an existing object.',
    ],
  },
  {
    id: 'java-faq-blind',
    question: 'What does OmniBufBlind output on raw packets?',
    paragraphs: [
      '<code>OmniBufBlind.decodeBlind(pkt)</code> returns a <code>Map&lt;String, Object&gt;</code> with synthetic <code>field_1</code>, <code>field_2</code>, ... keys on compact packets, or resolves schema field names when encoded with <code>MarshalOptions.SELF_DESCRIBING</code>.',
    ],
    codeBlock: blindJavaCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const javaFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: javaFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Java 21 | @OmniBufField Records, protobuf-java & protoc-gen-omnibuf-java"
  description="Use OmniBuf on Java 21: annotate Java records and POJOs, serialize standard protobuf-java messages, or generate VarHandle codecs and Opaque views with buf."
>
  <Navbar currentPage="java" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-14 sm:pb-10 px-4 sm:px-6 max-w-6xl mx-auto">
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight leading-[1.1] text-ink">
        OmniBuf <span class="text-[#FF4F18]">for Java</span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-base sm:text-lg text-ink/80 leading-relaxed max-w-[65ch]">
            Pure Java 21 library on Maven Central with a companion Buf plugin. Works with{' '}
            <a href="#annotated-records" class="doc-link">
              annotated records and POJOs
            </a>
            , standard{' '}
            <a href="#protobuf-java" class="doc-link">
              Protobuf Java messages
            </a>
            , and{' '}
            <a href="#plugin-codegen" class="doc-link">
              generated codecs
            </a>{' '}
            that inspect or splice fields directly inside byte arrays.
          </p>
          <div class="flex flex-wrap gap-2.5 text-sm pt-1 no-print">
            <a
              href="https://github.com/omnibuf/omnibuf-java"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary px-4 py-2"
            >
              GitHub Repository &rarr;
            </a>
            <a
              href="https://central.sonatype.com/artifact/com.omnibuf/omnibuf-java"
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary px-4 py-2"
            >
              Maven Central &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/12">
              <div class="text-xs font-medium text-paper/70">Maven Coordinate</div>
              <button
                id="java-maven-copy-btn"
                type="button"
                data-copy={mavenCoordinate}
                class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code id="java-maven-coord">{mavenCoordinate}</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">
          Three ways to use OmniBuf in Java.
        </h2>
        <p class="mt-2 text-base sm:text-lg text-ink/75">
          All three produce identical wire bytes in standard safe Java 21.
        </p>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        <div
          id="annotated-records"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Annotated Java 21 records and POJOs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>@OmniBufMessage</code> and <code>@OmniBufField</code> map record components or
              class fields onto explicit wire numbers and <code>WireKind</code> overrides.{' '}
              <code>OmniBufMapper</code> caches field descriptors per <code>Class&lt;?&gt;</code> on
              first call.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">@OmniBufMessage Java 21 Record</div>
                <button
                  type="button"
                  data-copy={recordJavaSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={recordJavaSnippet} lang="java" theme="github-dark" />
            </div>
          </div>

          <TypeMappingTable {...defaultTypeMappings.java} />
        </div>

        <div
          id="protobuf-java"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Standard protobuf-java messages
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Services with existing <code>com.google.protobuf.Message</code> builders and gRPC
              stubs pass them straight to <code>OmniBufProtobuf.marshal</code> and{' '}
              <code>OmniBufProtobuf.unmarshal</code>. Presence, <code>oneof</code> unions, maps, and{' '}
              <a href="/spec#sec-11-4" class="doc-link">
                Editions 2023, 2024, and 2026
              </a>{' '}
              descriptors follow the documented OmniBuf subset and reject unsupported features
              explicitly.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">protobuf-java Bridge</div>
                <button
                  type="button"
                  data-copy={protobufJavaSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufJavaSnippet} lang="java" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-lg sm:text-xl font-bold tracking-tight leading-snug text-ink">
              Generated classes with protoc-gen-omnibuf-java
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>protoc-gen-omnibuf-java</code> emits mutable model classes, static{' '}
              <code>&lt;Msg&gt;OmniBuf</code> codecs, and <code>Opaque&lt;Msg&gt;</code> views over
              raw <code>byte[]</code> packets. On OpenJDK 21, an end-to-end nested string check and
              64-bit sequence splice finishes in 294 ns.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenJavaSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenJavaSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">Lint &amp; Generate with Buf</div>
                <button
                  type="button"
                  data-copy="buf lint && buf generate"
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>buf lint
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-lg font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border border-ink/15 [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                <div class="text-xs font-medium text-paper/70">
                  Generated Codec &amp; Opaque Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedJavaSnippet}
                  class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedJavaSnippet} lang="java" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <RpcIntegration
      heading="gRPC & Connect"
      accent="in Java."
      summary="Separate <code>com.omnibuf.grpc</code> (implementing <code>io.grpc.MethodDescriptor.Marshaller</code> with <code>provided</code>-scoped gRPC API) and <code>com.omnibuf.connect</code> packages keep core <code>omnibuf-java</code> free of transitive RPC dependencies."
      code={javaRpcCode}
      lang="java"
      codeLabel="com.omnibuf.grpc & com.omnibuf.connect"
    />

    <section
      id="java-faq"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 max-w-6xl mx-auto border-t border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-ink">Java 21 questions.</h2>
      </div>

      <div class="border-t border-ink/15 divide-y divide-ink/12">
        {javaFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-lg sm:text-xl font-bold tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-lg border border-ink/15 font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:bg-transparent! [&>pre]:p-0! [&>pre]:m-0! [&>pre]:border-0!">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/12">
                    <div class="text-xs font-medium text-paper/70">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.25rem] text-center px-2.5 py-1 text-xs font-medium bg-paper/10 hover:bg-paper/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#FF7A4D] text-paper border border-paper/20 rounded shrink-0 transition cursor-pointer"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="java" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(javaFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="java" />
  </main>

  <Footer />

  <script>
    const coordEl = document.getElementById('java-maven-coord');
    const copyBtn = document.getElementById('java-maven-copy-btn');
    if (coordEl && copyBtn) {
      const isNewer = (candidate: string, current: string) => {
        const pa = candidate.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
        const pb = current.split(/[.-]/).map((n) => Number.parseInt(n, 10) || 0);
        for (let i = 0; i < 3; i++) {
          if ((pa[i] ?? 0) !== (pb[i] ?? 0)) return (pa[i] ?? 0) > (pb[i] ?? 0);
        }
        return false;
      };
      void (async () => {
        try {
          const res = await fetch(
            'https://img.shields.io/maven-central/v/com.omnibuf/omnibuf-java.json',
          );
          if (!res.ok) return;
          const data = (await res.json()) as { value?: string };
          const raw = (data.value ?? '').replace(/^v/, '').trim();
          if (!/^\d+\.\d+\.\d+(?:[-+][0-9A-Za-z.-]+)?$/.test(raw)) return;
          const currentVer = (coordEl.textContent ?? '').split(':').pop()?.trim() ?? '0.0.0';
          if (!isNewer(raw, currentVer)) return;
          const coord = `com.omnibuf:omnibuf-java:${raw}`;
          coordEl.textContent = coord;
          copyBtn.setAttribute('data-copy', coord);
        } catch {
          // Keep build-time coordinate on network failure
        }
      })();
    }
  </script>
</Layout>
