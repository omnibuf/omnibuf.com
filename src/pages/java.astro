---
import { Code } from 'astro:components';
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Benchmarks from '../components/Benchmarks.astro';
import LanguageStrip from '../components/LanguageStrip.astro';
import Footer from '../components/Footer.astro';

const recordJavaSnippet = `import com.omnibuf.OmniBufMapper;
import com.omnibuf.annotation.OmniBufField;
import com.omnibuf.annotation.OmniBufMessage;
import com.omnibuf.annotation.WireKind;

@OmniBufMessage(name = "SensorReading")
public record SensorReading(
    @OmniBufField(id = 1, name = "sensor_id") String sensorId,
    @OmniBufField(id = 2, name = "delta_mk", wire = WireKind.SINT) int deltaMk,
    @OmniBufField(id = 3, name = "healthy") boolean healthy
) {}

byte[] pkt = OmniBufMapper.marshal(new SensorReading("rack-12", -45, true));
SensorReading out = OmniBufMapper.unmarshal(pkt, SensorReading.class);`;

const protobufJavaSnippet = `import com.omnibuf.OmniBufProtobuf;
import com.omnibuf.pb.bench.PeerUpdate;

byte[] pkt = OmniBufProtobuf.marshal(protoPeer);
PeerUpdate out = OmniBufProtobuf.unmarshal(pkt, PeerUpdate.getDefaultInstance());`;

const bufGenJavaSnippet = `version: v2
clean: true
plugins:
  - protoc_builtin: java
    out: src/main/gen
  - local: ./bin/protoc-gen-omnibuf-java
    out: src/main/gen`;

const generatedJavaSnippet = `import com.omnibuf.pb.bench.OmniBufPeerUpdate;
import com.omnibuf.pb.bench.OpaquePeerUpdate;
import com.omnibuf.pb.bench.PeerUpdateOmniBuf;

byte[] pkt = PeerUpdateOmniBuf.marshal(msg);

OpaquePeerUpdate view = new OpaquePeerUpdate(pkt);
String city = view.getLocation().getCity();

byte[] updated = view.setSequence(9_876_543_211L).marshal();`;

const blindJavaCode = `import com.omnibuf.MarshalOptions;
import com.omnibuf.OmniBufBlind;

byte[] pkt = PeerUpdateOmniBuf.marshal(msg, MarshalOptions.SELF_DESCRIBING);
String json = OmniBufBlind.decodeBlindJson(pkt);`;

const javaFaqItems = [
  {
    id: 'java-faq-encode',
    question: 'Why does protobuf-java edge out full encode by 32 ns in the chart?',
    paragraphs: [
      '<code>protobuf-java</code> builds immutable message objects and caches <code>memoizedSerializedSize</code> inside each instance on the first warmup pass, so repeated <code>toByteArray()</code> calls on the same object skip its length-computation pass. On decode, nested field reads, and single-field splicing, generated OmniBuf classes run 1.3x to 10.3x faster.',
    ],
  },
  {
    id: 'java-faq-records',
    question: 'Can OmniBufMapper reuse mutable POJO instances on decode?',
    paragraphs: [
      'Java 21 <code>record</code> types construct fresh instances via canonical constructors through <code>OmniBufMapper.unmarshal(pkt, RecordClass.class)</code>. Mutable POJOs also accept <code>OmniBufMapper.unmarshal(pkt, existingInstance)</code> to clear fields and decode into an existing object.',
    ],
  },
  {
    id: 'java-faq-blind',
    question: 'What does OmniBufBlind output on raw packets?',
    paragraphs: [
      '<code>OmniBufBlind.decodeBlind(pkt)</code> returns a <code>Map&lt;String, Object&gt;</code> with synthetic <code>field_1</code>, <code>field_2</code>, ... keys on compact packets, or resolves schema field names when encoded with <code>MarshalOptions.SELF_DESCRIBING</code>.',
    ],
    codeBlock: blindJavaCode,
    codeLabel: 'Example',
  },
];

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');

const javaFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: javaFaqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.paragraphs.map(stripHtml).join('\n\n'),
    },
  })),
};
---

<Layout
  title="OmniBuf for Java 21 | @OmniBufField Records, protobuf-java & protoc-gen-omnibuf-java"
  description="Use OmniBuf on Java 21: annotate Java records and POJOs, serialize standard protobuf-java messages, or generate VarHandle codecs and Opaque views with buf."
>
  <Navbar currentPage="java" />

  <main id="main-content">
    <section class="relative pt-10 pb-8 sm:pt-16 sm:pb-12 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
      <h1 class="text-[2.6rem] sm:text-7xl lg:text-[5.5rem] font-bold tracking-tight leading-[0.94] text-ink uppercase">
        OmniBuf
        <br />
        <span class="font-serif italic font-normal normal-case text-[#FF4F18] text-[3.1rem] sm:text-8xl lg:text-[6.2rem]">
          for Java 21.
        </span>
      </h1>

      <div class="mt-6 grid lg:grid-cols-12 gap-6 lg:gap-8 items-end">
        <div class="lg:col-span-7 space-y-4">
          <p class="text-lg sm:text-2xl text-ink/85 font-medium leading-snug">
            Annotate Java 21{' '}
            <a href="#annotated-records" class="doc-link">
              <code>record</code> types and POJOs
            </a>
            , pass existing{' '}
            <a href="#protobuf-java" class="doc-link">
              <code>protobuf-java</code> messages
            </a>{' '}
            to <code>OmniBufProtobuf</code>, or generate unaligned little-endian{' '}
            <code>VarHandle</code> codecs and <code>Opaque</code> views with{' '}
            <a href="#plugin-codegen" class="doc-link">
              <code>protoc-gen-omnibuf-java</code>
            </a>
            . OpenJDK 21 numbers sit{' '}
            <a href="#benchmarks" class="doc-link">
              below
            </a>
            .
          </p>
          <div class="flex flex-wrap gap-3 font-mono text-sm sm:text-base pt-1 no-print">
            <a href="#benchmarks" class="os-btn px-4 py-2.5 bg-acid text-ink font-bold rounded-md">
              Java 21 Benchmarks &rarr;
            </a>
            <a href="/spec" class="os-btn px-4 py-2.5 bg-[#FAF8F2] text-ink font-bold rounded-md">
              Wire Specification &rarr;
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 min-w-0">
          <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink shadow-[4px_4px_0px_#111111]">
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b border-paper/15">
              <div class="text-xs font-bold uppercase text-acid">Maven Coordinate</div>
              <button
                type="button"
                data-copy="com.omnibuf:omnibuf-java:0.1.0"
                class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
              >
                Copy
              </button>
            </div>
            <pre class="leading-relaxed whitespace-pre"><code>com.omnibuf:omnibuf-java:0.1.0</code></pre>
          </div>
        </div>
      </div>
    </section>

    <section
      id="quickstart"
      class="scroll-mt-16 py-12 sm:py-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-8">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Three ways to use{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">
            OmniBuf in Java.
          </span>
        </h2>
        <p class="mt-3 text-lg sm:text-xl text-ink/80 font-medium">
          Built on <code>Integer.numberOfTrailingZeros</code> and byte-array <code>VarHandle</code>{' '}
          views.
        </p>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        <div
          id="annotated-records"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Annotated Java 21 records and POJOs
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>@OmniBufMessage</code> and <code>@OmniBufField</code> map record components or
              class fields onto explicit wire numbers and <code>WireKind</code> overrides.{' '}
              <code>OmniBufMapper</code> caches field descriptors per <code>Class&lt;?&gt;</code> on
              first call.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  @OmniBufMessage Java 21 Record
                </div>
                <button
                  type="button"
                  data-copy={recordJavaSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={recordJavaSnippet} lang="java" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="protobuf-java"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Standard protobuf-java messages
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              Services with existing <code>com.google.protobuf.Message</code> builders and gRPC
              stubs pass them straight to <code>OmniBufProtobuf.marshal</code> and{' '}
              <code>OmniBufProtobuf.unmarshal</code>. Presence, <code>oneof</code> unions, maps, and
              Editions descriptors preserve exact semantics.
            </p>
          </div>

          <div class="lg:col-span-7 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">protobuf-java Bridge</div>
                <button
                  type="button"
                  data-copy={protobufJavaSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={protobufJavaSnippet} lang="java" theme="github-dark" />
            </div>
          </div>
        </div>

        <div
          id="plugin-codegen"
          class="scroll-mt-16 py-8 sm:py-12 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
        >
          <div class="lg:col-span-5 space-y-3.5 min-w-0">
            <h3 class="text-2xl sm:text-3xl font-bold uppercase tracking-tight leading-snug">
              Generated classes with protoc-gen-omnibuf-java
            </h3>
            <p class="text-base sm:text-lg text-ink/85 leading-relaxed">
              <code>protoc-gen-omnibuf-java</code> emits mutable model classes, static{' '}
              <code>&lt;Msg&gt;OmniBuf</code> codecs, and <code>Opaque&lt;Msg&gt;</code> views over
              raw <code>byte[]</code> packets. Splicing a single 64-bit sequence field takes ~144 ns
              on OpenJDK 21.
            </p>
          </div>

          <div class="lg:col-span-7 space-y-3.5 min-w-0">
            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">buf.gen.yaml</div>
                <button
                  type="button"
                  data-copy={bufGenJavaSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={bufGenJavaSnippet} lang="yaml" theme="github-dark" />
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Lint &amp; Generate with Buf
                </div>
                <button
                  type="button"
                  data-copy="buf lint && buf generate"
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <pre class="leading-relaxed whitespace-pre"><code><span class="text-paper/75 select-none">$ </span>buf lint
<span class="text-paper/75 select-none">$ </span><span class="text-acid font-bold">buf generate</span></code></pre>
            </div>

            <div class="p-4 sm:p-5 bg-ink text-paper rounded-md font-mono text-xs sm:text-sm overflow-x-auto leading-relaxed border-2 border-ink [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
              <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                <div class="text-xs font-bold uppercase text-acid">
                  Generated Codec &amp; Opaque Splice
                </div>
                <button
                  type="button"
                  data-copy={generatedJavaSnippet}
                  class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                >
                  Copy
                </button>
              </div>
              <Code code={generatedJavaSnippet} lang="java" theme="github-dark" />
            </div>
          </div>
        </div>
      </div>
    </section>

    <Benchmarks lang="java" />

    <section
      id="java-faq"
      class="scroll-mt-16 py-16 sm:py-20 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto border-t-2 border-ink/15"
    >
      <div class="max-w-3xl mb-10">
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight uppercase leading-none">
          Java 21{' '}
          <span class="font-serif italic font-normal normal-case text-[#FF4F18]">questions.</span>
        </h2>
      </div>

      <div class="border-t-2 border-ink divide-y-2 divide-ink/20">
        {javaFaqItems.map((item) => (
          <div
            id={item.id}
            class="scroll-mt-16 py-8 sm:py-10 grid lg:grid-cols-12 gap-6 lg:gap-8 items-start"
          >
            <h3 class="lg:col-span-5 text-xl sm:text-2xl font-bold uppercase tracking-tight text-ink leading-snug">
              {item.question}
            </h3>

            <div class="lg:col-span-7 space-y-3.5 text-base sm:text-lg text-ink/85 leading-relaxed max-w-[65ch] min-w-0">
              {item.paragraphs.map((paragraph) => (
                <p set:html={paragraph} />
              ))}
              {item.codeBlock && (
                <div class="bg-ink text-paper p-4 sm:p-5 rounded-md border-2 border-ink font-mono text-xs sm:text-sm leading-relaxed overflow-x-auto [&>pre]:!bg-transparent [&>pre]:!p-0 [&>pre]:!m-0 [&>pre]:!border-0">
                  <div class="flex items-center justify-between gap-2 mb-2.5 pb-2 border-b border-paper/15">
                    <div class="text-xs font-bold uppercase text-acid">
                      {item.codeLabel ?? 'Example'}
                    </div>
                    <button
                      type="button"
                      data-copy={item.codeBlock}
                      class="copy-snippet-btn min-w-[4.75rem] text-center px-2.5 py-1 text-xs font-bold uppercase bg-paper/15 hover:bg-acid hover:text-ink focus-visible:outline focus-visible:outline-2 focus-visible:outline-acid text-paper border border-paper/30 rounded shrink-0 transition"
                    >
                      Copy
                    </button>
                  </div>
                  <Code code={item.codeBlock} lang="java" theme="github-dark" />
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <script is:inline type="application/ld+json" set:html={JSON.stringify(javaFaqJsonLd)} />
    </section>

    <LanguageStrip currentPage="java" />
  </main>

  <Footer />
</Layout>
